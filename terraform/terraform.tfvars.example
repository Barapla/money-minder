# Copia a terraform.tfvars y rellena. Ese archivo esta en .gitignore.

domain     = "money.tudominio.com"
acme_email = "tu@correo.com"

# La misma que tienes en .env local
anthropic_api_key = "sk-ant-..."

# Correo saliente: confirmacion de cuenta, desbloqueo y recuperacion de contraseña.
# Con Amazon SES: verifica el dominio o el remitente en la consola de SES y crea
# credenciales SMTP (SES > SMTP settings). Una cuenta nueva de SES esta en
# sandbox y solo envia a correos verificados hasta que pidas salir de ahi.
smtp_address  = "email-smtp.us-east-1.amazonaws.com"
smtp_username = "AKIA..."
smtp_password = "..."
mailer_from   = "no-reply@money.tudominio.com"
# smtp_port   = 587

# Quien puede entrar a la app. Vacio o ausente = abierto a todos.
# Una IP suelta lleva /32. Consulta la tuya con: curl -s ifconfig.me
#
# OJO: si tu internet de casa tiene IP dinamica, cambiara y te dejara fuera.
# En ese caso usa el rango de tu proveedor, o dejalo abierto y protege con la
# sesion de la app.
allowed_cidrs = [
  # "189.203.44.10/32",   # casa
  # "201.140.12.33/32",   # oficina
]

# Opcionales
# region            = "us-east-1"
# instance_type     = "t4g.small"
# image_tag         = "latest"

# Solo si quieres SSH ademas de SSM. Vacio = cerrado.
# ssh_allowed_cidrs = ["TU.IP.PUBLICA/32"]
# ssh_public_key    = "ssh-ed25519 AAAA..."
