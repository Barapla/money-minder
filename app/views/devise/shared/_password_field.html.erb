<%#
  Campo de contraseña con botón Mostrar/Ocultar.

  Va a mano y no con Forms::InputComponent por dos razones: ese rotula el campo
  él solo (y aquí el rótulo comparte fila con un enlace) y su `suffix` es
  pointer-events-none, así que no puede llevar un botón. Las clases son las
  mismas para que se vea igual que cualquier campo de la app.

  Locales: form, name. Opcionales: autocomplete, label_link.
%>
<div class="form-group">
  <div class="flex items-baseline justify-between gap-3 mb-2">
    <%= form.label name, class: "form-label !mb-0" %>
    <%= local_assigns[:label_link] %>
  </div>

  <div class="relative" data-controller="password-visibility">
    <div class="absolute left-3 top-1/2 -translate-y-1/2 text-bunker-400 pointer-events-none z-10">
      <span class="text-sm opacity-60">🔒</span>
    </div>

    <%= form.password_field name,
          autocomplete: local_assigns.fetch(:autocomplete, 'new-password'),
          placeholder: t('devise.shared.password_field.placeholder'),
          class: "form-control form-control-md has-icon-left pr-24",
          data: { password_visibility_target: "field" } %>

    <button type="button" data-action="password-visibility#toggle"
            data-password-visibility-target="button"
            data-show="<%= t('devise.shared.password_field.show') %>"
            data-hide="<%= t('devise.shared.password_field.hide') %>"
            aria-pressed="false"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-bunker-400 text-[11.5px] font-semibold hover:text-white transition-colors z-10">
      <%= t('devise.shared.password_field.show') %>
    </button>
  </div>
</div>
