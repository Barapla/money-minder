<h1 class="text-2xl font-bold text-white mb-2 text-pretty">
  <%= t('.title') %> <span class="text-purple-400"><%= t('app_name') %></span>
</h1>
<p class="text-bunker-400 text-[13.5px] mb-[30px]">
  <%= t('.have_account') %>
  <%= link_to t('.link'), new_session_path(resource_name), class: "text-purple-300 font-semibold hover:text-purple-200" %>
</p>

<%# turbo: false lo traia la vista anterior: sin eso Devise responde 200 al fallar
    la validacion y Turbo descarta la respuesta, asi que los errores no se ven. %>
<%= form_for(resource, as: resource_name, url: registration_path(resource_name), data: { turbo: false }) do |form| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <%= render Forms::InputComponent.new(form:, name: :name, options: {
        placeholder: true, autofocus: true, autocomplete: "name",
        icon: '<span class="text-sm opacity-60">👤</span>'
      }) %>

  <%= render Forms::InputComponent.new(form:, name: :email, type: :email, options: {
        placeholder: true, autocomplete: "email",
        icon: '<span class="text-sm opacity-60">✉️</span>'
      }) %>

  <%= render "devise/shared/password_field", form:, name: :password %>
  <%= render "devise/shared/password_field", form:, name: :password_confirmation %>

  <p class="text-bunker-500 text-[11.5px] -mt-2 mb-6">
    <%= t('.password_hint', count: User.password_length.min) %>
  </p>

  <%= form.submit t('.sign_up'),
        class: "w-full bg-gradient-to-r from-purple-500 to-purple-600 text-white text-center py-[13px] rounded-[11px] text-[14.5px] font-semibold cursor-pointer hover:from-purple-400 hover:to-purple-500 transition-colors" %>
<% end %>

<p class="text-bunker-500 text-[11.5px] leading-relaxed mt-[26px] text-pretty"><%= t('.terms_note') %></p>
