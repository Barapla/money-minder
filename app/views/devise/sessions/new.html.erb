<h1 class="text-2xl font-bold text-bunker-950 mb-8"><%= t('.title') %> <span class="text-purple-500"><%= t('app_name') %></span></h1>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |form| %>
  <%= render Forms::InputComponent.new(form:, name: :email, options: { placeholder: true, autofocus: true, autocomplete: "email" }) %>
  <%= render Forms::InputComponent.new(form:, name: :password, type: :password, options: { autocomplete: "new-password", placeholder: true }) %>
  
  <% if devise_mapping.rememberable? %>
    <div class="field">
      <%= form.check_box :remember_me %>
      <%= form.label :remember_me %>
    </div>
  <% end %>

  <div class="actions">
    <%= render Forms::SubmitComponent.new(form:, text: t('continue'), options: { class: 'btn btn-full btn-bunker' } ) %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
