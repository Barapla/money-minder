<div class="flex items-start justify-between p-4 bg-bunker-800/30 border border-bunker-700/30 rounded-xl">
  <div class="flex items-start gap-3 min-w-0">
    <span class="mt-0.5 px-2 py-0.5 rounded-full text-xs font-medium shrink-0 <%= benefit_type_badge_class(benefit.benefit_type) %>">
      <%= t("enums.financial_product_benefit.benefit_type.#{benefit.benefit_type}") %>
    </span>
    <div class="min-w-0">
      <p class="text-white font-semibold text-sm">
        <%= benefit_display_value(benefit) %>
        <% if benefit.reduced_value.present? %>
          <span class="text-bunker-400 font-normal">
            / <%= benefit_display_value(benefit, :reduced) %>
            <%= t('admin.financial_product_benefits.item.reduced_label') %>
          </span>
        <% end %>
      </p>
      <% if benefit.amount_cap.present? %>
        <p class="text-xs text-bunker-400 mt-0.5">
          <%= t('admin.financial_product_benefits.item.cap_label', amount: number_to_currency(benefit.amount_cap, unit: '$', delimiter: ',', separator: '.')) %>
        </p>
      <% end %>
      <% if benefit.description.present? %>
        <p class="text-xs text-bunker-500 mt-1 truncate"><%= benefit.description %></p>
      <% end %>
    </div>
  </div>
  <div class="flex items-center gap-2 shrink-0 ml-4">
    <% unless benefit.active? %>
      <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-bunker-700/50 text-bunker-400">
        <%= t('admin.financial_product_benefits.item.inactive') %>
      </span>
    <% end %>
    <%= link_to admin_financial_product_benefit_path(@financial_product, benefit),
          class: "px-3 py-1.5 bg-bunker-800/60 text-bunker-300 border border-bunker-700/50 rounded-lg text-xs font-medium hover:bg-bunker-700/60 hover:text-white transition-all" do %>
      <%= t('admin.financial_products.show.view_action') %>
    <% end %>
    <%= link_to edit_admin_financial_product_benefit_path(@financial_product, benefit),
          class: "px-3 py-1.5 bg-bunker-800/60 text-bunker-300 border border-bunker-700/50 rounded-lg text-xs font-medium hover:bg-bunker-700/60 hover:text-white transition-all" do %>
      <%= t('admin.financial_product_benefits.item.edit') %>
    <% end %>
    <%= button_to admin_financial_product_benefit_path(@financial_product, benefit),
          method: :delete,
          form: { data: { turbo_confirm: t('admin.financial_product_benefits.item.confirm_delete') } },
          class: "px-3 py-1.5 bg-red-500/10 text-red-400 border border-red-500/20 rounded-lg text-xs font-medium hover:bg-red-500/20 hover:text-red-300 transition-all" do %>
      <%= t('admin.financial_product_benefits.item.delete') %>
    <% end %>
  </div>
</div>
