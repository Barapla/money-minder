<div class="max-w-5xl mx-auto">
  <!-- Header -->
  <div class="bg-gradient-to-r from-bunker-900/80 to-purple-900/80 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-8 mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl font-bold text-white mb-2">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-300">
            <%= t('.title') %>
          </span>
        </h1>
        <p class="text-bunker-300"><%= t('.subtitle') %></p>
      </div>
      <%= link_to new_admin_financial_product_path,
            class: "bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white px-6 py-3 rounded-xl font-medium transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg flex items-center gap-2" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
        <%= t('.new_button') %>
      <% end %>
    </div>
  </div>

  <% if notice.present? %>
    <div class="mb-6 p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-xl text-emerald-300 text-sm">
      <%= notice %>
    </div>
  <% end %>

  <% if alert.present? %>
    <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-red-300 text-sm">
      <%= alert %>
    </div>
  <% end %>

  <!-- Filtro -->
  <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-4 mb-6">
    <div class="flex items-center gap-4">
      <%= link_to t('.filter_all'), admin_financial_products_path,
            class: "px-4 py-2 rounded-xl text-sm font-medium transition-all #{params[:active_only] != 'true' ? 'bg-purple-500/20 text-purple-300 border border-purple-500/30' : 'text-bunker-400 hover:text-white hover:bg-bunker-800/60'}" %>
      <%= link_to t('.filter_active'), admin_financial_products_path(active_only: 'true'),
            class: "px-4 py-2 rounded-xl text-sm font-medium transition-all #{params[:active_only] == 'true' ? 'bg-purple-500/20 text-purple-300 border border-purple-500/30' : 'text-bunker-400 hover:text-white hover:bg-bunker-800/60'}" %>
    </div>
  </div>

  <!-- Lista agrupada por institución (CA10) -->
  <% if @grouped_products.any? %>
    <% @grouped_products.sort_by { |institution, _| institution.name.downcase }.each do |institution, products| %>
      <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl overflow-hidden mb-6">
        <div class="px-6 py-4 border-b border-bunker-800/50 bg-bunker-800/20">
          <h2 class="text-lg font-semibold text-white"><%= institution.name %></h2>
          <p class="text-xs text-bunker-400 mt-0.5"><%= t('.products_count', count: products.size) %></p>
        </div>
        <table class="w-full">
          <thead>
            <tr class="border-b border-bunker-800/50">
              <th class="text-left px-6 py-3 text-xs font-medium text-bunker-400"><%= t('.header_name') %></th>
              <th class="text-left px-6 py-3 text-xs font-medium text-bunker-400"><%= t('.header_type') %></th>
              <th class="text-left px-6 py-3 text-xs font-medium text-bunker-400"><%= t('.header_status') %></th>
              <th class="text-right px-6 py-3 text-xs font-medium text-bunker-400"><%= t('.header_actions') %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-bunker-800/30">
            <% products.each do |product| %>
              <tr class="hover:bg-bunker-800/20 transition-colors">
                <td class="px-6 py-4">
                  <span class="text-white font-medium"><%= product.name %></span>
                </td>
                <td class="px-6 py-4">
                  <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= product_type_badge_class(product.product_type) %>">
                    <%= t("enums.financial_product.product_type.#{product.product_type}") %>
                  </span>
                </td>
                <td class="px-6 py-4">
                  <% if product.active? %>
                    <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-300">
                      <%= t('.status_active') %>
                    </span>
                  <% else %>
                    <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-bunker-700/50 text-bunker-400">
                      <%= t('.status_inactive') %>
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to t('.edit_action'), edit_admin_financial_product_path(product),
                          class: "px-3 py-1.5 bg-bunker-800/60 text-bunker-300 border border-bunker-700/50 rounded-lg text-xs font-medium hover:bg-bunker-700/60 hover:text-white transition-all" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% else %>
    <!-- Estado vacío -->
    <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-12 text-center">
      <svg class="w-20 h-20 mx-auto mb-4 text-bunker-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
      </svg>
      <h3 class="text-xl font-bold text-white mb-2"><%= t('.empty_title') %></h3>
      <p class="text-bunker-400 mb-6"><%= t('.empty_subtitle') %></p>
      <%= link_to new_admin_financial_product_path,
            class: "inline-flex items-center gap-2 bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white px-6 py-3 rounded-xl font-medium transition-all" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
        <%= t('.new_button') %>
      <% end %>
    </div>
  <% end %>
</div>
