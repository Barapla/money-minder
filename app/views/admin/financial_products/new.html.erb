    <h1 class="text-3xl font-bold text-white mb-2">
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-300">
        <%= t('.title') %>
      </span>
    </h1>
    <p class="text-bunker-300"><%= t('.subtitle') %></p>
  </div>

  <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl overflow-hidden">
    <%= render 'form', financial_product: @financial_product %>
  </div>
</div>
