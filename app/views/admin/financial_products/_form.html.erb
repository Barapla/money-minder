<%= form_with(model: [:admin, financial_product], local: true, html: { class: "px-8 py-6" }) do |form| %>
  <% if financial_product.errors.any? %>
    <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-xl">
      <p class="text-sm font-medium text-red-400 mb-2">
        <%= t('admin.financial_products.form.error_count', count: financial_product.errors.count) %>
      </p>
      <ul class="list-disc list-inside space-y-1">
        <% financial_product.errors.full_messages.each do |msg| %>
          <li class="text-sm text-red-300"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Institución Financiera -->
  <div class="mb-6">
    <%= form.label :financial_institution_id,
          t('admin.financial_products.form.institution_label'),
          class: "block text-sm font-medium text-bunker-300 mb-2" %>
    <%= form.select :financial_institution_id,
          options_from_collection_for_select(@institutions, :id, :name, financial_product.financial_institution_id),
          { prompt: t('admin.financial_products.form.institution_prompt') },
          class: "w-full bg-bunker-800/60 border border-bunker-700/50 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" %>
  </div>

  <!-- Nombre -->
  <div class="mb-6">
    <%= form.label :name,
          t('admin.financial_products.form.name_label'),
          class: "block text-sm font-medium text-bunker-300 mb-2" %>
    <%= form.text_field :name,
          placeholder: t('admin.financial_products.form.name_placeholder'),
          required: true,
          class: "w-full bg-bunker-800/60 border border-bunker-700/50 rounded-xl px-4 py-3 text-white placeholder-bunker-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" %>
  </div>

  <!-- Tipo de Producto -->
  <div class="mb-6">
    <%= form.label :product_type,
          t('admin.financial_products.form.type_label'),
          class: "block text-sm font-medium text-bunker-300 mb-2" %>
    <%= form.select :product_type,
          FinancialProduct.product_types.keys.map { |k| [t("enums.financial_product.product_type.#{k}"), k] },
          { prompt: t('admin.financial_products.form.type_prompt') },
          class: "w-full bg-bunker-800/60 border border-bunker-700/50 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" %>
  </div>

  <!-- Activo -->
  <div class="mb-6">
    <div class="flex items-center gap-3">
      <%= form.check_box :active,
            class: "w-5 h-5 rounded border-bunker-600 bg-bunker-800 text-purple-500 focus:ring-purple-500 focus:ring-offset-0 cursor-pointer" %>
      <%= form.label :active,
            t('admin.financial_products.form.active_label'),
            class: "text-sm font-medium text-bunker-300 cursor-pointer" %>
    </div>
    <p class="mt-1 text-xs text-bunker-500">
      <%= t('admin.financial_products.form.active_help') %>
    </p>
  </div>

  <div class="flex gap-4 pt-6 border-t border-bunker-800/50">
    <%= form.submit financial_product.persisted? ? t('admin.financial_products.form.submit_update') : t('admin.financial_products.form.submit_create'),
          class: "px-6 py-3 bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white rounded-xl font-medium transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg cursor-pointer" %>
    <%= link_to t('admin.financial_products.form.cancel'),
          admin_financial_products_path,
          class: "px-6 py-3 bg-bunker-800/60 text-bunker-300 border border-bunker-700/50 rounded-xl font-medium hover:bg-bunker-700/60 hover:text-white transition-all duration-200" %>
  </div>
<% end %>
