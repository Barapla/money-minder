<div class="max-w-3xl mx-auto">
  <div class="bg-gradient-to-r from-bunker-900/80 to-purple-900/80 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-8 mb-8">
    <div class="flex items-center gap-4">
      <%= link_to admin_financial_product_benefit_path(@financial_product, @benefit),
            class: "text-bunker-400 hover:text-white transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
      <% end %>
      <div>
        <h1 class="text-2xl font-bold text-white"><%= t('.title') %></h1>
        <p class="text-bunker-300 text-sm mt-1"><%= @financial_product.name %> &mdash; <%= t("enums.financial_product_benefit.benefit_type.#{@benefit.benefit_type}") %></p>
      </div>
    </div>
  </div>

  <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl overflow-hidden">
    <%= render 'form', financial_product: @financial_product, benefit: @benefit, requirement: @requirement %>
  </div>
</div>
