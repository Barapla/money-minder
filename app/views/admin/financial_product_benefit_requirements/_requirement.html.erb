<div class="flex items-start justify-between p-4 bg-bunker-800/30 border border-bunker-700/30 rounded-xl">
  <div class="flex items-start gap-3 min-w-0">
    <span class="mt-0.5 px-2 py-0.5 rounded-full text-xs font-medium shrink-0 <%= requirement_type_badge_class(requirement.requirement_type) %>">
      <%= t("enums.financial_product_benefit_requirement.requirement_type.#{requirement.requirement_type}") %>
    </span>
    <div class="min-w-0">
      <p class="text-white font-semibold text-sm"><%= format_requirement_description(requirement) %></p>
    </div>
  </div>
  <div class="flex items-center gap-2 shrink-0 ml-4">
    <%= link_to edit_admin_financial_product_benefit_requirement_path(financial_product, benefit, requirement),
          class: "px-3 py-1.5 bg-bunker-800/60 text-bunker-300 border border-bunker-700/50 rounded-lg text-xs font-medium hover:bg-bunker-700/60 hover:text-white transition-all" do %>
      <%= t('admin.financial_product_benefit_requirements.item.edit') %>
    <% end %>
    <%= button_to admin_financial_product_benefit_requirement_path(financial_product, benefit, requirement),
          method: :delete,
          form: { data: { turbo_confirm: t('admin.financial_product_benefit_requirements.item.confirm_delete') } },
          class: "px-3 py-1.5 bg-red-500/10 text-red-400 border border-red-500/20 rounded-lg text-xs font-medium hover:bg-red-500/20 hover:text-red-300 transition-all" do %>
      <%= t('admin.financial_product_benefit_requirements.item.delete') %>
    <% end %>
  </div>
</div>
