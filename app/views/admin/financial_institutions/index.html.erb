<div class="max-w-5xl mx-auto">
  <!-- Header -->
  <div class="bg-gradient-to-r from-bunker-900/80 to-purple-900/80 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-8 mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl font-bold text-white mb-2">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-300">
            <%= t('.title') %>
          </span>
        </h1>
        <p class="text-bunker-300"><%= t('.subtitle') %></p>
      </div>
      <%= link_to new_admin_financial_institution_path,
            class: "bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white px-6 py-3 rounded-xl font-medium transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg flex items-center gap-2" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
        <%= t('.new_button') %>
      <% end %>
    </div>
  </div>

  <% if notice.present? %>
    <div class="mb-6 p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-xl text-emerald-300 text-sm">
      <%= notice %>
    </div>
  <% end %>

  <% if alert.present? %>
    <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-red-300 text-sm">
      <%= alert %>
    </div>
  <% end %>

  <!-- Filtro -->
  <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-4 mb-6">
    <div class="flex items-center gap-4">
      <%= link_to t('.filter_all'), admin_financial_institutions_path,
            class: "px-4 py-2 rounded-xl text-sm font-medium transition-all #{params[:active_only] != 'true' ? 'bg-purple-500/20 text-purple-300 border border-purple-500/30' : 'text-bunker-400 hover:text-white hover:bg-bunker-800/60'}" %>
      <%= link_to t('.filter_active'), admin_financial_institutions_path(active_only: 'true'),
            class: "px-4 py-2 rounded-xl text-sm font-medium transition-all #{params[:active_only] == 'true' ? 'bg-purple-500/20 text-purple-300 border border-purple-500/30' : 'text-bunker-400 hover:text-white hover:bg-bunker-800/60'}" %>
    </div>
  </div>

  <!-- Lista -->
  <% if @financial_institutions.any? %>
    <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl overflow-hidden">
      <table class="w-full">
        <thead>
          <tr class="border-b border-bunker-800/50">
            <th class="text-left px-6 py-4 text-sm font-medium text-bunker-400"><%= t('.header_name') %></th>
            <th class="text-left px-6 py-4 text-sm font-medium text-bunker-400"><%= t('.header_status') %></th>
            <th class="text-left px-6 py-4 text-sm font-medium text-bunker-400"><%= t('.header_created') %></th>
            <th class="text-right px-6 py-4 text-sm font-medium text-bunker-400"><%= t('.header_actions') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-bunker-800/30">
          <% @financial_institutions.each do |institution| %>
            <tr class="hover:bg-bunker-800/20 transition-colors">
              <td class="px-6 py-4">
                <span class="text-white font-medium"><%= institution.name %></span>
              </td>
              <td class="px-6 py-4">
                <% if institution.active? %>
                  <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-300">
                    <%= t('.status_active') %>
                  </span>
                <% else %>
                  <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-bunker-700/50 text-bunker-400">
                    <%= t('.status_inactive') %>
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-bunker-400">
                <%= l(institution.created_at.to_date) %>
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to t('.edit_action'), edit_admin_financial_institution_path(institution),
                        class: "px-3 py-1.5 bg-bunker-800/60 text-bunker-300 border border-bunker-700/50 rounded-lg text-xs font-medium hover:bg-bunker-700/60 hover:text-white transition-all" %>
                  <%= button_to t('.delete_action'), admin_financial_institution_path(institution),
                        method: :delete,
                        data: { turbo_confirm: t('.confirm_delete', name: institution.name) },
                        class: "px-3 py-1.5 bg-red-500/20 text-red-300 border border-red-500/30 rounded-lg text-xs font-medium hover:bg-red-500/30 transition-all" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <!-- Estado vacío -->
    <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-12 text-center">
      <svg class="w-20 h-20 mx-auto mb-4 text-bunker-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
      </svg>
      <h3 class="text-xl font-bold text-white mb-2"><%= t('.empty_title') %></h3>
      <p class="text-bunker-400 mb-6"><%= t('.empty_subtitle') %></p>
      <%= link_to new_admin_financial_institution_path,
            class: "inline-flex items-center gap-2 bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white px-6 py-3 rounded-xl font-medium transition-all" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
        <%= t('.new_button') %>
      <% end %>
    </div>
  <% end %>
</div>
