<div class="max-w-5xl mx-auto">
  <% if notice %>
    <div class="mb-6 bg-green-500/10 border border-green-500/20 rounded-xl p-4 flex items-center gap-3">
      <svg class="w-5 h-5 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p class="text-green-300 text-sm"><%= notice %></p>
    </div>
  <% end %>

  <!-- Header -->
  <div class="bg-gradient-to-r from-bunker-900/80 to-purple-900/80 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-8 mb-8">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-4">
        <div class="w-16 h-16 bg-gradient-to-r from-purple-500 to-purple-400 rounded-xl flex items-center justify-center">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div>
          <h1 class="text-3xl font-bold text-white"><%= @presenter.job_title %></h1>
          <p class="text-bunker-300 mt-1">Fecha de ingreso: <%= @presenter.formatted_start_date %></p>
        </div>
      </div>
      <%= render Buttons::LinkComponent.new(
        content: '
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Editar
        ',
        href: edit_employment_information_path,
        options: { class: "btn-secondary flex items-center gap-2 px-4 py-2 bg-bunker-800 border border-bunker-700 rounded-lg text-bunker-200 hover:text-white transition-colors text-sm font-medium" }
      ) %>
    </div>
  </div>

  <div class="grid lg:grid-cols-2 gap-8">
    <!-- Antigüedad Laboral -->
    <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
      <h2 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
        <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Antigüedad Laboral
      </h2>

      <div class="grid grid-cols-3 gap-4">
        <div class="bg-bunker-800/60 border border-bunker-700/50 rounded-xl p-4 text-center">
          <div class="text-3xl font-bold text-purple-400"><%= @presenter.seniority_years %></div>
          <div class="text-xs text-bunker-400 mt-1"><%= @presenter.seniority_years == 1 ? 'Año' : 'Años' %></div>
        </div>
        <div class="bg-bunker-800/60 border border-bunker-700/50 rounded-xl p-4 text-center">
          <div class="text-3xl font-bold text-blue-400"><%= @presenter.seniority_months %></div>
          <div class="text-xs text-bunker-400 mt-1"><%= @presenter.seniority_months == 1 ? 'Mes' : 'Meses' %></div>
        </div>
        <div class="bg-bunker-800/60 border border-bunker-700/50 rounded-xl p-4 text-center">
          <div class="text-3xl font-bold text-emerald-400"><%= @presenter.days_in_current_year %></div>
          <div class="text-xs text-bunker-400 mt-1">Días en el año</div>
        </div>
      </div>

      <div class="mt-4 bg-purple-500/10 border border-purple-500/20 rounded-lg p-3">
        <p class="text-purple-300 text-sm text-center">
          <%= @presenter.seniority_text %>
        </p>
      </div>
    </div>

    <!-- Salario Original -->
    <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
      <h2 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
        <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Salario Registrado
      </h2>

      <div class="text-center py-4">
        <div class="text-4xl font-bold text-emerald-400"><%= @presenter.original_salary_formatted %></div>
        <div class="text-bunker-400 mt-2 text-sm">Cálculo: <%= @presenter.calculation_periodicity_label %></div>
      </div>

      <div class="mt-3 bg-bunker-800/40 border border-bunker-700/30 rounded-lg p-3 flex justify-between text-sm">
        <span class="text-bunker-400">Frecuencia de pago</span>
        <span class="text-amber-300 font-medium"><%= @presenter.payment_frequency_label %></span>
      </div>
    </div>

    <!-- Normalizaciones Salariales -->
    <div class="lg:col-span-2 bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
      <h2 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
        <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
        </svg>
        Normalizaciones Salariales
      </h2>

      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <% [
          { key: :daily, label: "Diario", icon_color: "text-purple-400", bg: "bg-purple-500/10", border: "border-purple-500/20" },
          { key: :weekly, label: "Semanal", icon_color: "text-blue-400", bg: "bg-blue-500/10", border: "border-blue-500/20" },
          { key: :biweekly, label: "Quincenal", icon_color: "text-cyan-400", bg: "bg-cyan-500/10", border: "border-cyan-500/20" },
          { key: :monthly, label: "Mensual", icon_color: "text-emerald-400", bg: "bg-emerald-500/10", border: "border-emerald-500/20" },
          { key: :yearly, label: "Anual", icon_color: "text-yellow-400", bg: "bg-yellow-500/10", border: "border-yellow-500/20" }
        ].each do |period| %>
          <div class="<%= period[:bg] %> border <%= period[:border] %> rounded-xl p-4 text-center">
            <div class="text-xs text-bunker-400 mb-2"><%= period[:label] %></div>
            <div class="text-lg font-bold <%= period[:icon_color] %>"><%= @presenter.formatted_salary(period[:key]) %></div>
          </div>
        <% end %>
      </div>

      <div class="mt-4 bg-bunker-800/40 border border-bunker-700/30 rounded-lg p-3">
        <p class="text-bunker-400 text-xs text-center">
          Cálculo basado en: Diario × 7 (semanal), × 15 (quincenal), × 30 (mensual), × 365 (anual)
        </p>
      </div>
    </div>

    <!-- Configuracion de Nomina -->
    <% if @payroll_profile %>
      <div class="lg:col-span-2 bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-semibold text-white flex items-center gap-2">
            <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Configuración de Nómina
          </h2>
          <%= link_to edit_payroll_profile_path, class: "flex items-center gap-1.5 text-sm text-purple-400 hover:text-purple-300 transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            Editar
          <% end %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          <div class="bg-bunker-800/60 border border-bunker-700/50 rounded-xl p-4">
            <div class="text-xs text-bunker-400 mb-1">Fondo de Ahorro</div>
            <div class="text-xl font-bold text-blue-400"><%= @payroll_profile.savings_fund_rate %>%</div>
          </div>
          <div class="bg-bunker-800/60 border border-bunker-700/50 rounded-xl p-4">
            <div class="text-xs text-bunker-400 mb-1">ISR</div>
            <div class="text-lg font-bold text-rose-400">
              <% if @payroll_profile.custom_isr_rate %>
                <%= @payroll_profile.custom_isr_rate %>% <span class="text-xs font-normal text-bunker-400">(personalizado)</span>
              <% else %>
                18.6% <span class="text-xs font-normal text-bunker-400">(default)</span>
              <% end %>
            </div>
          </div>
          <div class="bg-bunker-800/60 border border-bunker-700/50 rounded-xl p-4">
            <div class="text-xs text-bunker-400 mb-1">IMSS</div>
            <div class="text-lg font-bold text-rose-400">
              <% if @payroll_profile.custom_imss_rate %>
                <%= @payroll_profile.custom_imss_rate %>% <span class="text-xs font-normal text-bunker-400">(personalizado)</span>
              <% else %>
                3% <span class="text-xs font-normal text-bunker-400">(default)</span>
              <% end %>
            </div>
          </div>
        </div>

        <% bonuses = @payroll_profile.non_taxable_bonuses.presence %>
        <% if bonuses.present? %>
          <div>
            <h3 class="text-sm font-medium text-bunker-300 mb-3">Bonos no gravados</h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              <% bonuses.each do |concept, amount| %>
                <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-lg p-3">
                  <div class="text-xs text-bunker-400 mb-1 capitalize"><%= concept %></div>
                  <div class="text-sm font-bold text-emerald-400"><%= number_to_currency(amount, unit: '$', separator: '.', delimiter: ',') %></div>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="bg-bunker-800/40 border border-bunker-700/30 border-dashed rounded-lg p-4 text-center">
            <p class="text-bunker-400 text-sm mb-1">No tienes bonos no gravados configurados.</p>
            <%= link_to 'Agregar bonos', edit_payroll_profile_path, class: "text-purple-400 hover:text-purple-300 text-sm underline" %>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Próximo Pago -->
    <% if @presenter.show_payment_reminder? %>
      <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
        <h2 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
          <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          Próximo Pago
        </h2>

        <div class="bg-amber-500/10 border border-amber-500/20 rounded-xl p-5 text-center">
          <div class="text-3xl font-bold text-amber-400 mb-1"><%= @presenter.next_payment_date_formatted %></div>
          <% if @employment_information.weekly_payment? %>
            <div class="text-bunker-300 text-sm">Pago semanal — cada <span class="text-amber-300 font-medium"><%= @presenter.weekly_payment_day_name %></span></div>
          <% elsif @employment_information.biweekly_payment? %>
            <div class="text-bunker-300 text-sm">Pago quincenal — días 15 y fin de mes (último día hábil)</div>
          <% elsif @employment_information.monthly_payment? %>
            <div class="text-bunker-300 text-sm">Pago mensual — último día hábil del mes</div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Cálculos de Nómina -->
    <% if @net_salary_result %>
      <div class="<%= @presenter.show_payment_reminder? ? '' : 'lg:col-span-2' %> bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
        <h2 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
          <svg class="w-6 h-6 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"></path>
          </svg>
          Cálculos de Nómina
        </h2>

        <% if @net_salary_result.success? %>
          <div class="space-y-3">
            <div class="flex justify-between items-center py-2 border-b border-bunker-700/50">
              <span class="text-bunker-300 text-sm">Sueldo base mensual</span>
              <span class="text-white font-semibold"><%= number_to_currency(@net_salary_result.data[:base_salary], unit: '$', separator: '.', delimiter: ',') %></span>
            </div>
            <% if @net_salary_result.data[:total_bonuses] > 0 %>
              <div class="flex justify-between items-center py-2 border-b border-bunker-700/50">
                <span class="text-bunker-300 text-sm">Bonos no gravados</span>
                <span class="text-emerald-400 font-semibold">+ <%= number_to_currency(@net_salary_result.data[:total_bonuses], unit: '$', separator: '.', delimiter: ',') %></span>
              </div>
            <% end %>
            <div class="flex justify-between items-center py-2 border-b border-bunker-700/50">
              <span class="text-bunker-300 text-sm">Fondo de ahorro (trabajador)</span>
              <span class="text-rose-400 font-semibold">- <%= number_to_currency(@net_salary_result.data[:savings_fund_employee], unit: '$', separator: '.', delimiter: ',') %></span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-bunker-700/50">
              <span class="text-bunker-300 text-sm">ISR estimado</span>
              <span class="text-rose-400 font-semibold">- <%= number_to_currency(@net_salary_result.data[:isr_estimated], unit: '$', separator: '.', delimiter: ',') %></span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-bunker-700/50">
              <span class="text-bunker-300 text-sm">IMSS estimado</span>
              <span class="text-rose-400 font-semibold">- <%= number_to_currency(@net_salary_result.data[:imss_estimated], unit: '$', separator: '.', delimiter: ',') %></span>
            </div>
            <div class="flex justify-between items-center py-3 bg-emerald-500/10 border border-emerald-500/20 rounded-lg px-3">
              <span class="text-emerald-300 font-semibold">Salario neto mensual</span>
              <span class="text-emerald-400 text-xl font-bold"><%= number_to_currency(@net_salary_result.data[:net_salary], unit: '$', separator: '.', delimiter: ',') %></span>
            </div>
          </div>
        <% end %>

        <% if @aguinaldo_result&.success? %>
          <div class="mt-4 bg-yellow-500/10 border border-yellow-500/20 rounded-lg p-3 flex justify-between items-center">
            <div>
              <span class="text-yellow-300 text-sm font-medium">Aguinaldo estimado</span>
              <% if @aguinaldo_result.data[:proportional] %>
                <p class="text-bunker-400 text-xs mt-0.5">Proporcional (<%= @aguinaldo_result.data[:days_worked] %> días)</p>
              <% else %>
                <p class="text-bunker-400 text-xs mt-0.5">Anual completo</p>
              <% end %>
            </div>
            <span class="text-yellow-400 font-bold"><%= number_to_currency(@aguinaldo_result.data[:amount], unit: '$', separator: '.', delimiter: ',') %></span>
          </div>
        <% end %>

        <% if @savings_fund_result&.success? %>
          <div class="mt-3 bg-blue-500/10 border border-blue-500/20 rounded-lg p-3 flex justify-between items-center">
            <div>
              <span class="text-blue-300 text-sm font-medium">Fondo de ahorro mensual</span>
              <p class="text-bunker-400 text-xs mt-0.5">
                Aportación empleado + empleador
                <% if @savings_fund_result.data[:uma_cap_applied] %>
                  <span class="text-amber-400">(tope UMA aplicado)</span>
                <% end %>
              </p>
            </div>
            <span class="text-blue-400 font-bold"><%= number_to_currency(@savings_fund_result.data[:monthly_total], unit: '$', separator: '.', delimiter: ',') %></span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
