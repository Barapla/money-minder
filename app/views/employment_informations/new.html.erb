<div class="max-w-4xl mx-auto">
  <!-- Header -->
  <div class="bg-gradient-to-r from-bunker-900/80 to-purple-900/80 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-8 mb-8">
    <div class="flex items-center gap-4 mb-4">
      <%= render Buttons::LinkComponent.new(
        content: '
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
        ',
        href: root_path,
        options: { class: "btn-icon" }
      ) %>
      <div>
        <h1 class="text-4xl font-bold text-white">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-300"><%= t('.title') %></span>
        </h1>
        <p class="text-bunker-300"><%= t('.subtitle') %></p>
      </div>
    </div>
  </div>

  <!-- Form Container -->
  <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl overflow-hidden">
    <div class="px-8 py-6 border-b border-bunker-800/50">
      <h2 class="text-xl font-semibold text-white flex items-center gap-2">
        <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        <%= t('.form_section') %>
      </h2>
    </div>
    <%= render "form", employment_information: @employment_information %>
  </div>
</div>
