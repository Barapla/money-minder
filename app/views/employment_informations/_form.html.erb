<%= form_with(model: employment_information, url: employment_information_path,
    method: employment_information.persisted? ? :patch : :post,
    local: true, html: { class: "px-8 py-6" }) do |form| %>

  <% if employment_information.errors.any? %>
    <div class="mb-6 bg-red-500/10 border border-red-500/20 rounded-xl p-4">
      <h4 class="text-red-400 font-semibold mb-2">Por favor corrige los siguientes errores:</h4>
      <ul class="list-disc list-inside space-y-1">
        <% employment_information.errors.full_messages.each do |message| %>
          <li class="text-red-300 text-sm"><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Left Column -->
    <div class="space-y-6">
      <%= render Forms::InputComponent.new(
        name: :job_title,
        form:,
        type: :text,
        options: {
          placeholder: "Ej: Desarrollador de Software",
          help_text: "Tu puesto o cargo actual",
          required: true
        }
      ) %>

      <%= render Forms::InputComponent.new(
        name: :start_date,
        form:,
        type: :date,
        options: {
          help_text: "Fecha en que comenzaste a trabajar en tu empleo actual",
          required: true,
          value: employment_information.start_date || Date.current
        }
      ) %>

      <%= render Forms::InputComponent.new(
        name: :gross_salary_amount,
        form:,
        type: :number,
        options: {
          step: 0.01,
          min: 0.01,
          placeholder: "0.00",
          prefix: "$",
          help_text: "Monto bruto de tu salario",
          required: true
        }
      ) %>

      <%= render Forms::SelectComponent.new(
        name: :salary_periodicity,
        form:,
        options_collection: [
          ["Diario", "daily"],
          ["Semanal", "weekly"],
          ["Quincenal", "biweekly"],
          ["Mensual", "monthly"],
          ["Anual", "yearly"]
        ],
        options: {
          help_text: "Periodicidad con la que recibes tu salario",
          required: true,
          selected: employment_information.salary_periodicity
        }
      ) %>
    </div>

    <!-- Right Column: Info Panel -->
    <div class="space-y-6">
      <div class="bg-bunker-800/60 border border-bunker-700/50 rounded-xl p-6">
        <h3 class="text-white font-semibold mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Acerca de la normalización salarial
        </h3>
        <div class="space-y-3 text-sm text-bunker-300">
          <p>El sistema calculará automáticamente tu salario en todas las periodicidades basándose en la siguiente conversión:</p>
          <ul class="space-y-1 list-disc list-inside text-bunker-400">
            <li>Salario diario base = Monto ingresado / Días de periodicidad</li>
            <li>Semanal = Diario × 7</li>
            <li>Quincenal = Diario × 15</li>
            <li>Mensual = Diario × 30</li>
            <li>Anual = Diario × 365</li>
          </ul>
        </div>
      </div>

      <div class="bg-bunker-800/60 border border-bunker-700/50 rounded-xl p-6">
        <h3 class="text-white font-semibold mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Antigüedad laboral
        </h3>
        <p class="text-sm text-bunker-300">
          La antigüedad se calcula automáticamente a partir de tu fecha de ingreso: años completos, meses adicionales y días trabajados en el año actual.
        </p>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="flex items-center justify-between pt-8 mt-8 border-t border-bunker-800/50">
    <% href_button = employment_information.persisted? ? employment_information_path : root_path %>
    <%= render Buttons::LinkComponent.new(
      content: '
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
        Cancelar
      ',
      href: href_button,
      options: { class: "btn-cancel" }
    ) %>
    <button type="submit" class="bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white px-8 py-3 rounded-xl font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-purple-500/30 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      Guardar Información Laboral
    </button>
  </div>
<% end %>
