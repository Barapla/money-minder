<div class="max-w-4xl mx-auto">
  <!-- Header -->
  <div class="bg-gradient-to-r from-bunker-900/80 to-emerald-900/80 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-8 mb-8">
    <div class="flex items-center gap-4 mb-4">
      <%= link_to saving_goals_path,
            class: "w-10 h-10 flex items-center justify-center rounded-xl bg-bunker-800/60 text-bunker-300 hover:text-white hover:bg-bunker-700/60 transition-all" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
      <% end %>
      <div>
        <h1 class="text-4xl font-bold text-white">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-emerald-300">🎯 Nueva Meta de Ahorro</span>
        </h1>
        <p class="text-bunker-300">Define un objetivo financiero concreto y visualiza tu progreso automáticamente</p>
      </div>
    </div>
  </div>

  <!-- Form Container -->
  <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl overflow-hidden">
    <div class="px-8 py-6 border-b border-bunker-800/50">
      <h2 class="text-xl font-semibold text-white flex items-center gap-2">
        <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
        Información de la meta
      </h2>
    </div>
    <%= render "form", saving_goal: @saving_goal %>
  </div>
</div>
