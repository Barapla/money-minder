<div id="<%= dom_id(message) %>" class="mb-4 flex <%= message.assistant? ? 'justify-start' : 'justify-end' %>">
  <div class="max-w-xl rounded-xl px-4 py-3 <%= message.assistant? ? 'bg-bunker-800 text-bunker-100' : 'bg-purple-600 text-white' %>">
    <p class="whitespace-pre-line text-sm"><%= message.content %></p>

    <% assumptions = message.metadata&.dig('assumptions') %>
    <% if message.assistant? && assumptions.present? %>
      <div class="mt-3 pt-2 border-t border-bunker-700">
        <p class="text-xs font-semibold text-purple-300 mb-1">Supuestos</p>
        <ul class="text-xs text-bunker-300 list-disc list-inside space-y-0.5">
          <% assumptions.each do |assumption| %>
            <li><%= assumption %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% warnings = message.metadata&.dig('warnings') %>
    <% if message.assistant? && warnings.present? %>
      <div class="mt-2">
        <p class="text-xs font-semibold text-amber-400 mb-1">Advertencias</p>
        <ul class="text-xs text-amber-300 list-disc list-inside space-y-0.5">
          <% warnings.each do |warning| %>
            <li><%= warning %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>
