<div class="w-64 shrink-0 border-r border-bunker-800 bg-bunker-950/60 flex flex-col">
  <div class="p-4 border-b border-bunker-800">
    <%= button_to 'Nueva conversación', conversations_path, method: :post,
          class: 'w-full bg-purple-600 hover:bg-purple-500 text-white text-sm font-medium px-3 py-2 rounded-lg transition-colors' %>
  </div>
  <div class="flex-1 overflow-y-auto">
    <% if conversations.empty? %>
      <p class="px-4 py-3 text-sm text-bunker-400">Aún no tienes conversaciones.</p>
    <% else %>
      <% conversations.each do |item| %>
        <%= link_to item.title, conversation_path(item),
              class: "block px-4 py-3 text-sm border-b border-bunker-900 truncate #{item == conversation ? 'bg-bunker-800 text-white' : 'text-bunker-300 hover:bg-bunker-900'}" %>
      <% end %>
    <% end %>
  </div>
</div>
