<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="bg-gradient-to-r from-bunker-900/80 to-purple-900/80 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6 mb-6">
    <h1 class="text-3xl font-bold text-white">Dashboard Financiero</h1>
    <p class="text-bunker-300 mt-1">Resumen de tu situación financiera actual</p>
  </div>

  <!-- Grid principal: 2 columnas en desktop, 1 en móvil -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

    <!-- Card 1: Saldo disponible -->
    <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
      <div class="flex items-center mb-4">
        <div class="w-10 h-10 bg-emerald-500/20 rounded-xl flex items-center justify-center mr-3">
          <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-white">Saldo Disponible</h2>
      </div>

      <div class="mb-4">
        <div class="text-4xl font-bold <%= @presenter.available_balance >= 0 ? 'text-emerald-400' : 'text-red-400' %>">
          <%= @presenter.available_balance_formatted %>
        </div>
        <div class="text-bunker-400 text-sm mt-1">Total efectivo + débito + ahorros</div>
      </div>

      <% breakdown = @presenter.balance_breakdown %>
      <div class="space-y-2 border-t border-bunker-700/50 pt-4">
        <!-- Efectivo -->
        <div class="flex justify-between items-center">
          <div class="flex items-center">
            <div class="w-2 h-2 bg-purple-400 rounded-full mr-2"></div>
            <span class="text-bunker-300 text-sm">Efectivo</span>
          </div>
          <span class="text-white font-medium text-sm"><%= breakdown[:cash_formatted] %></span>
        </div>

        <!-- Tarjetas de débito -->
        <% if @presenter.debit_cards? %>
          <% breakdown[:debit_detail].each do |card| %>
            <div class="flex justify-between items-center">
              <div class="flex items-center">
                <div class="w-2 h-2 bg-blue-400 rounded-full mr-2"></div>
                <span class="text-bunker-300 text-sm"><%= card[:name] %></span>
              </div>
              <span class="text-white font-medium text-sm"><%= card[:balance_formatted] %></span>
            </div>
          <% end %>
        <% end %>

        <!-- Fondos de ahorro -->
        <% if @presenter.savings_funds? %>
          <% breakdown[:savings_detail].each do |fund| %>
            <div class="flex justify-between items-center">
              <div class="flex items-center">
                <div class="w-2 h-2 bg-emerald-400 rounded-full mr-2"></div>
                <span class="text-bunker-300 text-sm"><%= fund[:name] %></span>
              </div>
              <span class="text-white font-medium text-sm"><%= fund[:balance_formatted] %></span>
            </div>
          <% end %>
        <% else %>
          <% unless @presenter.debit_cards? %>
            <div class="text-bunker-500 text-sm italic">Sin fondos de ahorro ni débito configurados</div>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Card 2: Total de deuda -->
    <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
      <div class="flex items-center mb-4">
        <div class="w-10 h-10 bg-red-500/20 rounded-xl flex items-center justify-center mr-3">
          <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-white">Deuda en Tarjetas</h2>
      </div>

      <% if @presenter.credit_cards? %>
        <div class="mb-4">
          <div class="text-4xl font-bold text-red-400">
            <%= @presenter.total_debt_formatted %>
          </div>
          <div class="text-bunker-400 text-sm mt-1">Suma de saldos actuales</div>
        </div>

        <% debt_items = @presenter.debt_breakdown %>
        <% if debt_items.any? %>
          <div class="space-y-2 border-t border-bunker-700/50 pt-4">
            <% debt_items.each do |item| %>
              <div class="flex justify-between items-center">
                <div class="flex items-center">
                  <div class="w-2 h-2 bg-red-400 rounded-full mr-2"></div>
                  <span class="text-bunker-300 text-sm"><%= item[:card_name] %></span>
                </div>
                <span class="text-red-300 font-medium text-sm"><%= item[:debt_formatted] %></span>
              </div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-6">
          <div class="text-bunker-400 text-sm mb-3">No tienes tarjetas de crédito configuradas</div>
          <%= link_to "Agregar tarjeta", new_budget_path, class: "text-purple-400 text-sm hover:text-purple-300 underline" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Card 3: Próximas fechas de corte -->
  <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6 mb-6">
    <div class="flex items-center mb-4">
      <div class="w-10 h-10 bg-blue-500/20 rounded-xl flex items-center justify-center mr-3">
        <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
      </div>
      <h2 class="text-xl font-semibold text-white">Próximas Fechas de Corte</h2>
    </div>

    <% cutting_dates = @presenter.upcoming_card_due_dates %>
    <% if cutting_dates.any? %>
      <div class="space-y-3">
        <% cutting_dates.each do |card| %>
          <div class="flex items-center justify-between bg-bunker-800/40 rounded-xl p-4">
            <div>
              <div class="text-white font-medium"><%= card[:card_name] %></div>
              <div class="text-bunker-400 text-sm mt-0.5">
                Corte: <%= card[:cutting_date].strftime('%d/%m/%Y') %> &bull;
                Pago: <%= card[:payment_due_date].strftime('%d/%m/%Y') %>
              </div>
              <% if card[:current_debt].positive? %>
                <div class="text-red-400 text-xs mt-1">
                  Saldo: <%= card[:current_debt_formatted] %>
                </div>
              <% end %>
            </div>
            <div class="text-right">
              <% days = card[:days_until_cutting] %>
              <% badge_class = days <= 3 ? 'bg-red-500/20 text-red-300' : days <= 7 ? 'bg-amber-500/20 text-amber-300' : 'bg-bunker-700/60 text-bunker-300' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium <%= badge_class %>">
                <% if days == 0 %>Hoy<% elsif days == 1 %>Mañana<% else %><%= days %> días<% end %>
              </span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-6">
        <div class="text-bunker-400 text-sm mb-3">No tienes tarjetas de crédito configuradas</div>
        <%= link_to "Agregar tarjeta", new_budget_path, class: "text-purple-400 text-sm hover:text-purple-300 underline" %>
      </div>
    <% end %>
  </div>

  <!-- Card 5: Metas de Ahorro -->
  <% if @presenter.saving_goals? %>
    <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6 mb-6">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center">
          <div class="w-10 h-10 bg-emerald-500/20 rounded-xl flex items-center justify-center mr-3">
            <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-white">Metas de Ahorro</h2>
            <p class="text-bunker-400 text-xs mt-0.5">Arrastra para reordenar la prioridad</p>
          </div>
        </div>
        <%= link_to saving_goals_path, class: "text-purple-400 text-sm hover:text-purple-300 underline" do %>
          Ver todas
        <% end %>
      </div>

      <div class="space-y-3"
           data-controller="savings-goals-reorder"
           data-savings-goals-reorder-url-value="<%= reorder_saving_goals_path %>">
        <% @presenter.prioritized_saving_goals.each_with_index do |item, index| %>
          <% goal = item[:saving_goal] %>
          <div class="bg-bunker-800/40 rounded-xl p-4 cursor-grab active:cursor-grabbing"
               draggable="true"
               data-savings-goals-reorder-target="item"
               data-goal-id="<%= goal.id %>"
               data-action="dragstart->savings-goals-reorder#dragstart dragover->savings-goals-reorder#dragover dragend->savings-goals-reorder#dragend">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <span class="text-bunker-500 text-xs font-medium w-5 text-center" data-priority-number><%= index + 1 %></span>
                <span class="text-white font-medium text-sm"><%= goal.name %></span>
                <% if goal.deadline %>
                  <span class="text-bunker-500 text-xs">· <%= goal.deadline.strftime('%d/%m/%Y') %></span>
                <% end %>
              </div>
              <span class="text-emerald-300 text-sm font-semibold"><%= item[:progress_percentage] %>%</span>
            </div>

            <!-- Barra de progreso -->
            <div class="w-full bg-bunker-700/60 rounded-full h-2 mb-2">
              <div class="h-2 rounded-full bg-emerald-500 transition-all duration-300"
                   style="width: <%= item[:progress_percentage] %>%"></div>
            </div>

            <div class="flex justify-between text-xs text-bunker-400">
              <span>Asignado: <span class="text-emerald-400 font-medium"><%= item[:allocated_formatted] %></span></span>
              <span>Meta: <span class="text-white font-medium"><%= item[:target_formatted] %></span></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Card 4: Alertas de utilización -->
  <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
    <div class="flex items-center mb-4">
      <div class="w-10 h-10 bg-amber-500/20 rounded-xl flex items-center justify-center mr-3">
        <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      </div>
      <h2 class="text-xl font-semibold text-white">Alertas de Utilización</h2>
    </div>

    <% alerts = @presenter.credit_utilization_alerts %>
    <% if alerts.any? %>
      <div class="space-y-4">
        <% alerts.each do |alert| %>
          <% status_classes = alert[:utilization_status] == :critical ? 'border-red-500/30 bg-red-500/5' : 'border-amber-500/30 bg-amber-500/5' %>
          <div class="border rounded-xl p-4 <%= status_classes %>">
            <div class="flex items-start justify-between mb-3">
              <div class="font-medium text-white"><%= alert[:card_name] %></div>
              <% badge_class = alert[:utilization_status] == :critical ? 'bg-red-500/20 text-red-300' : 'bg-amber-500/20 text-amber-300' %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= badge_class %>">
                <%= alert[:utilization_percentage] %>% utilizado
              </span>
            </div>

            <!-- Barra de progreso -->
            <div class="w-full bg-bunker-700/60 rounded-full h-2 mb-3">
              <% bar_class = alert[:utilization_status] == :critical ? 'bg-red-500' : 'bg-amber-500' %>
              <div class="h-2 rounded-full <%= bar_class %>" style="width: <%= [alert[:utilization_percentage], 100].min %>%"></div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
              <div class="text-bunker-300">
                Saldo actual: <span class="text-white font-medium"><%= alert[:current_balance_formatted] %></span>
              </div>
              <div class="text-bunker-300">
                Pagar <%= alert[:suggested_payment_formatted] %> para llegar al 30%
              </div>
              <% if alert[:cutting_date] %>
                <div class="text-bunker-300 sm:col-span-2">
                  Paga antes del corte: <span class="text-white font-medium"><%= alert[:cutting_date].strftime('%d/%m/%Y') %></span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% elsif @presenter.credit_cards? %>
      <div class="flex items-center bg-emerald-500/10 border border-emerald-500/20 rounded-xl p-4">
        <svg class="w-5 h-5 text-emerald-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
          <div class="text-emerald-300 font-medium">Utilización saludable</div>
          <div class="text-emerald-400/70 text-sm">Todas tus tarjetas están por debajo del 30% de utilización.</div>
        </div>
      </div>
    <% else %>
      <div class="text-bunker-400 text-sm">No tienes tarjetas de crédito configuradas.</div>
    <% end %>
  </div>
</div>
