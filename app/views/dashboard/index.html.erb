<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="bg-gradient-to-r from-bunker-900/80 to-purple-900/80 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6 mb-6">
    <h1 class="text-3xl font-bold text-white">Dashboard Financiero</h1>
    <p class="text-bunker-300 mt-1">Resumen de tu situación financiera actual</p>
  </div>

  <!-- Fila 1: Saldo Disponible + Próxima Nómina -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <%= render 'available_balance_card' %>
    <%= render 'next_payroll_card' %>
  </div>

  <!-- Fila 2: Presupuesto del Mes (ancho completo) -->
  <div class="mb-6">
    <%= render 'monthly_budget_card' %>
  </div>

  <!-- Fila 3: Fechas de Corte + Metas de Ahorro + Alertas (compactas, 3 columnas) -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <%= render 'credit_cards_compact' %>
    <%= render 'saving_goals_compact' %>
    <%= render 'utilization_alerts_compact' %>
  </div>

  <!-- Fila 4: Gastos Recurrentes + Próximos Pagos -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <%= render 'recurring_expenses_card' %>
    <%= render 'upcoming_payments_card' %>
  </div>
</div>
