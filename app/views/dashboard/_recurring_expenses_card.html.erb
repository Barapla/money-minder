<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6 flex flex-col">
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center">
      <div class="w-10 h-10 bg-orange-500/20 rounded-xl flex items-center justify-center mr-3">
        <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
      </div>
      <h2 class="text-base font-semibold text-white">Gastos Recurrentes</h2>
    </div>
    <%= link_to "Ver todos", recurring_transactions_path, class: "text-orange-400 text-xs hover:text-orange-300 underline" %>
  </div>

  <% summary = @presenter.recurring_expenses_summary %>
  <% if @presenter.recurring_expenses? %>
    <div class="flex-1">
      <div class="grid grid-cols-2 gap-3 mb-4">
        <div class="bg-bunker-800/40 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-white"><%= summary[:count] %></div>
          <div class="text-bunker-400 text-xs mt-1">transacciones activas</div>
        </div>
        <div class="bg-bunker-800/40 rounded-xl p-4 text-center">
          <div class="text-lg font-bold text-orange-300 leading-tight"><%= number_to_currency(summary[:monthly_total], unit: '$') %></div>
          <div class="text-bunker-400 text-xs mt-1">total mensual</div>
        </div>
      </div>
      <div class="bg-orange-500/10 border border-orange-500/20 rounded-xl p-3">
        <p class="text-orange-300 text-xs">Compromisos de gasto mensuales estimados.</p>
      </div>
    </div>
  <% else %>
    <div class="text-center py-6 flex-1">
      <p class="text-bunker-400 text-sm mb-2">Sin gastos recurrentes activos</p>
      <%= link_to "Crear gasto recurrente", new_transaction_path, class: "text-orange-400 text-xs hover:text-orange-300 underline" %>
    </div>
  <% end %>
</div>
