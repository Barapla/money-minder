<% gap = @presenter.top_saving_goal_gap %>
<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6 flex flex-col">
  <div class="flex items-center justify-between gap-3 mb-4">
    <h2 class="text-base font-semibold text-white"><%= t('.title') %></h2>
    <%= link_to "#{t('.see_all')} →", saving_goals_path, class: "text-purple-300 text-sm font-medium hover:text-purple-200 shrink-0" %>
  </div>

  <% if @presenter.saving_goals? %>
    <div class="space-y-4 flex-1"
         data-controller="savings-goals-calculator"
         data-savings-goals-calculator-url-value="<%= dashboard_saving_goals_recalculate_path(format: :json) %>">
      <% @presenter.prioritized_saving_goals.first(4).each do |item| %>
        <% goal = item[:saving_goal] %>
        <div data-savings-goals-calculator-target="goal" data-goal-id="<%= goal.id %>">
          <div class="flex items-baseline justify-between gap-2 mb-2">
            <span class="text-white text-sm font-semibold line-clamp-1"><%= goal.name %></span>
            <span class="font-mono text-[13px] font-bold text-emerald-300 shrink-0" data-percentage><%= item[:progress_percentage] %>%</span>
          </div>
          <div class="w-full bg-bunker-950/70 rounded-full h-2 mb-1.5"
               role="progressbar"
               aria-label="<%= goal.name %>"
               aria-valuenow="<%= item[:progress_percentage] %>" aria-valuemin="0" aria-valuemax="100">
            <div class="h-2 rounded-full bg-gradient-to-r from-emerald-600 to-emerald-400 transition-all duration-300"
                 data-progress-bar
                 style="width: <%= item[:progress_percentage] %>%"></div>
          </div>
          <div class="flex justify-between text-[11.5px] text-bunker-400 font-mono">
            <span data-allocated-amount><%= item[:allocated_formatted] %></span>
            <span><%= item[:target_formatted] %></span>
          </div>
        </div>
      <% end %>
    </div>

    <% if gap %>
      <div class="mt-4 bg-emerald-500/10 border border-emerald-500/20 rounded-xl px-4 py-3">
        <div class="text-emerald-300 text-[12.5px] font-semibold"><%= t('.gap_title', amount: gap[:missing_formatted], goal: gap[:name]) %></div>
        <div class="text-emerald-200/70 text-[11.5px] mt-0.5"><%= t('.gap_subtitle') %></div>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-6 flex-1">
      <p class="text-bunker-400 text-sm mb-2"><%= t('.no_goals') %></p>
      <%= link_to t('.new_goal'), new_saving_goal_path, class: "text-emerald-400 text-xs hover:text-emerald-300 underline" %>
    </div>
  <% end %>
</div>
