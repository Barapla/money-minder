<% items = @presenter.monthly_budget_summary %>
<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
  <h2 class="text-base font-semibold text-white mb-4"><%= t('.title') %></h2>

  <% if items.any? %>
    <div class="flex items-center gap-5">
      <div class="relative w-[118px] h-[118px] shrink-0 rounded-full"
           role="img"
           aria-label="<%= t('.chart_label', total: @presenter.monthly_expense_total_formatted) %>"
           style="background: <%= expense_donut_gradient(items) %>">
        <div class="absolute inset-[19px] rounded-full bg-bunker-900 flex flex-col items-center justify-center">
          <span class="font-mono text-sm font-bold text-white"><%= number_to_currency(@presenter.monthly_expense_total, unit: '$', precision: 0) %></span>
          <span class="text-[9px] text-bunker-400 uppercase tracking-wide"><%= t('.top_label', count: items.size) %></span>
        </div>
      </div>
      <ul class="flex-1 flex flex-col gap-1.5 text-xs">
        <% items.each_with_index do |item, index| %>
          <li class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-sm shrink-0" style="background: <%= donut_color(index) %>"></span>
            <span class="text-bunker-200 flex-1 line-clamp-1"><%= item[:category_name] %></span>
            <span class="font-mono text-white"><%= item[:share_percent].to_i %>%</span>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <p class="text-bunker-400 text-sm text-center py-8"><%= t('.no_expenses') %></p>
  <% end %>
</div>
