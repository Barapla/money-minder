<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6 flex flex-col">
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center">
      <div class="w-10 h-10 bg-blue-500/20 rounded-xl flex items-center justify-center mr-3">
        <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
      </div>
      <h2 class="text-base font-semibold text-white">Fechas de Corte</h2>
    </div>
    <% if @presenter.credit_cards? %>
      <span class="text-bunker-400 text-xs">Deuda: <span class="text-red-300 font-medium"><%= @presenter.total_debt_formatted %></span></span>
    <% end %>
  </div>

  <% cutting_dates = @presenter.upcoming_card_due_dates %>
  <% if cutting_dates.any? %>
    <div class="overflow-y-auto max-h-72 space-y-2 flex-1">
      <% cutting_dates.first(5).each do |card| %>
        <div class="bg-bunker-800/40 rounded-xl p-3">
          <div class="flex items-center justify-between mb-1">
            <span class="text-white text-sm font-medium line-clamp-1"><%= card[:card_name] %></span>
            <% days = card[:days_until_cutting] %>
            <% badge_class = days <= 3 ? 'bg-red-500/20 text-red-300' : days <= 7 ? 'bg-amber-500/20 text-amber-300' : 'bg-bunker-700/60 text-bunker-300' %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ml-2 shrink-0 <%= badge_class %>">
              <% if days == 0 %>Hoy<% elsif days == 1 %>Mañana<% else %><%= days %>d<% end %>
            </span>
          </div>
          <div class="text-bunker-400 text-xs">
            Corte: <%= card[:cutting_date].strftime('%d/%m') %>
            <% if card[:current_debt].positive? %>
              &bull; <span class="text-red-400"><%= card[:current_debt_formatted] %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <% if cutting_dates.size > 5 %>
      <div class="mt-3 pt-3 border-t border-bunker-700/50">
        <%= link_to "Ver todas (#{cutting_dates.size})", budgets_path, class: "text-blue-400 text-xs hover:text-blue-300" %>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-6 flex-1">
      <p class="text-bunker-400 text-sm mb-2">Sin tarjetas de crédito</p>
      <%= link_to "Agregar tarjeta", new_budget_path, class: "text-blue-400 text-xs hover:text-blue-300 underline" %>
    </div>
  <% end %>
</div>
