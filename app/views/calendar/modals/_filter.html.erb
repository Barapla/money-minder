<%= tag.div(data: { controller: "calendar-filter", calendar_filter_url_value: set_month_calendar_index_path(date: date.strftime('%Y-%m-%d')) }, class: "space-y-6") do %>
    <!-- Tipos de Transacciones -->
    <div class="bg-bunker-800/30 rounded-2xl p-6">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
            </svg>
            Tipos de Transacciones
        </h3>
        
        <div class="grid grid-cols-3 gap-4">
            <% income_icon = render_svg("vector-up") %>
            <%= render Forms::Checkbox::SimpleComponent.new(name: "income", options:
                                                                            { title: "Ingresos", description: "Entradas de dinero", svg_icon: income_icon, 
                                                                                checked: @income_check, value: "income", color: "emerald",
                                                                                data: { calendar_filter_target: "special_radio" } }) %>

            <% expense_icon = render_svg("vector-down") %>
            <%= render Forms::Checkbox::SimpleComponent.new(name: "expense", options:
                                                                            { title: "Gastos", description: "Salidas de dinero", svg_icon: expense_icon, 
                                                                                checked: @expense_check, value: "expense", color: "red",
                                                                                data: { calendar_filter_target: "special_radio" } }) %>
            
            <% transfer_icon = render_svg("transfer") %>
            <%= render Forms::Checkbox::SimpleComponent.new(name: "transfer_and_income", options:
                                                                            { title: "Transferencias", description: "Entre cuentas", svg_icon: transfer_icon, 
                                                                                checked: @transfer_check, value: "transfer_and_income", color: "blue",
                                                                                data: { calendar_filter_target: "special_radio" } }) %>
        </div>
    </div>

    <!-- Categorías de Transacciones -->
    <div class="bg-bunker-800/30 rounded-2xl p-6" data-controller="checkbox-icon-group">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
            </svg>
            Presupuestos
        </h3>
        
        <div class="grid grid-cols-4 gap-3">
            <% budgets = Budget.all.order(:id).includes(:icon) %>
            <% exists_budgets = @filter.present? && @filter[:budgets].present? %>
            <% budgets.each do |budget| %>
                <%= render Forms::Checkbox::IconComponent.new(name: "budget_#{budget.id}", options:
                                                                                { title: budget.name, svg_icon: budget.icon.value, 
                                                                                    checked: exists_budgets ? @filter[:budgets].include?(budget.id.to_s) : true, value: budget.id, color: "purple",
                                                                                    data: { checkbox_icon_group_target: "checkbox", 
                                                                                    calendar_filter_target: "budget_checkbox" }})  %>
            <% end %>
        </div>
        
        <div class="mt-3 flex gap-3">
            <button type="button" class="text-xs text-purple-400 hover:text-purple-300" data-action="checkbox-icon-group#selectAll">Seleccionar todas</button>
            <span class="text-bunker-600">•</span>
            <button type="button" class="text-xs text-purple-400 hover:text-purple-300" data-action="checkbox-icon-group#deselectAll">Deseleccionar todas</button>
        </div>
    </div>

    <!-- Categorías de Transacciones -->
    <div class="bg-bunker-800/30 rounded-2xl p-6" data-controller="checkbox-icon-group">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
            </svg>
            Categorías de Transacciones
        </h3>
        
        <div class="grid grid-cols-4 gap-3">
            <% categories = Category.children.order(:id).includes(:icon) %>
            <% exists_icons = @filter.present? && @filter[:icons].present? %>
            <% categories.each do |category| %>
                <%= render Forms::Checkbox::IconComponent.new(name: category.code, options:
                                                                                { title: category.name, svg_icon: category.icon.value, 
                                                                                    checked: exists_icons ? @filter[:icons].include?(category.code) : true, value: category.code, color: "purple",
                                                                                    data: { checkbox_icon_group_target: "checkbox", 
                                                                                    calendar_filter_target: "icon_checkbox" }})  %>
            <% end %>
        </div>
        
        <div class="mt-3 flex gap-3">
            <button type="button" class="text-xs text-purple-400 hover:text-purple-300" data-action="checkbox-icon-group#selectAll">Seleccionar todas</button>
            <span class="text-bunker-600">•</span>
            <button type="button" class="text-xs text-purple-400 hover:text-purple-300" data-action="checkbox-icon-group#deselectAll">Deseleccionar todas</button>
        </div>
    </div>

    <!-- Rango de Montos -->
    <div class="bg-bunker-800/30 rounded-2xl p-6">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Rango de Montos
        </h3>
        
        <div class="grid lg:grid-cols-2 gap-6">
            <%= fields_for "report_filter", ReportFilter.new do |form| %>
                <%= render Forms::InputComponent.new(
                    name: :min_amount,
                    form:,
                    type: :number,
                    options: { 
                        step: 0.01,
                        placeholder: "0.00",
                        prefix: "$",
                        help_text: "Transacciones mayores o iguales a este monto",
                        value: @filter.present? ? @filter[:min_amount] : nil,
                        data: {
                            calendar_filter_target: "min_amount"
                        }
                    }
                ) %>


                <%= render Forms::InputComponent.new(
                    name: :max_amount,
                    form:,
                    type: :number,
                    options: { 
                        step: 0.01,
                        placeholder: "Sin límite",
                        prefix: "$",
                        help_text: "Transacciones menores o iguales a este monto",
                        value: @filter.present? ? @filter[:max_amount] : nil,
                        data: {
                            calendar_filter_target: "max_amount"
                        }
                    }
                ) %>
            <% end %>
        </div>
        
        <!-- Botones rápidos de montos -->
        <div class="mt-4 flex flex-wrap gap-2">
            <button data-action="click->calendar-filter#changeAmount" data-calendar-filter-max-param="100" type="button" class="px-3 py-1.5 bg-bunker-800/60 hover:bg-purple-500/20 text-bunker-300 hover:text-purple-300 border border-bunker-700/50 hover:border-purple-500/30 rounded-lg text-sm transition-all duration-200">
                Menos de $100
            </button>
            <button data-action="click->calendar-filter#changeAmount" data-calendar-filter-min-param="100" data-calendar-filter-max-param="500" type="button" class="px-3 py-1.5 bg-bunker-800/60 hover:bg-purple-500/20 text-bunker-300 hover:text-purple-300 border border-bunker-700/50 hover:border-purple-500/30 rounded-lg text-sm transition-all duration-200">
                $100 - $500
            </button>
            <button data-action="click->calendar-filter#changeAmount" data-calendar-filter-min-param="500" data-calendar-filter-max-param="1000" type="button" class="px-3 py-1.5 bg-bunker-800/60 hover:bg-purple-500/20 text-bunker-300 hover:text-purple-300 border border-bunker-700/50 hover:border-purple-500/30 rounded-lg text-sm transition-all duration-200">
                $500 - $1,000
            </button>
            <button data-action="click->calendar-filter#changeAmount" data-calendar-filter-min-param="1000" type="button" class="px-3 py-1.5 bg-bunker-800/60 hover:bg-purple-500/20 text-bunker-300 hover:text-purple-300 border border-bunker-700/50 hover:border-purple-500/30 rounded-lg text-sm transition-all duration-200">
                Más de $1,000
            </button>
        </div>
    </div>
<% end %>