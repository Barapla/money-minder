<div class="max-w-6xl mx-auto">
    <!-- Header del Calendario -->
    <div class="bg-gradient-to-r from-bunker-900/80 to-purple-900/80 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-8 mb-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-4xl font-bold text-white mb-2">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-300">💳 </span>
                </h1>
                <p class="text-bunker-300">Visualiza tu historial financiero por fecha</p>
            </div>
            <div class="flex gap-3">
                <!-- Botón para abrir el modal (agrégalo donde prefieras en tu vista) -->
                <%= render Buttons::LinkComponent.new(content: '
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
                    </svg>
                    Filtros Avanzados
                    ', href: advanced_search_calendar_index_path, 
                    options: { 
                        class: "px-4 py-2 bg-bunker-800/60 hover:bg-bunker-700/60 text-white border border-bunker-700/50 hover:border-bunker-600/50 rounded-xl font-medium transition-all duration-200 flex items-center gap-2", 
                        data: { 
                            turbo_frame: "modal_frame"
                        } 
                    })
                %>
                <button onclick="exportTransactions()" class="bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white px-6 py-2 rounded-xl font-medium transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    Exportar
                </button>
            </div>
        </div>
    </div>

    <!-- Filtros Rápidos -->
    <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6 mb-8">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-white flex items-center gap-2">
                <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.207A1 1 0 013 6.5V4z"></path>
                </svg>
                Filtros Rápidos
            </h2>
            <button onclick="clearFilters()" class="text-bunker-400 hover:text-white text-sm">
                Limpiar filtros
            </button>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3">
            <button onclick="filterByType('all')" class="filter-btn active px-4 py-2 bg-purple-500/20 text-purple-300 border border-purple-500/30 rounded-xl text-sm font-medium transition-all duration-200">
                Todas
            </button>
            <button onclick="filterByType('income')" class="filter-btn px-4 py-2 bg-bunker-800/60 hover:bg-emerald-500/20 text-bunker-300 hover:text-emerald-300 border border-bunker-700/50 hover:border-emerald-500/30 rounded-xl text-sm font-medium transition-all duration-200">
                Ingresos
            </button>
            <button onclick="filterByType('expense')" class="filter-btn px-4 py-2 bg-bunker-800/60 hover:bg-red-500/20 text-bunker-300 hover:text-red-300 border border-bunker-700/50 hover:border-red-500/30 rounded-xl text-sm font-medium transition-all duration-200">
                Gastos
            </button>
            <button onclick="filterByCategory('food')" class="filter-btn px-4 py-2 bg-bunker-800/60 hover:bg-yellow-500/20 text-bunker-300 hover:text-yellow-300 border border-bunker-700/50 hover:border-yellow-500/30 rounded-xl text-sm font-medium transition-all duration-200">
                Comida
            </button>
            <button onclick="filterByCategory('transport')" class="filter-btn px-4 py-2 bg-bunker-800/60 hover:bg-blue-500/20 text-bunker-300 hover:text-blue-300 border border-bunker-700/50 hover:border-blue-500/30 rounded-xl text-sm font-medium transition-all duration-200">
                Transporte
            </button>
            <button onclick="filterByCategory('entertainment')" class="filter-btn px-4 py-2 bg-bunker-800/60 hover:bg-pink-500/20 text-bunker-300 hover:text-pink-300 border border-bunker-700/50 hover:border-pink-500/30 rounded-xl text-sm font-medium transition-all duration-200">
                Entretenimiento
            </button>
        </div>
    </div>
    <%= turbo_frame_tag "calendar", data: { controller: "calendar-loader" } do %>
        <%= render partial: "calendar/index/month", locals: { date: Date.today, transactions: @transactions } %>
    <% end %>
    <!-- Resumen del Mes -->
    <%= turbo_frame_tag "summary" do %>
        <%= render partial: "calendar/index/summary", locals: { transactions: @transactions, income_transactions: @income_transactions, expense_transactions: @expense_transactions } %>
    <% end %>
</div>
