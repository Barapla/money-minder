<!-- Navbar -->
<nav class="bg-bunker-950/90 backdrop-blur-lg border-b border-bunker-800 sticky top-0 z-50"
     data-controller="navbar-mobile"
     data-action="keydown.escape@document->navbar-mobile#closeAll">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">

      <!-- Logo / Brand -->
      <div class="flex-shrink-0 flex items-center">
        <%= render Buttons::LinkComponent.new(
          content: '
            <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-purple-400 rounded-lg flex items-center justify-center mr-3">
              <span class="text-white font-bold text-lg">💰</span>
            </div>
            <h1 class="text-xl font-bold text-white">MoneyMinder</h1>
          ',
          href: root_path,
          options: { class: "flex items-center" }
        ) %>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-1">

        <!-- Dashboard (enlace directo) -->
        <%= navbar_link_to(t('.dashboard_link'), root_path) %>

        <!-- Dropdown: Transacciones -->
        <div class="relative"
             data-controller="navbar-dropdown"
             data-action="mouseenter->navbar-dropdown#open mouseleave->navbar-dropdown#startCloseTimer keydown->navbar-dropdown#keydown">
          <button type="button"
                  class="<%= navbar_dropdown_trigger_class([transactions_path, calendar_index_path]) %>"
                  data-navbar-dropdown-target="button"
                  data-action="click->navbar-dropdown#toggle"
                  aria-haspopup="true"
                  aria-expanded="false">
            <%= t('.transactions_dropdown') %>
            <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="hidden absolute left-0 top-full mt-1 w-52 rounded-xl bg-bunker-900 border border-bunker-700 shadow-xl shadow-black/40 overflow-hidden z-50 py-1"
               data-navbar-dropdown-target="dropdown"
               data-action="mouseenter->navbar-dropdown#cancelCloseTimer mouseleave->navbar-dropdown#startCloseTimer">
            <%= navbar_dropdown_item_to(t('.all_transactions'), transactions_path) %>
            <%= navbar_dropdown_item_to(t('.financial_calendar'), calendar_index_path) %>
          </div>
        </div>

        <!-- Dropdown: Planificación -->
        <div class="relative"
             data-controller="navbar-dropdown"
             data-action="mouseenter->navbar-dropdown#open mouseleave->navbar-dropdown#startCloseTimer keydown->navbar-dropdown#keydown">
          <button type="button"
                  class="<%= navbar_dropdown_trigger_class([budgets_path, obligatory_payments_path, obligatory_payments_calendar_index_path, saving_goals_path]) %>"
                  data-navbar-dropdown-target="button"
                  data-action="click->navbar-dropdown#toggle"
                  aria-haspopup="true"
                  aria-expanded="false">
            <%= t('.planning_dropdown') %>
            <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="hidden absolute left-0 top-full mt-1 w-52 rounded-xl bg-bunker-900 border border-bunker-700 shadow-xl shadow-black/40 overflow-hidden z-50 py-1"
               data-navbar-dropdown-target="dropdown"
               data-action="mouseenter->navbar-dropdown#cancelCloseTimer mouseleave->navbar-dropdown#startCloseTimer">
            <%= navbar_dropdown_item_to(t('.budgets_link'), budgets_path) %>
            <%= navbar_dropdown_item_to(t('.reminders_link'), obligatory_payments_path) %>
            <%= navbar_dropdown_item_to(t('.reminders_calendar_link'), obligatory_payments_calendar_index_path) %>
            <%= navbar_dropdown_item_to(t('.saving_goals_link'), saving_goals_path) %>
          </div>
        </div>

        <!-- Reportes (enlace directo) -->
        <%= navbar_link_to(t('.reports_link'), reports_path) %>

        <!-- Dropdown: Administración -->
        <div class="relative"
             data-controller="navbar-dropdown"
             data-action="mouseenter->navbar-dropdown#open mouseleave->navbar-dropdown#startCloseTimer keydown->navbar-dropdown#keydown">
          <button type="button"
                  class="<%= navbar_dropdown_trigger_class([current_user&.employment_information ? employment_information_path : new_employment_information_path, edit_payroll_profile_path]) %>"
                  data-navbar-dropdown-target="button"
                  data-action="click->navbar-dropdown#toggle"
                  aria-haspopup="true"
                  aria-expanded="false">
            <%= t('.administration_dropdown') %>
            <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="hidden absolute left-0 top-full mt-1 w-52 rounded-xl bg-bunker-900 border border-bunker-700 shadow-xl shadow-black/40 overflow-hidden z-50 py-1"
               data-navbar-dropdown-target="dropdown"
               data-action="mouseenter->navbar-dropdown#cancelCloseTimer mouseleave->navbar-dropdown#startCloseTimer">
            <%= navbar_dropdown_item_to(t('.employment_profile_link'), current_user&.employment_information ? employment_information_path : new_employment_information_path) %>
            <%= navbar_dropdown_item_to(t('.payroll_link'), edit_payroll_profile_path) %>
          </div>
        </div>

      </div>

      <!-- Acciones de usuario (derecha) -->
      <div class="flex items-center space-x-3">

        <!-- Menú de usuario circular (desktop) -->
        <% if user_signed_in? %>
          <div class="relative hidden md:block"
               data-controller="navbar-dropdown"
               data-action="mouseenter->navbar-dropdown#open mouseleave->navbar-dropdown#startCloseTimer keydown->navbar-dropdown#keydown">
            <button type="button"
                    class="navbar-user-button"
                    data-navbar-dropdown-target="button"
                    data-action="click->navbar-dropdown#toggle"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-label="<%= t('.user_menu_label') %>"
                    id="user-menu-button">
              <%= current_user.email.first.upcase %>
            </button>
            <div class="hidden absolute right-0 top-full mt-2 w-52 rounded-xl bg-bunker-900 border border-bunker-700 shadow-xl shadow-black/40 overflow-hidden z-50 py-1"
                 data-navbar-dropdown-target="dropdown"
                 data-action="mouseenter->navbar-dropdown#cancelCloseTimer mouseleave->navbar-dropdown#startCloseTimer">
              <div class="px-4 py-3 border-b border-bunker-700">
                <p class="text-xs text-bunker-400"><%= t('.signed_in_as') %></p>
                <p class="text-sm font-medium text-white truncate"><%= current_user.email %></p>
              </div>
              <%= navbar_dropdown_item_to(t('.edit_profile_link'), edit_user_registration_path) %>
              <div class="border-t border-bunker-700 mt-1 pt-1">
                <%= button_to destroy_user_session_path,
                      method: :delete,
                      class: "navbar-dropdown-item w-full text-left text-red-400 hover:text-red-300 hover:bg-red-500/10" do %>
                  <%= t('.sign_out_link') %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Botón hamburguesa (mobile) -->
        <div class="md:hidden">
          <button type="button"
                  class="bg-bunker-800 p-2 rounded-lg text-bunker-300 hover:text-white hover:bg-bunker-700 transition-colors focus:outline-none focus:ring-2 focus:ring-purple-500"
                  data-action="click->navbar-mobile#toggle"
                  aria-label="<%= t('.open_mobile_menu_label') %>">
            <svg data-navbar-mobile-target="hamburger" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg data-navbar-mobile-target="close" class="hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div data-navbar-mobile-target="menu" class="hidden md:hidden border-t border-bunker-800 bg-bunker-950/95 backdrop-blur-lg">
    <div class="px-4 pt-3 pb-4 space-y-1">

      <!-- Dashboard -->
      <%= navbar_link_to(t('.dashboard_link'), root_path) %>

      <!-- Grupo: Transacciones -->
      <div data-controller="navbar-dropdown" class="rounded-md overflow-hidden">
        <button type="button"
                class="navbar-dropdown-trigger w-full justify-between"
                data-navbar-dropdown-target="button"
                data-action="click->navbar-dropdown#toggle"
                aria-haspopup="true"
                aria-expanded="false">
          <%= t('.transactions_dropdown') %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hidden bg-bunker-900/50 rounded-b-md" data-navbar-dropdown-target="dropdown">
          <div class="pl-4 py-1 space-y-1">
            <%= navbar_dropdown_item_to(t('.all_transactions'), transactions_path) %>
            <%= navbar_dropdown_item_to(t('.financial_calendar'), calendar_index_path) %>
          </div>
        </div>
      </div>

      <!-- Grupo: Planificación -->
      <div data-controller="navbar-dropdown" class="rounded-md overflow-hidden">
        <button type="button"
                class="navbar-dropdown-trigger w-full justify-between"
                data-navbar-dropdown-target="button"
                data-action="click->navbar-dropdown#toggle"
                aria-haspopup="true"
                aria-expanded="false">
          <%= t('.planning_dropdown') %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hidden bg-bunker-900/50 rounded-b-md" data-navbar-dropdown-target="dropdown">
          <div class="pl-4 py-1 space-y-1">
            <%= navbar_dropdown_item_to(t('.budgets_link'), budgets_path) %>
            <%= navbar_dropdown_item_to(t('.reminders_link'), obligatory_payments_path) %>
            <%= navbar_dropdown_item_to(t('.reminders_calendar_link'), obligatory_payments_calendar_index_path) %>
            <%= navbar_dropdown_item_to(t('.saving_goals_link'), saving_goals_path) %>
          </div>
        </div>
      </div>

      <!-- Reportes -->
      <%= navbar_link_to(t('.reports_link'), reports_path) %>

      <!-- Grupo: Administración -->
      <div data-controller="navbar-dropdown" class="rounded-md overflow-hidden">
        <button type="button"
                class="navbar-dropdown-trigger w-full justify-between"
                data-navbar-dropdown-target="button"
                data-action="click->navbar-dropdown#toggle"
                aria-haspopup="true"
                aria-expanded="false">
          <%= t('.administration_dropdown') %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hidden bg-bunker-900/50 rounded-b-md" data-navbar-dropdown-target="dropdown">
          <div class="pl-4 py-1 space-y-1">
            <%= navbar_dropdown_item_to(t('.employment_profile_link'), current_user&.employment_information ? employment_information_path : new_employment_information_path) %>
            <%= navbar_dropdown_item_to(t('.payroll_link'), edit_payroll_profile_path) %>
          </div>
        </div>
      </div>

      <!-- Usuario (mobile) -->
      <% if user_signed_in? %>
        <div class="border-t border-bunker-700 pt-3 mt-2">
          <div class="flex items-center px-3 mb-2">
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-purple-700 flex items-center justify-center text-white font-bold text-sm mr-3">
              <%= current_user.email.first.upcase %>
            </div>
            <p class="text-sm text-bunker-300 truncate"><%= current_user.email %></p>
          </div>
          <%= navbar_dropdown_item_to(t('.edit_profile_link'), edit_user_registration_path) %>
          <%= button_to destroy_user_session_path,
                method: :delete,
                class: "navbar-dropdown-item w-full text-left text-red-400 hover:text-red-300 hover:bg-red-500/10" do %>
            <%= t('.sign_out_link') %>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>

</nav>
<!-- End Navbar -->
