<div data-controller="chatbot-bubble" data-chatbot-bubble-url-value="<%= widget_conversations_path %>"
     class="fixed bottom-6 right-6 z-50">
  <div data-chatbot-bubble-target="panel"
       class="hidden mb-3 w-[26rem] max-w-[calc(100vw-2rem)] h-[32rem] max-h-[calc(100vh-6rem)] bg-bunker-950 border border-bunker-800 rounded-xl shadow-2xl overflow-hidden">
    <%= turbo_frame_tag 'chatbot_bubble_frame', data: { chatbot_bubble_target: 'frame' } do %>
      <div class="flex items-center justify-center h-full text-bunker-400 text-sm">Cargando…</div>
    <% end %>
  </div>

  <button type="button" data-action="chatbot-bubble#toggle" aria-label="Asesor financiero"
          class="w-14 h-14 rounded-full bg-purple-600 hover:bg-purple-500 text-white shadow-lg flex items-center justify-center text-2xl transition-colors ml-auto">
    💬
  </button>
</div>
