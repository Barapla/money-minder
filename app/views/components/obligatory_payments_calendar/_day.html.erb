<%
    date = component.date
    has_payments = component.has_payments
    has_payroll = component.has_payroll
    objects = component.objects
    payroll_reminders = component.payroll_reminders
    day_total = component.day_total
    payment_count = component.payment_count
    is_today = date == Date.today
%>

<%= link_to day_details_obligatory_payments_calendar_index_path(date:),
                    class: "h-40 p-2 border border-bunker-800/30 rounded-lg cursor-pointer transition-all duration-200 hover:bg-bunker-800/40 #{is_today ? 'bg-orange-500/20 border-orange-500/30' : 'bg-bunker-800/20'}",
                    data: {
                        turbo_frame: "day_details_payments"
                    } do %>
    <div class="flex justify-between items-start mb-2">
        <span class="text-sm font-medium <%= is_today ? 'text-orange-300' : 'text-white' %>"><%= date.day %></span>
        <div class="flex gap-1">
            <%= has_payments ? '<div class="w-2 h-2 bg-orange-400 rounded-full"></div>'.html_safe : '' %>
            <%= has_payroll ? '<div class="w-2 h-2 bg-amber-400 rounded-full" title="Quincena"></div>'.html_safe : '' %>
        </div>
    </div>
    <div class="space-y-1">
        <% if has_payments %>
            <div class="text-xs font-medium text-orange-300">
                $<%= day_total.round(2) %>
            </div>
            <div class="text-xs text-bunker-400">
                <%= payment_count %> pago<%= payment_count != 1 ? 's' : '' %>
            </div>
            <% objects.slice(0,2).each do |payment| %>
                <div class="text-xs px-2 py-1 rounded
                <%= payment.color.code == 'emerald' ? 'bg-emerald-500/20 text-emerald-300' :
                    payment.color.code == 'red' ? 'bg-red-500/20 text-red-300' :
                    payment.color.code == 'yellow' ? 'bg-yellow-500/20 text-yellow-300' :
                    payment.color.code == 'blue' ? 'bg-blue-500/20 text-blue-300' :
                    payment.color.code == 'orange' ? 'bg-orange-500/20 text-orange-300' : 'bg-pink-500/20 text-pink-300'%>
                    truncate flex items-center gap-1">
                    <span><%= payment.icon.value %></span>
                    <span class="truncate"><%= payment.name %></span>
                </div>
            <% end %>
            <% if payment_count > 2 %>
                <div class="text-xs text-bunker-400">+<%= payment_count - 2 %> más</div>
            <% end %>
        <% end %>
        <% payroll_reminders.first(1).each do |reminder| %>
            <div class="text-xs px-2 py-1 rounded bg-amber-500/20 text-amber-300 truncate flex items-center gap-1">
                <span>💰</span>
                <span class="truncate"><%= reminder.periodicity_label %></span>
            </div>
        <% end %>
    </div>
<% end %>
