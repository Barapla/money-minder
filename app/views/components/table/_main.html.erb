<%
    id = component.id
    url = component.url
    title = component.title
    headers = component.headers
    values = component.values || []
    per_page = 10
    current_page = 1
    total_collections = component.total_collections
    total_pages = component.total_pages(per_page, total_collections)
    pagination_pages = component.pagination_pages(current_page, total_pages)
%>

<!-- Table Container -->
<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl overflow-hidden" data-controller="datatable-filters" data-datatable-filters-url-value="<%= url %>" data-datatable-filters-id-value="<%= id %>">
    <!-- Table Header -->
    <div class="px-6 py-4 border-b border-bunker-800/50">
        <h2 class="text-xl font-semibold text-white flex items-center gap-2">
            <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <%= title %>
        </h2>
    </div>

    
    <%= turbo_frame_tag "table-#{id}" do %>  
        <!-- Table -->
        <%= render partial: 'components/table/main/table', locals: { id:, headers:, values:, per_page:, current_page:, total_collections:, total_pages:, pagination_pages: } %>
    <% end %>
</div>
<!-- End of Table Container -->