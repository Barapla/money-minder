<%
    item = component.item
%>
<% case item[:type] %>
<% when 'icon' %>
    <td class="px-6 py-4 whitespace-nowrap">
        <div class="flex items-center">
            <div class="w-10 h-10 bg-<%= item[:color] %> rounded-lg flex items-center justify-center mr-3">
                <span class="text-lg"><%= item[:icon] %></span>
            </div>
            <div>
                <div class="text-sm font-medium text-white"><%= item[:main_text] %></div>
                <div class="text-sm text-bunker-400"><%= item[:sub_text] %></div>
            </div>
        </div>
    </td>
<% when "progress_bar" %>
    <td class="px-6 py-4 whitespace-nowrap">
        <div class="flex items-center">
            <div class="w-16 bg-bunker-700 rounded-full h-2 mr-2">
                <div class="<%= color_bg_class(item[:div_color]) %> h-2 rounded-full" style="width: <%= item[:value] %>%"></div>
            </div>
            <span class="text-sm text-white"><%= item[:value] %>%</span>
        </div>
    </td>
<% when "status" %>
    <td class="px-6 py-4 whitespace-nowrap">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= color_bg_class(item[:color], 40) %> <%= color_text_class(item[:color], 400) %>">
            <%= item[:value] %>
        </span>
    </td>
<% when "actions" %>
    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
        <div class="flex gap-2">
            <a href="#" class="text-bunker-400 hover:text-white transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
            </a>
            <a href="#" class="text-bunker-400 hover:text-purple-400 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
            </a>
            <a href="#" class="text-bunker-400 hover:text-red-400 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
            </a>
        </div>
    </td>
<% else %>
    <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm font-semibold <%= color_text_class(item[:div_color]) %>"><%= item[:value] %></div>
    </td>
<% end %>