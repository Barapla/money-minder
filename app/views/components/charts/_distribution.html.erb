<%
    id = component.id
    title = component.title || "Distribución"
    url = component.url
    datasets = component.datasets
    options = component.options || {}
%>

<!-- Category Distribution -->
<div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-6"
    id="charts--distribution-controller" 
    data-controller="charts--distribution" 
    data-charts--distribution-id-value="<%= id %>" 
    data-charts--distribution-datasets-value="<%= datasets.to_json %>" 
    data-charts--distribution-url-value="<%= url %>"
    data-charts--distribution-extra-filters-value="<%= options.to_json %>"
    data-charts--distribution-charts--main-outlet="[data-controller~='charts--main']">
    <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-semibold text-white flex items-center gap-2">
            <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path>
            </svg>
            <%= title %>
        </h3>
    </div>
    <div class="h-80">
        <canvas id="<%= id %>" data-charts--distribution-target="canvas"></canvas>
    </div>
</div>