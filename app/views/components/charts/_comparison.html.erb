
<%
    id = component.id
    title = component.title || "Comparación"
    url = component.url
    datasets = component.datasets
    options = component.options || {}
%>

<!-- Budget Comparison Chart -->
<div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-6"
    id="charts--comparison-controller" 
    data-controller="charts--comparison" 
    data-charts--comparison-id-value="<%= id %>" 
    data-charts--comparison-datasets-value="<%= datasets.to_json %>" 
    data-charts--comparison-url-value="<%= url %>"
    data-charts--comparison-charts--main-outlet="[data-controller~='charts--main']">
    <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-semibold text-white flex items-center gap-2">
            <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <%= title %>
        </h3>
    </div>
    <div class="h-96">
        <canvas id="<%= id %>" data-charts--comparison-target="canvas"></canvas>
    </div>
</div>