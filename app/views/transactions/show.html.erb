<div class="max-w-5xl mx-auto">
    <!-- Header -->
    <%= render "transactions/shows/shared/header" %>

    <!-- Transaction Amount Card -->
    <%= render "transactions/shows/shared/amount_card" %>

    <!-- Main Content -->
    <div class="grid lg:grid-cols-3 gap-8">
        <!-- Transaction Details -->
        <div class="lg:col-span-2 space-y-8">
            <!-- Basic Information -->
            <%= render "transactions/shows/shared/details" %>
            

            <!-- Impact Analysis -->
            <%= render "transactions/shows/#{@transaction.transaction_type.code}/impact" %>
            

            <!-- Related Transactions (if transfer) -->
            <%= render "transactions/shows/shared/related_transactions" %>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- Quick Actions -->
            <%= render "transactions/shows/shared/quick_actions" %>
            

            <!-- Transaction Metadata -->
            <%= render "transactions/shows/shared/metadata" %>

            <!-- Category Analysis -->
            <%= render "transactions/shows/shared/category_analysis" %>
        </div>
    </div>
</div>