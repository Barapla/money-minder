<% p = @show_presenter %>
<div class="max-w-6xl mx-auto">
  <%= render 'transactions/shows/shared/hero' %>

  <div class="grid gap-5 items-start [grid-template-columns:repeat(auto-fit,minmax(320px,1fr))]">
    <div class="flex flex-col gap-5 min-w-0">
      <% if p.impact? %>
        <%= render 'transactions/shows/shared/impact' %>
      <% end %>
      <% if p.cycle %>
        <%= render 'transactions/shows/shared/cycle' %>
      <% end %>
      <%= render 'transactions/shows/shared/details' %>
    </div>

    <div class="flex flex-col gap-5 min-w-0">
      <% if p.debt_allocations.any? %>
        <%= render 'transactions/shows/shared/debts' %>
      <% end %>
      <%= render 'transactions/shows/shared/category_analysis' %>
      <% if p.recurring? %>
        <%= render 'transactions/shows/shared/recurrence' %>
      <% end %>
      <% if p.related_transactions.any? %>
        <%= render 'transactions/shows/shared/related' %>
      <% end %>
      <%= render 'transactions/shows/shared/metadata' %>
    </div>
  </div>
</div>
