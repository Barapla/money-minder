<%= fields_for "transaction", transaction do |form| %>
    <%= render Forms::SelectComponent.new(
                    name: :related_budget_id,
                    form:,
                    options_collection: (@budgets || []).reject { |b| b.id == transaction.budget_id }.pluck(:name, :id),
                    options: { 
                        help_text: "¿A qué presupuesto entra el dinero?",
                        required: true,
                        disabled: transaction.persisted?,
                        selected: transaction.related_budget_id,
                    }
                ) %>
<% end %>