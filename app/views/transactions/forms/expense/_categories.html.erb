<%= fields_for "transaction", transaction do |form| %>
    <%= render Forms::SelectComponent.new(
        name: :category_id,
        form:,
        options_collection: Category.exclude_categories_by_parent(["Ingresos", "Transferencias"]).children_pluck,
        options: { 
            help_text: "Selecciona la categoría de la transacción",
            required: true,
            selected: transaction.category_id,
            data: {
                "budgets--preview-target": "budgetType",
                action: "change->budgets--preview#updatePreview"
            }
        }
    ) %>
<% end %>