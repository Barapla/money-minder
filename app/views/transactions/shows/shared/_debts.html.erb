<% p = @show_presenter %>
<div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl px-6 py-[22px]">
  <h3 class="text-[15px] font-semibold text-white mb-1"><%= t('.title') %></h3>
  <p class="text-bunker-400 text-[12.5px] mb-[18px]"><%= t('.subtitle', count: p.debt_allocations.size) %></p>

  <div class="flex flex-col gap-2.5">
    <% p.debt_allocations.each do |allocation| %>
      <%= link_to debt_path(allocation.debt),
            class: "flex items-center gap-3.5 bg-bunker-950/40 border border-bunker-700/50 rounded-xl px-4 py-3.5 hover:border-purple-500/40 transition-colors" do %>
        <span class="w-9 h-9 shrink-0 rounded-[10px] flex items-center justify-center text-base <%= color_bg_class(allocation.debt.color&.code, 40) %>">
          <%= allocation.debt.icon&.value || '🤝' %>
        </span>
        <span class="flex-1 min-w-0">
          <span class="block text-white text-[13.5px] font-semibold line-clamp-1"><%= allocation.debt.name %></span>
          <span class="block text-bunker-400 text-[11.5px]">
            <%= t('.remaining_after', amount: p.format_currency(allocation.debt.remaining_amount)) %>
          </span>
        </span>
        <span class="font-mono text-[15px] font-bold text-emerald-400 shrink-0"><%= p.format_currency(allocation.amount) %></span>
      <% end %>
    <% end %>
  </div>

  <%# Solo se aclara cuando lo aplicado no cuadra con el movimiento. %>
  <% if p.unallocated_total.abs > 0.001 %>
    <p class="mt-3.5 pt-3.5 border-t border-bunker-700 text-[11.5px] <%= p.unallocated_total.negative? ? 'text-amber-300' : 'text-bunker-400' %>">
      <%= p.unallocated_total.positive? ? t('.unallocated', amount: p.format_currency(p.unallocated_total)) : t('.overallocated', amount: p.format_currency(p.unallocated_total.abs)) %>
    </p>
  <% end %>
</div>
