<% p = @show_presenter %>
<% shades = ['bg-orange-400', 'bg-orange-400/50', 'bg-orange-400/25'] %>
<div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl px-6 py-[22px]">
  <h3 class="text-[15px] font-semibold text-white mb-1"><%= p.category&.name %></h3>
  <p class="text-bunker-400 text-xs mb-[18px]"><%= t('.subtitle', month: p.month_label.to_s.downcase) %></p>

  <div class="font-mono text-[28px] font-bold text-orange-400 mb-1.5"><%= p.format_currency(p.category_total) %></div>
  <p class="text-bunker-300 text-[12.5px] mb-[18px]">
    <%= t('.share_html', percent: tag.strong("#{p.category_share}%", class: 'text-white')) %>
  </p>

  <div class="flex h-2.5 rounded-full overflow-hidden bg-bunker-950/70 mb-3.5">
    <% p.category_top.each_with_index do |item, index| %>
      <div class="<%= shades[index] %>" style="width: <%= p.share_of_category(item) %>%"></div>
    <% end %>
  </div>

  <div class="flex flex-col gap-2.5 text-[12.5px]">
    <% p.category_top.each_with_index do |item, index| %>
      <% current = item.id == p.transaction.id %>
      <%= link_to transaction_path(item), class: "flex items-center justify-between gap-3 hover:text-white transition-colors" do %>
        <span class="flex items-center gap-2 min-w-0 <%= current ? 'text-white' : 'text-bunker-300' %>">
          <span class="w-2 h-2 shrink-0 rounded-sm <%= shades[index] %>"></span>
          <span class="line-clamp-1"><%= item.description.presence || item.category&.name %></span>
        </span>
        <span class="font-mono shrink-0 <%= current ? 'text-white font-semibold' : 'text-bunker-200' %>">
          <%= p.format_currency(item.amount) %>
        </span>
      <% end %>
    <% end %>
  </div>

  <div class="mt-4 pt-3.5 border-t border-bunker-700 flex justify-between gap-3 text-[12.5px]">
    <span class="text-bunker-300"><%= t('.average') %></span>
    <span class="font-mono text-white font-semibold"><%= p.format_currency(p.category_average) %></span>
  </div>
  <p class="text-bunker-400 text-[11.5px] mt-1.5">
    <%= p.versus_average.zero? ? t('.on_average') : t('.versus_average', percent: p.versus_average.abs,
                                                                        direction: t(p.versus_average.positive? ? '.above' : '.below')) %>
  </p>
</div>
