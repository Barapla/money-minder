<% p = @show_presenter %>
<div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl px-6 py-[22px]">
  <h3 class="text-[15px] font-semibold text-white mb-1"><%= t('.title') %></h3>
  <p class="text-bunker-400 text-[12.5px] mb-[18px]"><%= t('.subtitle') %></p>

  <div class="flex flex-col gap-2.5">
    <% p.related_transactions.each do |item| %>
      <% tint = transaction_type_tint(item.transaction_type&.code) %>
      <%= link_to transaction_path(item),
            class: "flex items-center gap-3.5 bg-bunker-950/40 border border-bunker-700/50 rounded-xl px-4 py-3.5 hover:border-purple-500/40 transition-colors" do %>
        <span class="w-9 h-9 shrink-0 rounded-[10px] flex items-center justify-center text-base <%= color_bg_class(item.color&.code, 40) %>">
          <%= item.icon&.value %>
        </span>
        <span class="flex-1 min-w-0">
          <span class="block text-white text-[13.5px] font-semibold line-clamp-1">
            <%= item.description.presence || item.category&.name %>
          </span>
          <span class="block text-bunker-400 text-[11.5px] line-clamp-1"><%= transaction_meta(item) %></span>
        </span>
        <span class="text-right shrink-0">
          <span class="block font-mono text-[15px] font-bold <%= tint[:amount] %>">
            <%= p.format_signed(item.negative_transaction? ? -item.amount.to_f : item.amount.to_f) %>
          </span>
          <span class="block text-bunker-400 text-[11px]"><%= item.transaction_type&.value %></span>
        </span>
      <% end %>
    <% end %>
  </div>

  <div class="mt-3.5 pt-3.5 border-t border-bunker-700 flex justify-between flex-wrap gap-3 text-[12.5px]">
    <span class="text-bunker-300"><%= t('.total_label', count: p.related_transactions.size + 1) %></span>
    <span class="font-mono text-white font-bold"><%= p.format_currency(p.related_total) %></span>
  </div>
</div>
