<% recurring_transaction_presenter = RecurringTransactionPresenter.new(recurring_transaction) %>
<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
    <h2 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
        <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
        </svg>
        Configuración de Recurrencia
    </h2>

    <div class="grid md:grid-cols-2 gap-6">
        <div class="space-y-4">
            <div class="bg-bunker-800/30 rounded-xl p-4">
                <div class="text-bunker-300 text-sm mb-1">Frecuencia</div>
                <div class="flex items-center gap-2">
                    <span class="text-lg">🔄</span>
                    <span class="text-white font-medium capitalize"><%= recurring_transaction_presenter.frequency %></span>
                </div>
            </div>
            
            <div class="bg-bunker-800/30 rounded-xl p-4">
                <div class="text-bunker-300 text-sm mb-1">Fecha de Inicio</div>
                <div class="text-white font-medium"><%= recurring_transaction.start_date.strftime("%d/%m/%Y") %></div>
            </div>

            <div class="bg-bunker-800/30 rounded-xl p-4">
                <div class="text-bunker-300 text-sm mb-1">Próxima Ejecución</div>
                <div class="text-emerald-400 font-medium"><%= recurring_transaction.next_execution_date.strftime("%d/%m/%Y") %></div>
                <div class="text-bunker-400 text-xs mt-1">
                    <%= time_ago_in_words(recurring_transaction.next_execution_date) %> 
                    <%= recurring_transaction.next_execution_date.future? ? "from now" : "ago" %>
                </div>
            </div>
        </div>

        <div class="space-y-4">
            <div class="bg-bunker-800/30 rounded-xl p-4">
                <div class="text-bunker-300 text-sm mb-1">Estado</div>
                <% if recurring_transaction.active? %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-400">
                        ✓ Activa
                    </span>
                <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-500/20 text-red-400">
                        ✕ Inactiva
                    </span>
                <% end %>
            </div>

            <div class="bg-bunker-800/30 rounded-xl p-4">
                <div class="text-bunker-300 text-sm mb-1">Aprobación Automática</div>
                <% if recurring_transaction.auto_approve? %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-500/20 text-blue-400">
                        🤖 Automática
                    </span>
                <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-500/20 text-yellow-400">
                        👤 Manual
                    </span>
                <% end %>
            </div>

            <div class="bg-bunker-800/30 rounded-xl p-4">
                <div class="text-bunker-300 text-sm mb-1">Fecha de Fin</div>
                <% if recurring_transaction.end_date.present? %>
                    <div class="text-white font-medium"><%= recurring_transaction.end_date.strftime("%d/%m/%Y") %></div>
                <% else %>
                    <div class="text-bunker-400 italic">Sin fecha límite</div>
                <% end %>
            </div>
        </div>
    </div>
</div>