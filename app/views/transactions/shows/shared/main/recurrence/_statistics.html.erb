<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
    <h2 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
        <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
        Estadísticas de Ejecución
    </h2>

    <div class="grid md:grid-cols-3 gap-4 mb-6">
        <div class="bg-bunker-800/30 rounded-xl p-4 text-center">
            <div class="text-bunker-300 text-sm mb-1">Ejecutadas</div>
            <div class="text-emerald-400 text-xl font-semibold"><%= recurring_transaction.execution_count %></div>
        </div>
        <div class="bg-bunker-800/30 rounded-xl p-4 text-center">
            <div class="text-bunker-300 text-sm mb-1">Máximo</div>
            <% if recurring_transaction.max_executions.present? %>
                <div class="text-purple-400 text-xl font-semibold"><%= recurring_transaction.max_executions %></div>
            <% else %>
                <div class="text-bunker-400 text-xl font-semibold">∞</div>
            <% end %>
        </div>
        <div class="bg-bunker-800/30 rounded-xl p-4 text-center">
            <div class="text-bunker-300 text-sm mb-1">Restantes</div>
            <% if recurring_transaction.max_executions.present? %>
                <div class="text-yellow-400 text-xl font-semibold">
                    <%= [recurring_transaction.max_executions - recurring_transaction.execution_count, 0].max %>
                </div>
            <% else %>
                <div class="text-bunker-400 text-xl font-semibold">∞</div>
            <% end %>
        </div>
    </div>

    <!-- Progress Bar solo si hay límite de ejecuciones -->
    <% if recurring_transaction.max_executions.present? %>
        <div class="bg-bunker-800/30 rounded-xl p-4">
            <div class="flex justify-between items-center mb-2">
                <span class="text-bunker-300 text-sm">Progreso de ejecuciones</span>
                <span class="text-white font-medium">
                    <%= ((recurring_transaction.execution_count.to_f / recurring_transaction.max_executions) * 100).round(1) %>%
                </span>
            </div>
            <div class="bg-bunker-700 rounded-full h-3 mb-2">
                <div class="bg-gradient-to-r from-emerald-500 to-purple-500 h-3 rounded-full transition-all duration-500" 
                     style="width: <%= ((recurring_transaction.execution_count.to_f / recurring_transaction.max_executions) * 100).round(1) %>%">
                </div>
            </div>
            <div class="flex justify-between text-xs text-bunker-400">
                <span>0</span>
                <span><%= recurring_transaction.max_executions / 2 %></span>
                <span><%= recurring_transaction.max_executions %></span>
            </div>
        </div>
    <% end %>
</div>