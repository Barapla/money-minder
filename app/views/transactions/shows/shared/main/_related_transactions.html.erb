<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
    <h2 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
        <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
        </svg>
        Transacciones Relacionadas
    </h2>

    <% if @transaction.related_transaction.present? %>
        <%  transaction = @transaction.related_transaction 
            transaction_presenter = TransactionPresenter.new(transaction) %>
        <!-- Example for transfer transactions -->
        <div class="space-y-3">
            <%= link_to transaction, data: { turbo: false }, class: "flex items-center justify-between p-4 bg-bunker-800/30 rounded-xl hover:bg-bunker-700/30 transition-colors duration-200" do %>
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-<%= transaction_presenter.color %> rounded-lg flex items-center justify-center">
                        <span class="text-lg"><%= transaction_presenter.icon %></span>
                    </div>
                    <div>
                        <div class="text-white font-medium"><%= transaction_presenter.description %></div>
                        <div class="text-bunker-400 text-sm"><%= time_ago_in_words(transaction.transaction_date) %></div>
                    </div>
                </div>
                <div class="text-right">
                    <div class="font-semibold <%= transaction_text_color_class(transaction.transaction_type.code) %>"><%= transaction_presenter.amount %></div>
                    <div class="text-bunker-400 text-sm"><%= transaction_presenter.transaction_type %></div>
                </div>
            <% end %>
        </div>
    <% else %>
        <div class="bg-bunker-800/30 rounded-xl p-4 text-center">
            <svg class="w-12 h-12 text-bunker-500 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
            </svg>
            <div class="text-bunker-400 text-sm">Esta transacción no tiene relaciones con otras transacciones</div>
        </div>
    <% end %>
</div>