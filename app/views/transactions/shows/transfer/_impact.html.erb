<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
    <h2 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
        <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
        Impacto en el Presupuesto
    </h2>

    <div class="grid md:grid-cols-3 gap-4 mb-6">
        <div class="bg-bunker-800/30 rounded-xl p-4 text-center">
            <div class="text-bunker-300 text-sm mb-1">Saldo Anterior</div>
            <div class="text-emerald-400 text-xl font-semibold"><%= @transaction_presenter.preview_amount %></div>
        </div>
        <div class="bg-bunker-800/30 rounded-xl p-4 text-center">
            <div class="text-bunker-300 text-sm mb-1">Esta Transacción</div>
            <div class="text-red-400 text-xl font-semibold">-<%= @transaction_presenter.amount %></div>
        </div>
        <div class="bg-bunker-800/30 rounded-xl p-4 text-center">
            <div class="text-bunker-300 text-sm mb-1">Saldo Posterior</div>
            <div class="text-white text-xl font-semibold"><%= @transaction_presenter.post_amount %></div>
        </div>
    </div>

    <!-- Progress Bar -->
    <div class="bg-bunker-800/30 rounded-xl p-4">
        <div class="flex justify-between items-center mb-2">
            <span class="text-bunker-300 text-sm">Utilización del presupuesto</span>
            <span class="text-white font-medium"><%= @transaction_presenter.used_percentage %></span>
        </div>
        <div class="bg-bunker-700 rounded-full h-3 mb-2">
            <div class="bg-gradient-to-r from-emerald-500 to-yellow-500 h-3 rounded-full transition-all duration-500" style="width: <%= @transaction_presenter.used_percentage %>"></div>
        </div>
        <div class="flex justify-between text-xs text-bunker-400">
            <span>$0</span>
            <span><%= number_to_currency(@transaction.pre_amount / 2, unit: '$') %></span>
            <span><%= @transaction_presenter.preview_amount %></span>
        </div>
    </div>
</div>