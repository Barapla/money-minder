<% p = @index_presenter %>
<div class="max-w-7xl mx-auto">
  <div class="flex items-end justify-between flex-wrap gap-4 mb-5">
    <div>
      <h1 class="text-[26px] font-bold text-white leading-tight"><%= t('.title') %></h1>
      <p class="text-bunker-400 text-[13px] mt-1">
        <%= t('.headline', count: p.total_count, range: p.range_label, month: p.month_label) %>
      </p>
    </div>
    <%= link_to t('.new_button'), new_transaction_path,
          class: "bg-gradient-to-r from-purple-500 to-purple-600 text-white px-4 py-2.5 rounded-[10px] text-[13px] font-semibold hover:from-purple-400 hover:to-purple-500 transition-colors" %>
  </div>

  <%= render 'index_summary' %>
  <%= render 'index_filters' %>

  <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl overflow-hidden">
    <% if p.any? %>
      <% p.days.each do |date, transactions| %>
        <%= render 'day_group', date: date, transactions: transactions %>
      <% end %>

      <div class="flex items-center justify-between flex-wrap gap-4 px-6 py-3.5 bg-bunker-950/40 border-t border-bunker-700">
        <span class="text-bunker-400 text-[12.5px]">
          <%= t('.showing_html', range: tag.strong(p.showing_label, class: 'text-bunker-200 font-semibold'),
                                 count: p.filtered_count, month: p.month_label) %>
        </span>

        <div class="flex items-center flex-wrap gap-4">
          <div class="flex items-center gap-2 text-bunker-400 text-[12.5px] whitespace-nowrap">
            <%= t('.per_page') %>
            <% TransactionsIndexPresenter::PER_PAGE_OPTIONS.each do |size| %>
              <% active = p.per_page == size %>
              <%= link_to size, transactions_path(request.query_parameters.merge(per_page: size, page: nil)),
                    class: "flex items-center justify-center min-w-[32px] h-[30px] rounded-lg border font-semibold transition-colors #{active ? 'bg-purple-500/20 border-purple-500/45 text-purple-300' : 'bg-bunker-950/55 border-bunker-700/60 text-bunker-200 hover:border-bunker-600'}" %>
            <% end %>
          </div>

          <% if p.page_count > 1 %>
            <nav class="flex items-center gap-1.5" aria-label="<%= t('.pagination') %>">
              <% if p.first_page? %>
                <span class="flex items-center justify-center min-w-[34px] h-[34px] rounded-[9px] border border-bunker-700/35 text-bunker-600 text-[13px]" aria-hidden="true">‹</span>
              <% else %>
                <%= link_to '‹', transactions_path(request.query_parameters.merge(page: p.page - 1)),
                      "aria-label": t('.previous_page'),
                      class: "flex items-center justify-center min-w-[34px] h-[34px] rounded-[9px] border border-bunker-700/60 text-bunker-200 text-[13px] hover:border-purple-500/50 hover:text-purple-300 transition-colors" %>
              <% end %>

              <% p.pages.each do |number| %>
                <% active = number == p.page %>
                <%= link_to number, transactions_path(request.query_parameters.merge(page: number)),
                      "aria-current": ("page" if active),
                      class: "flex items-center justify-center min-w-[34px] h-[34px] rounded-[9px] border text-[13px] transition-colors #{active ? 'bg-purple-500/20 border-purple-500/45 text-purple-300 font-bold' : 'border-bunker-700/60 text-bunker-200 font-medium hover:border-purple-500/50 hover:text-purple-300'}" %>
              <% end %>

              <% if p.last_page? %>
                <span class="flex items-center justify-center min-w-[34px] h-[34px] rounded-[9px] border border-bunker-700/35 text-bunker-600 text-[13px]" aria-hidden="true">›</span>
              <% else %>
                <%= link_to '›', transactions_path(request.query_parameters.merge(page: p.page + 1)),
                      "aria-label": t('.next_page'),
                      class: "flex items-center justify-center min-w-[34px] h-[34px] rounded-[9px] border border-bunker-700/60 text-bunker-200 text-[13px] hover:border-purple-500/50 hover:text-purple-300 transition-colors" %>
              <% end %>
            </nav>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="px-6 py-14 text-center">
        <h3 class="text-bunker-200 text-[15px] font-medium mb-1">
          <%= p.filtered? ? t('.no_matches') : t('.empty.title') %>
        </h3>
        <p class="text-bunker-400 text-[13px] mb-4">
          <%= p.filtered? ? t('.no_matches_note') : t('.empty.subtitle') %>
        </p>
        <% if p.filtered? %>
          <%= link_to t('.clear_filters'), transactions_path(month: p.month.strftime('%Y-%m')),
                class: "text-purple-300 text-[13px] font-medium hover:text-purple-200" %>
        <% else %>
          <%= link_to t('.empty.cta'), new_transaction_path,
                class: "inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg text-white bg-purple-500 hover:bg-purple-600" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
