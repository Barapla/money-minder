<%
    all_payments = payment_occurrences.values.flatten.uniq
    payments_with_amount = all_payments.select { |payment| payment.amount.present? }
    income_total = payments_with_amount.select(&:income?).sum(&:amount)
    payment_total = payments_with_amount.select(&:payment?).sum(&:amount)
    payroll_total = payroll_reminders.values.flatten.sum(&:net_amount)
    total_amount = income_total + payroll_total - payment_total
    unique_payments = all_payments.count
    days_with_payments = payment_occurrences.keys.count
%>

<div class="grid md:grid-cols-3 gap-6 mt-8">
    <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-6">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 bg-orange-500/20 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <span class="text-xs text-bunker-400 font-medium">TOTAL DEL MES</span>
        </div>
        <div class="text-3xl font-bold <%= total_amount.negative? ? 'text-red-400' : 'text-emerald-400' %> mb-1"><%= number_to_currency(total_amount, unit: "$", precision: 2) %></div>
        <div class="text-sm text-bunker-300">Balance neto del mes</div>
    </div>

    <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-6">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
            </div>
            <span class="text-xs text-bunker-400 font-medium">PAGOS ÚNICOS</span>
        </div>
        <div class="text-3xl font-bold text-blue-400 mb-1"><%= unique_payments %></div>
        <div class="text-sm text-bunker-300">Diferentes obligaciones</div>
    </div>

    <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-6">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 bg-purple-500/20 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
            </div>
            <span class="text-xs text-bunker-400 font-medium">DÍAS CON PAGOS</span>
        </div>
        <div class="text-3xl font-bold text-purple-400 mb-1"><%= days_with_payments %></div>
        <div class="text-sm text-bunker-300">De <%= date.end_of_month.day %> días</div>
    </div>
</div>
