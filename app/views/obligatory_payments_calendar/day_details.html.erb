<%= turbo_frame_tag "day_details_payments" do %>
    <% if params[:date] %>
        <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
            <!-- Panel de Pagos Obligatorios del Día Seleccionado -->
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-semibold text-white flex items-center gap-2">
                    <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v8a2 2 0 002 2h2l8-8-8-8z"></path>
                    </svg>
                    Pagos del <span id="selectedDate"><%= I18n.l(@date, format: '%d de %B') %></span>
                </h3>
                <%= render Buttons::LinkComponent.new(content: '
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    ', href: day_details_obligatory_payments_calendar_index_path,
                    options: {
                        class: "text-bunker-400 hover:text-white",
                        data: {
                            turbo_frame: "day_details_payments"
                        }
                    })
                %>
            </div>

            <!-- Estadísticas del día -->
            <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="bg-bunker-800/40 border border-bunker-700/50 rounded-xl p-4 text-center">
                    <div class="text-2xl font-bold text-orange-400">$<%= @total_amount.round(2) %></div>
                    <div class="text-sm text-bunker-300">Total a Pagar</div>
                </div>
                <div class="bg-bunker-800/40 border border-bunker-700/50 rounded-xl p-4 text-center">
                    <div class="text-lg font-bold text-white"><%= @day_payments.count %></div>
                    <div class="text-sm text-bunker-300">Pagos Programados</div>
                </div>
            </div>

            <% if @payroll_reminders&.any? %>
                <div class="mb-6">
                    <h4 class="text-sm font-semibold text-amber-400 mb-3 flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        Pagos de nómina proyectados
                    </h4>
                    <% @payroll_reminders.each do |reminder| %>
                        <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-4 mb-3">
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-amber-500/20 flex items-center justify-center text-xl">💰</div>
                                    <div>
                                        <h5 class="font-medium text-white"><%= reminder.periodicity_label %></h5>
                                        <p class="text-xs text-bunker-400">Proyectado</p>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="font-bold text-lg text-amber-400">+$<%= number_with_precision(reminder.net_amount, precision: 2, delimiter: ',') %></div>
                                    <div class="text-xs text-bunker-400">Neto estimado</div>
                                </div>
                            </div>
                            <div class="grid grid-cols-2 gap-2 pt-3 border-t border-amber-500/20 text-xs">
                                <div class="text-bunker-300">Salario base: <span class="text-white">$<%= number_with_precision(reminder.calculation_breakdown[:base_salary], precision: 2, delimiter: ',') %></span></div>
                                <div class="text-bunker-300">Bonos no gravados: <span class="text-white">$<%= number_with_precision(reminder.calculation_breakdown[:total_bonuses], precision: 2, delimiter: ',') %></span></div>
                                <div class="text-bunker-300">Fondo de ahorro: <span class="text-red-400">-$<%= number_with_precision(reminder.calculation_breakdown[:savings_fund_employee], precision: 2, delimiter: ',') %></span></div>
                                <div class="text-bunker-300">ISR estimado: <span class="text-red-400">-$<%= number_with_precision(reminder.calculation_breakdown[:isr_estimated], precision: 2, delimiter: ',') %></span></div>
                                <div class="text-bunker-300">IMSS estimado: <span class="text-red-400">-$<%= number_with_precision(reminder.calculation_breakdown[:imss_estimated], precision: 2, delimiter: ',') %></span></div>
                            </div>
                        </div>
                    <% end %>
                </div>
            <% end %>

            <div id="daypayments" class="space-y-4">
                <% if @day_payments.any? %>
                    <% @day_payments.each do |payment| %>
                        <div class="<%= payment.income? ? 'reminder-income' : 'reminder-payment' %> bg-bunker-800/40 border border-bunker-700/50 rounded-xl p-4 flex items-center justify-between hover:bg-bunker-800/60 transition-colors">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl <%= payment.income? ? 'bg-emerald-500/20' : 'bg-red-500/20' %>">
                                    <%= payment.icon.value %>
                                </div>
                                <div>
                                    <h4 class="font-medium text-white"><%= payment.name %></h4>
                                    <p class="text-sm text-bunker-300"><%= payment.category.name %></p>
                                    <% if payment.recurrence %>
                                        <p class="text-xs text-bunker-400">
                                            Frecuencia: <%= payment.recurrence.frequency_type.value %>
                                            <% if payment.recurrence.frequency_value > 1 %>
                                                (cada <%= payment.recurrence.frequency_value %>)
                                            <% end %>
                                        </p>
                                    <% else %>
                                        <p class="text-xs text-bunker-400"><%= t('.one_time_label') %></p>
                                    <% end %>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="font-bold text-lg <%= payment.income? ? 'text-emerald-400' : 'text-orange-400' %>">
                                    <%= payment.amount.present? ? number_to_currency(payment.amount.round(2)) : 'N/A' %>
                                </div>
                                <div class="text-xs text-bunker-400">
                                    <%= ObligatoryPayment.human_attribute_name("reminder_type.#{payment.reminder_type}") %>
                                </div>
                                <% if payment.done? %>
                                    <div class="text-xs text-emerald-400 mt-1"><%= t('.done_label') %></div>
                                <% end %>
                            </div>
                        </div>
                    <% end %>
                <% else %>
                    <% unless @payroll_reminders&.any? %>
                        <div class="text-center py-8 text-bunker-400">
                            <svg class="w-12 h-12 mx-auto mb-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v8a2 2 0 002 2h2l8-8-8-8z"></path>
                            </svg>
                            No hay pagos programados para este día
                        </div>
                    <% end %>
                <% end %>
            </div>
        </div>
    <% end %>
<% end %>
