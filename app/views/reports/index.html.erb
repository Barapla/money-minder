        function updateCategoryChart() {
            const chartType = document.getElementById('categoryChartType').value;
            
            let data, labels, colors;
            if (chartType === 'income') {
                labels = sampleData.categories.income.labels;
                data = sampleData.categories.income.data;
                colors = sampleData.categories.income.colors;
            } else if (chartType === 'expenses') {
                labels = sampleData.categories.expenses.labels;
                data = sampleData.categories.expenses.data;
                colors = sampleData.categories.expenses.colors;
            } else { // all
                labels = ['Ingresos', 'Gastos'];
                const totalIncome = sampleData.categories.income.data.reduce((a, b) => a + b, 0);
                const totalExpenses = sampleData.categories.expenses.data.reduce((a, b) => a + b, 0);
                data = [totalIncome, totalExpenses];
                colors = ['#10b981', '#ef4444'];
            }
            
            categoryChart.data.labels = labels;
            categoryChart.data.datasets[0].data = data;
            categoryChart.data.datasets[0].backgroundColor = colors;
            categoryChart.update();
        }

        // Budget dropdown functions
        function toggleBudgetDropdown() {
            const dropdown = document.getElementById('budgetDropdown');
            dropdown.classList.toggle('hidden');
        }

        function updateBudgetSelection() {
            const checkboxes = document.querySelectorAll('.budget-checkbox');
            const allCheckbox = document.getElementById('budgetAll');
            
            selectedBudgets = [];
            checkboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    selectedBudgets.push(checkbox.value);
                }
            });
            
            // Handle "All" checkbox
            if (allCheckbox.checked) {
                selectedBudgets = ['1', '2', '3', '4'];
                checkboxes.forEach(checkbox => checkbox.checked = true);
            } else if (selectedBudgets.length === 4) {
                allCheckbox.checked = true;
            }
            
            updateBudgetSelectionText();
            updateBudgetChart();
        }

        function updateBudgetSelectionText() {
            const text = document.getElementById('selectedBudgetsText');
            if (selectedBudgets.length === 0) {
                text.textContent = 'Seleccionar presupuestos';
            } else if (selectedBudgets.length === 4) {
                text.textContent = 'Todos los presupuestos';
            } else {
                text.textContent = `${selectedBudgets.length} presupuesto(s) seleccionado(s)`;
            }
        }

        function updateBudgetChart() {
            const metric = document.getElementById('budgetChartMetric').value;
            const selectedBudgetData = sampleData.budgets.filter(budget => 
                selectedBudgets.includes(budget.id.toString())
            );
            
            const labels = selectedBudgetData.map(budget => `${budget.emoji} ${budget.name}`);
            let data1, data2, label1, label2;
            
            switch (metric) {
                case 'utilization':
                    data1 = selectedBudgetData.map(budget => (budget.spent / budget.amount * 100).toFixed(1));
                    budgetComparisonChart.data.datasets = [{
                        label: 'Utilización (%)',
                        data: data1,
                        backgroundColor: 'rgba(139, 92, 246, 0.8)',
                        borderColor: '#8b5cf6',
                        borderWidth: 2
                    }];
                    break;
                case 'spent':
                    data1 = selectedBudgetData.map(budget => budget.spent);
                    budgetComparisonChart.data.datasets = [{
                        label: 'Gastado ($)',
                        data: data1,
                        backgroundColor: 'rgba(239, 68, 68, 0.8)',
                        borderColor: '#ef4444',
                        borderWidth: 2
                    }];
                    break;
                case 'remaining':
                    data1 = selectedBudgetData.map(budget => budget.amount - budget.spent);
                    budgetComparisonChart.data.datasets = [{
                        label: 'Disponible ($)',
                        data: data1,
                        backgroundColor: 'rgba(16, 185, 129, 0.8)',
                        borderColor: '#10b981',
                        borderWidth: 2
                    }];
                    break;
                default: // performance
                    data1 = selectedBudgetData.map(budget => budget.amount);
                    data2 = selectedBudgetData.map(budget => budget.spent);
                    budgetComparisonChart.data.datasets = [{
                        label: 'Presupuesto',
                        data: data1,
                        backgroundColor: 'rgba(139, 92, 246, 0.3)',
                        borderColor: '#8b5cf6',
                        borderWidth: 2
                    }, {
                        label: 'Gastado',
                        data: data2,
                        backgroundColor: 'rgba(239, 68, 68, 0.8)',
                        borderColor: '#ef4444',
                        borderWidth: 2
                    }];
            }
            
            budgetComparisonChart.data.labels = labels;
            budgetComparisonChart.update();
        }

        function updateTrendsChart() {
            // Calculate balance for trends chart
            const balanceData = sampleData.monthlyData.income.map((income, index) => 
                income - sampleData.monthlyData.expenses[index]
            );
            
            trendsChart.data.labels = sampleData.monthlyData.labels.slice(0, 6);
            trendsChart.data.datasets[0].data = balanceData.slice(0, 6);
            trendsChart.update();
        }

        // Quick date filter functions
        function setLastMonth() {
            const endDate = new Date();
            const startDate = new Date();
            startDate.setMonth(startDate.getMonth() - 1);
            
            document.getElementById('startDate').value = startDate.toISOString().split('T')[0];
            document.getElementById('endDate').value = endDate.toISOString().split('T')[0];
            updateCharts();
