<div class="max-w-7xl mx-auto" data-controller="charts--main" data-charts--main-charts--flow-outlet="#charts--flow-controller">
    <!-- Header -->
    <div class="bg-gradient-to-r from-bunker-900/80 to-purple-900/80 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-8 mb-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-4xl font-bold text-white mb-2">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-300">📊 Dashboard de Análisis</span>
                </h1>
                <p class="text-bunker-300">Análisis detallado de tus finanzas personales</p>
            </div>
            <div class="flex gap-3">
                <button onclick="exportData()" class="px-4 py-2 bg-bunker-800/60 hover:bg-bunker-700/60 text-white border border-bunker-700/50 hover:border-bunker-600/50 rounded-xl font-medium transition-all duration-200 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                    Exportar Datos
                </button>
                <button onclick="generateReport()" class="bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white px-6 py-2 rounded-xl font-medium transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                    Generar Reporte
                </button>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6 mb-8">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-white flex items-center gap-2">
                <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.207A1 1 0 013 6.5V4z"></path>
                </svg>
                Filtros de Análisis
            </h2>
            <button onclick="resetFilters()" class="text-bunker-400 hover:text-white text-sm">
                Limpiar filtros
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <%= fields_for "report_filter", ReportFilter.new do |form| %>
                <!-- Date Range -->
                <%= render Forms::InputComponent.new(
                    name: :start_date,
                    form:,
                    type: :date,
                    options: { 
                        placeholder: "Fecha de Inicio",
                        help_text: "Selecciona la fecha de inicio del análisis",
                        size: :small,
                        data: {
                            "charts--main-target": "startDate",
                            action: "change->charts--main#updateAllCharts"
                        }
                    }
                ) %>
                
                <%= render Forms::InputComponent.new(
                    name: :end_date,
                    form:,
                    type: :date,
                    options: { 
                        placeholder: "Fecha de Inicio",
                        help_text: "Selecciona la fecha de inicio del análisis",
                        size: :small,
                        data: {
                            "charts--main-target": "endDate",
                            action: "change->charts--main#updateAllCharts"
                        }
                    }
                ) %>

                <!-- Budget MultiSelection -->  
                <%= render Forms::MultiSelectComponent.new(
                    name: :budgets,
                    form:,
                    options_collection: Budget.all.collect { |b| [b.name, b.id] },
                    options: {
                        placeholder: "Selecciona presupuestos...",
                        size: :small,
                        help_text: "Puedes seleccionar múltiples presupuestos",
                        data: {
                            "charts--main-target": "budgets",
                            action: "change->charts--main#updateAllCharts"
                        }
                    }
                ) %>

                <!-- Transaction Type -->
                <div>
                    <label class="block text-sm font-medium text-bunker-200 mb-2">Tipo de Transacción</label>
                    <select id="transactionType" onchange="updateCharts()"
                            class="w-full px-3 py-2 bg-bunker-800/60 border border-bunker-700/50 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 appearance-none">
                        <option value="all">Todas</option>
                        <option value="income">💰 Ingresos</option>
                        <option value="expense">💸 Gastos</option>
                        <option value="transfer">🔄 Transferencias</option>
                    </select>
                </div>

                <!-- Quick Filters -->
                <div>
                    <label class="block text-sm font-medium text-bunker-200 mb-2">Período Rápido</label>
                    <div class="flex gap-1">
                        <button onclick="setLastMonth()" class="flex-1 px-2 py-1 text-xs bg-bunker-800/60 hover:bg-purple-500/20 text-bunker-300 hover:text-white border border-bunker-700/50 rounded-md transition-colors">
                            1M
                        </button>
                        <button onclick="setLast3Months()" class="flex-1 px-2 py-1 text-xs bg-bunker-800/60 hover:bg-purple-500/20 text-bunker-300 hover:text-white border border-bunker-700/50 rounded-md transition-colors">
                            3M
                        </button>
                        <button onclick="setLast6Months()" class="flex-1 px-2 py-1 text-xs bg-bunker-800/60 hover:bg-purple-500/20 text-bunker-300 hover:text-white border border-bunker-700/50 rounded-md transition-colors">
                            6M
                        </button>
                        <button onclick="setLastYear()" class="flex-1 px-2 py-1 text-xs bg-purple-500 text-white border border-purple-500 rounded-md">
                            1A
                        </button>
                    </div>
                </div>
            <% end %>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-emerald-500/20 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                    </svg>
                </div>
                <span class="text-xs text-bunker-400 font-medium">INGRESOS TOTALES</span>
            </div>
            <div class="text-3xl font-bold text-emerald-400 mb-1" id="totalIncome">$45,280.00</div>
            <div class="text-sm text-bunker-300">+12.5% vs período anterior</div>
        </div>

        <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-red-500/20 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m0 0l7-7m0 0l7 7"></path>
                    </svg>
                </div>
                <span class="text-xs text-bunker-400 font-medium">GASTOS TOTALES</span>
            </div>
            <div class="text-3xl font-bold text-red-400 mb-1" id="totalExpenses">$32,150.00</div>
            <div class="text-sm text-bunker-300">+8.3% vs período anterior</div>
        </div>

        <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-purple-500/20 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                    </svg>
                </div>
                <span class="text-xs text-bunker-400 font-medium">BALANCE NETO</span>
            </div>
            <div class="text-3xl font-bold text-purple-400 mb-1" id="netBalance">$13,130.00</div>
            <div class="text-sm text-bunker-300">+28.9% vs período anterior</div>
        </div>

        <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                </div>
                <span class="text-xs text-bunker-400 font-medium">TRANSACCIONES</span>
            </div>
            <div class="text-3xl font-bold text-blue-400 mb-1" id="totalTransactions">156</div>
            <div class="text-sm text-bunker-300">En el período seleccionado</div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="grid lg:grid-cols-2 gap-8 mb-8">
        <%= render Charts::FlowComponent.new(datasets: @budget_datasets, url: reports_path) %>

        <!-- Category Distribution -->
        <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-semibold text-white flex items-center gap-2">
                    <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path>
                    </svg>
                    Distribución por Categoría
                </h3>
                <select id="categoryChartType" onchange="updateCategoryChart()"
                        class="px-3 py-1 text-sm bg-bunker-800/60 border border-bunker-700/50 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-purple-500 appearance-none">
                    <option value="expenses">Gastos</option>
                    <option value="income">Ingresos</option>
                    <option value="all">Todos</option>
                </select>
            </div>
            <div class="h-80">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Budget Comparison Chart -->
    <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6 mb-8">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-xl font-semibold text-white flex items-center gap-2">
                <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                Comparación de Presupuestos
            </h3>
            <div class="flex items-center gap-4">
                <!-- Budget Multi-Select -->
                <div class="relative">
                    <button onclick="toggleBudgetDropdown()" 
                            class="px-4 py-2 bg-bunker-800/60 border border-bunker-700/50 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 flex items-center gap-2">
                        <span id="selectedBudgetsText">Seleccionar presupuestos</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>
                    
                    <div id="budgetDropdown" 
                            class="hidden absolute top-full right-0 mt-2 w-64 bg-bunker-800/95 backdrop-blur-lg border border-bunker-700/50 rounded-lg shadow-xl z-50">
                        <div class="p-3 space-y-2">
                            <label class="flex items-center gap-2 hover:bg-bunker-700/50 p-2 rounded cursor-pointer">
                                <input type="checkbox" id="budgetAll" onchange="updateBudgetSelection()" class="w-4 h-4 text-purple-500 bg-bunker-700 border-bunker-600 rounded focus:ring-purple-500">
                                <span class="text-white text-sm">Todos los presupuestos</span>
                            </label>
                            <hr class="border-bunker-700">
                            <label class="flex items-center gap-2 hover:bg-bunker-700/50 p-2 rounded cursor-pointer">
                                <input type="checkbox" value="1" onchange="updateBudgetSelection()" class="budget-checkbox w-4 h-4 text-purple-500 bg-bunker-700 border-bunker-600 rounded focus:ring-purple-500" checked>
                                <span class="text-sm">🏠 Gastos del Hogar</span>
                            </label>
                            <label class="flex items-center gap-2 hover:bg-bunker-700/50 p-2 rounded cursor-pointer">
                                <input type="checkbox" value="2" onchange="updateBudgetSelection()" class="budget-checkbox w-4 h-4 text-purple-500 bg-bunker-700 border-bunker-600 rounded focus:ring-purple-500" checked>
                                <span class="text-sm">💳 Tarjeta de Crédito</span>
                            </label>
                            <label class="flex items-center gap-2 hover:bg-bunker-700/50 p-2 rounded cursor-pointer">
                                <input type="checkbox" value="3" onchange="updateBudgetSelection()" class="budget-checkbox w-4 h-4 text-purple-500 bg-bunker-700 border-bunker-600 rounded focus:ring-purple-500">
                                <span class="text-sm">🚗 Transporte</span>
                            </label>
                            <label class="flex items-center gap-2 hover:bg-bunker-700/50 p-2 rounded cursor-pointer">
                                <input type="checkbox" value="4" onchange="updateBudgetSelection()" class="budget-checkbox w-4 h-4 text-purple-500 bg-bunker-700 border-bunker-600 rounded focus:ring-purple-500">
                                <span class="text-sm">💰 Ahorros</span>
                            </label>
                        </div>
                    </div>
                </div>

                <select id="budgetChartMetric" onchange="updateBudgetChart()"
                        class="px-3 py-2 bg-bunker-800/60 border border-bunker-700/50 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 appearance-none">
                    <option value="utilization">Utilización (%)</option>
                    <option value="spent">Gastado ($)</option>
                    <option value="remaining">Disponible ($)</option>
                    <option value="performance">Rendimiento</option>
                </select>
            </div>
        </div>
        <div class="h-96">
            <canvas id="budgetComparisonChart"></canvas>
        </div>
    </div>

    <!-- Trends and Insights -->
    <div class="grid lg:grid-cols-2 gap-8">
        <!-- Monthly Trends -->
        <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
            <h3 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
                <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
                Tendencias Mensuales
            </h3>
            <div class="h-64">
                <canvas id="trendsChart"></canvas>
            </div>
        </div>

        <!-- Financial Insights -->
        <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
            <h3 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
                <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                </svg>
                Insights Financieros
            </h3>
            <div class="space-y-4">
                <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-lg p-4">
                    <div class="flex items-start gap-3">
                        <div class="w-8 h-8 bg-emerald-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-emerald-300 font-medium mb-1">Excelente Control de Gastos</h4>
                            <p class="text-bunker-300 text-sm">Tus gastos están 15% por debajo del presupuesto planificado este mes.</p>
                        </div>
                    </div>
                </div>

                <div class="bg-amber-500/10 border border-amber-500/20 rounded-lg p-4">
                    <div class="flex items-start gap-3">
                        <div class="w-8 h-8 bg-amber-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.464 0L4.35 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-amber-300 font-medium mb-1">Gastos de Transporte Elevados</h4>
                            <p class="text-bunker-300 text-sm">Has superado tu presupuesto de transporte en un 23% este mes.</p>
                        </div>
                    </div>
                </div>

                <div class="bg-blue-500/10 border border-blue-500/20 rounded-lg p-4">
                    <div class="flex items-start gap-3">
                        <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-blue-300 font-medium mb-1">Meta de Ahorro en Progreso</h4>
                            <p class="text-bunker-300 text-sm">Has ahorrado $2,840 de tu meta mensual de $3,500 (81%).</p>
                        </div>
                    </div>
                </div>

                <div class="bg-purple-500/10 border border-purple-500/20 rounded-lg p-4">
                    <div class="flex items-start gap-3">
                        <div class="w-8 h-8 bg-purple-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-purple-300 font-medium mb-1">Proyección Positiva</h4>
                            <p class="text-bunker-300 text-sm">Basado en tus patrones, terminarás el mes con un surplus de $1,200.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    <script>
        // Global variables
        let cashFlowChart, categoryChart, budgetComparisonChart, trendsChart;
        let currentCashFlowPeriod = 'monthly';
        let selectedBudgets = ['1', '2']; // Default selected budgets

        // Sample data - Replace with actual data from your backend
        const sampleData = {
            transactions: [
                { id: 1, date: '2024-01-15', amount: 3500, type: 'income', category: 'Salario', budget_id: null },
                { id: 2, date: '2024-01-16', amount: -450, type: 'expense', category: 'Comida', budget_id: 1 },
                { id: 3, date: '2024-01-18', amount: -120, type: 'expense', category: 'Transporte', budget_id: 3 },
                { id: 4, date: '2024-02-15', amount: 3500, type: 'income', category: 'Salario', budget_id: null },
                { id: 5, date: '2024-02-20', amount: -800, type: 'expense', category: 'Hogar', budget_id: 1 },
                { id: 6, date: '2024-03-15', amount: 3500, type: 'income', category: 'Salario', budget_id: null },
                { id: 7, date: '2024-03-22', amount: -300, type: 'expense', category: 'Servicios', budget_id: 1 },
                { id: 8, date: '2024-04-15', amount: 3800, type: 'income', category: 'Salario', budget_id: null },
                { id: 9, date: '2024-04-20', amount: -650, type: 'expense', category: 'Hogar', budget_id: 1 },
                { id: 10, date: '2024-05-15', amount: 3800, type: 'income', category: 'Salario', budget_id: null },
                { id: 11, date: '2024-05-22', amount: -480, type: 'expense', category: 'Entretenimiento', budget_id: 2 },
                { id: 12, date: '2024-06-15', amount: 4000, type: 'income', category: 'Salario', budget_id: null },
                { id: 13, date: '2024-06-25', amount: -200, type: 'expense', category: 'Transporte', budget_id: 3 },
