        function resetFilters() {
            document.getElementById('startDate').value = '2024-01-01';
            document.getElementById('endDate').value = '2024-12-31';
            document.getElementById('budgetFilter').value = 'all';
            document.getElementById('transactionType').value = 'all';
            document.getElementById('categoryChartType').value = 'expenses';
            document.getElementById('budgetChartMetric').value = 'utilization';
            
            // Reset budget selection
            selectedBudgets = ['1', '2'];
            document.querySelectorAll('.budget-checkbox').forEach((checkbox, index) => {
                checkbox.checked = index < 2;
            });
            document.getElementById('budgetAll').checked = false;
            
            updateBudgetSelectionText();
            updateCharts();
        }

