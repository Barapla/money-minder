<div class="max-w-7xl mx-auto" data-controller="charts--main"
    data-charts--main-url-value="<%= main_data_reports_path %>" 
    data-charts--main-charts--flow-outlet="#charts--flow-controller"
    data-charts--main-charts--distribution-outlet="#charts--distribution-controller"
    data-charts--main-charts--comparison-outlet="#charts--comparison-controller"
    >
    <!-- Header -->
    <div class="bg-gradient-to-r from-bunker-900/80 to-purple-900/80 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-8 mb-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-4xl font-bold text-white mb-2">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-300">📊 Dashboard de Análisis</span>
                </h1>
                <p class="text-bunker-300">Análisis detallado de tus finanzas personales</p>
            </div>
            <div class="flex gap-3">
                <button onclick="exportData()" class="px-4 py-2 bg-bunker-800/60 hover:bg-bunker-700/60 text-white border border-bunker-700/50 hover:border-bunker-600/50 rounded-xl font-medium transition-all duration-200 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                    Exportar Datos
                </button>
                <button onclick="generateReport()" class="bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white px-6 py-2 rounded-xl font-medium transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                    Generar Reporte
                </button>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6 mb-8">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-white flex items-center gap-2">
                <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.207A1 1 0 013 6.5V4z"></path>
                </svg>
                Filtros de Análisis
            </h2>
            <button onclick="resetFilters()" class="text-bunker-400 hover:text-white text-sm">
                Limpiar filtros
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <%= fields_for "report_filter", ReportFilter.new do |form| %>
                <!-- Date Range -->
                <%= render Forms::InputComponent.new(
                    name: :start_date,
                    form:,
                    type: :date,
                    options: { 
                        placeholder: "Fecha de Inicio",
                        help_text: "Selecciona la fecha de inicio del análisis",
                        size: :small,
                        data: {
                            "charts--main-target": "startDate",
                            action: "change->charts--main#updateAllCharts"
                        }
                    }
                ) %>
                
                <%= render Forms::InputComponent.new(
                    name: :end_date,
                    form:,
                    type: :date,
                    options: { 
                        placeholder: "Fecha de Inicio",
                        help_text: "Selecciona la fecha de inicio del análisis",
                        size: :small,
                        data: {
                            "charts--main-target": "endDate",
                            action: "change->charts--main#updateAllCharts"
                        }
                    }
                ) %>

                <!-- Budget MultiSelection -->  
                <%= render Forms::MultiSelectComponent.new(
                    name: :budgets,
                    form:,
                    options_collection: Budget.all.collect { |b| [b.name, b.id] },
                    options: {
                        placeholder: "Selecciona presupuestos...",
                        size: :small,
                        help_text: "Puedes seleccionar múltiples presupuestos",
                        data: {
                            "charts--main-target": "budgets",
                            action: "change->charts--main#updateAllCharts"
                        }
                    }
                ) %>

                <!-- Quick Filters -->
                <div>
                    <label class="block text-sm font-medium text-bunker-200 mb-2">Período Rápido</label>
                    <div class="flex gap-1">
                        <button data-charts--main-target="periodButtons" data-action="click->charts--main#setFastPeriod" data-charts--main-period-param="1M" class="flex-1 px-2 py-1 text-xs bg-bunker-800/60 hover:bg-purple-500/20 text-bunker-300 hover:text-white border border-bunker-700/50 rounded-md transition-colors">
                            1M
                        </button>
                        <button data-charts--main-target="periodButtons" data-action="click->charts--main#setFastPeriod" data-charts--main-period-param="3M" class="flex-1 px-2 py-1 text-xs bg-bunker-800/60 hover:bg-purple-500/20 text-bunker-300 hover:text-white border border-bunker-700/50 rounded-md transition-colors">
                            3M
                        </button>
                        <button data-charts--main-target="periodButtons" data-action="click->charts--main#setFastPeriod" data-charts--main-period-param="6M" class="flex-1 px-2 py-1 text-xs bg-bunker-800/60 hover:bg-purple-500/20 text-bunker-300 hover:text-white border border-bunker-700/50 rounded-md transition-colors">
                            6M
                        </button>
                        <button data-charts--main-target="periodButtons" data-action="click->charts--main#setFastPeriod" data-charts--main-period-param="1Y" class="flex-1 px-2 py-1 text-xs bg-purple-500 text-white border border-purple-500 rounded-md">
                            1A
                        </button>
                    </div>
                </div>
            <% end %>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-emerald-500/20 rounded-xl flex items-center justify-center">
                    <%= render_svg("progress", "text-emerald-400") %>
                </div>
                <span class="text-xs text-bunker-400 font-medium">INGRESOS TOTALES</span>
            </div>
            <div class="text-3xl font-bold text-emerald-400 mb-1" data-charts--main-target="incomeData">
                <%= number_to_currency(@report_datasets[:incomeData], unit: "$", precision: 2) %>
            </div>
            <div class="text-sm text-bunker-300">+12.5% vs período anterior</div>
        </div>

        <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-red-500/20 rounded-xl flex items-center justify-center">
                    <%= render_svg("decrease", "text-red-400") %>
                </div>
                <span class="text-xs text-bunker-400 font-medium">GASTOS TOTALES</span>
            </div>
            <div class="text-3xl font-bold text-red-400 mb-1" data-charts--main-target="expenseData">
                <%= number_to_currency(@report_datasets[:expenseData], unit: "$", precision: 2) %>
            </div>
            <div class="text-sm text-bunker-300">+8.3% vs período anterior</div>
        </div>

        <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-purple-500/20 rounded-xl flex items-center justify-center">
                    <%= render_svg("money", "text-purple-400") %>
                </div>
                <span class="text-xs text-bunker-400 font-medium">BALANCE NETO</span>
            </div>
            <div class="text-3xl font-bold text-purple-400 mb-1" data-charts--main-target="balanceData">
                <%= number_to_currency(@report_datasets[:balanceData], unit: "$", precision: 2) %>
            </div>
            <div class="text-sm text-bunker-300">+28.9% vs período anterior</div>
        </div>

        <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center">
                    <%= render_svg("stats", "text-blue-400") %>
                </div>
                <span class="text-xs text-bunker-400 font-medium">TRANSACCIONES</span>
            </div>
            <div class="text-3xl font-bold text-blue-400 mb-1" data-charts--main-target="noTransactions">
                <%= @report_datasets[:noTransactions] %>
            </div>
            <div class="text-sm text-bunker-300">En el período seleccionado</div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="grid gap-8 mb-8">
        <%= render Charts::FlowComponent.new(title: "Flujo de efectivo", url: flow_chart_reports_path, datasets: @budget_datasets) %>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 mb-8">
        <%= render Charts::DistributionComponent.new(title: "Distribución de ingresos", url: distribution_chart_reports_path, datasets: @earned_transaction_types_datasets, options: { transaction_type: "income" }) %>

        <%= render Charts::DistributionComponent.new(title: "Distribución de gastos", url: distribution_chart_reports_path, datasets: @spent_transaction_types_datasets, options: { transaction_type: "expense" }) %>
    </div>

    <div class="grid gap-8 mb-8">
        <%= render Charts::ComparisonComponent.new(title: "Comparación de Presupuestos", url: comparison_chart_reports_path, datasets: @comparison_datasets) %>
    </div>

    <!-- Trends and Insights -->
    <div class="grid gap-8">
        <%# <!-- Monthly Trends -->
        <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
            <h3 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
                <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
                Tendencias Mensuales
            </h3>
            <div class="h-64">
                <canvas id="trendsChart"></canvas>
            </div>
        </div> %>

        <!-- Financial Insights -->
        <%= render partial: 'reports/index/ai_financial_insights', locals: { ai_financial_report: @ai_financial_report } %>
    </div>
</div>