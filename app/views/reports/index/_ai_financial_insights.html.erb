<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
  <h3 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
    <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
    </svg>
    Insights Financieros
    
    <%# Indicador de estado %>
    <% if @ai_financial_report&.processing_success? %>
      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
        ✓ IA
      </span>
    <% else %>
      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-500/20 text-red-300 border border-red-500/30">
        ⚠ Error
      </span>
    <% end %>
  </h3>

  <div class="space-y-4">
    <% if @ai_financial_report&.processing_success? && @ai_financial_report.insights.present? %>
      
      <%# Renderizar cada insight dinámicamente %>
      <% @ai_financial_report.insights.each do |insight| %>
        <%= render partial: 'reports/index/insight_card', locals: { insight: insight } %>
      <% end %>
      
    <% else %>
      <%# Fallback con ejemplos estáticos cuando no hay datos de IA %>
      <%= render partial: 'reports/index/fallback_insights' %>
    <% end %>
  </div>
</div>