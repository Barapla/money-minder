<% p = @index_presenter %>
<div class="max-w-6xl mx-auto">
  <div class="flex items-end justify-between flex-wrap gap-4 mb-5">
    <div>
      <h1 class="text-[26px] font-bold text-white leading-tight"><%= t('.title') %></h1>
      <p class="text-bunker-400 text-[13px] mt-1"><%= t('.subtitle') %></p>
    </div>
    <div class="flex flex-wrap gap-2.5">
      <%= link_to t('.new_receivable'), new_debt_path(direction: :receivable),
            class: "border border-bunker-700/70 text-bunker-200 px-4 py-2.5 rounded-[10px] text-[13px] font-medium hover:border-purple-500/50 hover:text-purple-300 transition-colors" %>
      <%= link_to t('.new_payable'), new_debt_path(direction: :payable),
            class: "bg-gradient-to-r from-purple-500 to-purple-600 text-white px-4 py-2.5 rounded-[10px] text-[13px] font-semibold hover:from-purple-400 hover:to-purple-500 transition-colors" %>
    </div>
  </div>

  <% if p.any? %>
    <div class="grid gap-4 mb-6 [grid-template-columns:repeat(auto-fit,minmax(190px,1fr))]">
      <% tiles = [
           [t('.owed_to_me'), p.format_currency(p.owed_to_me), 'text-emerald-400', t('.owed_to_me_note', count: p.receivables.count(&:active?))],
           [t('.owed_by_me'), p.format_currency(p.owed_by_me), 'text-red-400', t('.owed_by_me_note', count: p.payables.count(&:active?))],
           [t('.net'), p.format_currency(p.net_position), p.net_position.negative? ? 'text-red-400' : 'text-white', t('.net_note')],
           [t('.collected'), p.format_currency(p.collected_total), 'text-purple-400', t('.collected_note')]
         ] %>
      <% tiles.each do |label, value, color, note| %>
        <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-5">
          <div class="text-bunker-400 text-[10.5px] uppercase tracking-[0.07em] mb-2"><%= label %></div>
          <div class="font-mono text-[21px] font-bold mb-[3px] <%= color %>"><%= value %></div>
          <div class="text-bunker-400 text-[11px]"><%= note %></div>
        </div>
      <% end %>
    </div>

    <% if p.next_due %>
      <% debt, date = p.next_due %>
      <div class="bg-amber-400/[0.08] border border-amber-400/25 rounded-2xl px-6 py-4 mb-6 text-amber-300 text-[12.5px]">
        <%= t('.next_due_html', name: link_to(debt.name, debt_path(debt), class: 'text-white font-semibold underline'),
                                date: l(date, format: :only_month),
                                amount: p.format_currency(debt.installment_amount)) %>
      </div>
    <% end %>

    <% [[:receivable, p.receivables], [:payable, p.payables]].each do |direction, list| %>
      <% next if list.empty? %>
      <section class="mb-7">
        <div class="flex items-center gap-2.5 mb-3">
          <span class="text-bunker-300 text-[11.5px] uppercase tracking-[0.07em] font-semibold whitespace-nowrap">
            <%= t(".group_#{direction}") %>
          </span>
          <span class="font-mono text-bunker-400 text-xs whitespace-nowrap">
            <%= t('.group_summary', count: list.size, total: p.format_currency(p.group_total(list))) %>
          </span>
          <span class="flex-1 min-w-[20px] h-px bg-bunker-800"></span>
        </div>

        <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(300px,1fr))]">
          <% list.each do |debt| %>
            <%= render 'debt_card', debt: debt, presenter: p %>
          <% end %>
        </div>
      </section>
    <% end %>
  <% else %>
    <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl px-6 py-14 text-center">
      <h3 class="text-bunker-200 text-[15px] font-medium mb-1"><%= t('.empty.title') %></h3>
      <p class="text-bunker-400 text-[13px] mb-4"><%= t('.empty.subtitle') %></p>
      <%= link_to t('.empty.cta'), new_debt_path(direction: :receivable),
            class: "inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg text-white bg-purple-500 hover:bg-purple-600" %>
    </div>
  <% end %>
</div>
