<div class="min-h-screen p-4 sm:p-6 lg:p-8">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="bg-gradient-to-r from-bunker-900/80 to-purple-900/80 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-8 mb-8">
            <div class="flex items-center gap-4 mb-4">
                <%= render Buttons::LinkComponent.new(content: '
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                ', href: budgets_path, options: { class: "btn-icon" }) %>
                <div>
                    <h1 class="text-4xl font-bold text-white">
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-300">💰 Nuevo Presupuesto</span>
                    </h1>
                    <p class="text-bunker-300">Crea un nuevo presupuesto para controlar tus gastos</p>
                </div>
            </div>
        </div>

        <!-- Form Container -->
        <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl overflow-hidden">
            <!-- Form Header -->
            <div class="px-8 py-6 border-b border-bunker-800/50">
                <h2 class="text-xl font-semibold text-white flex items-center gap-2">
                    <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                    Información del Presupuesto
                </h2>
            </div>

            <!-- Form -->
            <%= form_with(model: @budget, html: { class: "px-8 py-6" }) do |form| %>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <!-- Left Column -->
                    <div class="space-y-6">
                        <!-- Budget Type -->
                        <%= render Forms::SelectComponent.new(
                            name: :budget_type_id,
                            form: form,
                            options_collection: budget_type_options,
                            options: { 
                                prompt: "Selecciona un tipo",
                                help_text: "Categoría principal del presupuesto",
                                required: true
                            }
                        ) %>

                        <%= render Forms::InputComponent.new(
                            name: :current_amount,
                            form: form,
                            type: :number,
                            options: { 
                                step: 0.01,
                                placeholder: "0.00",
                                prefix: "$",
                                help_text: "Cantidad ya gastada en este período"
                            }
                        ) %>

                        <%= render Forms::InputComponent.new(
                            name: :limit_amount,
                            form: form,
                            type: :number,
                            options: { 
                                step: 0.01,
                                placeholder: "0.00",
                                prefix: "$",
                                help_text: "Cantidad máxima que planeas gastar",
                                required: true
                            }
                        ) %>
                    </div>

                    <!-- Right Column -->
                    <div class="space-y-6">
                        <!-- Icon Selection -->
                        <div class="form-group">
                            <label class="block text-sm font-medium text-bunker-200 mb-2">
                                Icono
                            </label>
                            <div class="grid grid-cols-6 gap-3">
                                <% Catalog.by_group('budget_icons').each do |catalog| %>
                                    <button type="button" class="w-12 h-12 bg-bunker-800/60 hover:bg-purple-500/20 border border-bunker-700/50 hover:border-purple-500/50 rounded-xl flex items-center justify-center text-xl transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-purple-500">
                                        <%= catalog.value %>
                                    </button>
                                <% end %>
                            </div>
                            <p class="text-xs text-bunker-400 mt-2">Selecciona un icono para identificar tu presupuesto</p>
                        </div>

                        <!-- Color Selection -->
                        <div class="form-group">
                            <label class="block text-sm font-medium text-bunker-200 mb-2">
                                Color
                            </label>
                            <div class="grid grid-cols-8 gap-3">
                                <% Catalog.by_group('budget_colors').each do |catalog| %>
                                    <button type="button" class="w-10 h-10 bg-<%= catalog.value %> rounded-full border-2 border-transparent hover:border-white focus:outline-none focus:border-white transition-all duration-200"></button>
                                <% end %>
                            </div>
                            <p class="text-xs text-bunker-400 mt-2">Elige un color para personalizar tu presupuesto</p>
                        </div>

                        <!-- Preview Card -->
                        <div class="form-group">
                            <label class="block text-sm font-medium text-bunker-200 mb-2">
                                Vista Previa
                            </label>
                            <div class="bg-bunker-800/60 border border-bunker-700/50 rounded-xl p-4">
                                <div class="flex items-center gap-3 mb-3">
                                    <div class="w-10 h-10 bg-purple-500/20 rounded-lg flex items-center justify-center">
                                        <span class="text-lg">🏠</span>
                                    </div>
                                    <div>
                                        <div class="text-sm font-medium text-white">Gastos Fijos</div>
                                        <div class="text-xs text-bunker-400">Nuevo Presupuesto</div>
                                    </div>
                                </div>
                                <div class="space-y-2 text-xs">
                                    <div class="flex justify-between">
                                        <span class="text-bunker-300">Gastado</span>
                                        <span class="text-orange-400">$0.00</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-bunker-300">Límite</span>
                                        <span class="text-white">$0.00</span>
                                    </div>
                                    <div class="bg-bunker-700 rounded-full h-2">
                                        <div class="bg-purple-400 h-2 rounded-full" style="width: 0%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="flex items-center justify-between pt-8 mt-8 border-t border-bunker-800/50">
                    <a href="#" class="px-6 py-3 text-bunker-300 hover:text-white border border-bunker-700/50 hover:border-bunker-600/50 rounded-xl font-medium transition-all duration-200 flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        Cancelar
                    </a>
                    
                    <div class="flex gap-3">
                        <button type="button" class="px-6 py-3 text-white border border-purple-500/50 hover:bg-purple-500/10 rounded-xl font-medium transition-all duration-200 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                            Vista Previa
                        </button>
                        
                        <button type="submit" class="bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white px-8 py-3 rounded-xl font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-purple-500/30 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            Crear Presupuesto
                        </button>
                    </div>
                </div>
            <% end %>
        </div>
    </div>
</div>

<!-- JavaScript para interactividad -->
<script>
    // Selección de iconos
    document.querySelectorAll('[type="button"]').forEach(button => {
        if (button.textContent.match(/[\u{1F300}-\u{1F6FF}]/u)) {
            button.addEventListener('click', function() {
                // Remover selección anterior
                document.querySelectorAll('[type="button"]').forEach(btn => {
                    if (btn.textContent.match(/[\u{1F300}-\u{1F6FF}]/u)) {
                        btn.classList.remove('bg-purple-500/20', 'border-purple-500/50');
                        btn.classList.add('bg-bunker-800/60', 'border-bunker-700/50');
                    }
                });
                
                // Agregar selección actual
                this.classList.remove('bg-bunker-800/60', 'border-bunker-700/50');
                this.classList.add('bg-purple-500/20', 'border-purple-500/50');
                
                // Actualizar preview
                const previewIcon = document.querySelector('.bg-purple-500\\/20 span');
                if (previewIcon) {
                    previewIcon.textContent = this.textContent;
                }
            });
        }
    });

    // Actualización de preview en tiempo real
    const limitInput = document.querySelector('input[type="number"]:last-of-type');
    const currentInput = document.querySelector('input[type="number"]:first-of-type');
    
    function updatePreview() {
        const current = parseFloat(currentInput.value) || 0;
        const limit = parseFloat(limitInput.value) || 0;
        const percentage = limit > 0 ? (current / limit) * 100 : 0;
        
        // Actualizar valores en preview
        const previewCurrent = document.querySelector('.text-orange-400');
        const previewLimit = document.querySelector('.text-white');
        const progressBar = document.querySelector('.bg-purple-400');
        
        if (previewCurrent) previewCurrent.textContent = `$${current.toFixed(2)}`;
        if (previewLimit) previewLimit.textContent = `$${limit.toFixed(2)}`;
        if (progressBar) progressBar.style.width = `${Math.min(percentage, 100)}%`;
    }

    limitInput?.addEventListener('input', updatePreview);
    currentInput?.addEventListener('input', updatePreview);
</script>