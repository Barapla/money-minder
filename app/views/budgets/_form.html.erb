<!-- Form -->
<%= form_with(model: budget, local: true, html: { class: "px-8 py-6", 
    data: { controller: "budgets--preview form-validator", 
        form_validator_validate_on_blur_value: true,
        form_validator_validate_on_input_value: false} }) do |form| %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Left Column -->
        <div>
            <%= render Forms::InputComponent.new(
                name: :name,
                form:,
                type: :text,
                options: { 
                    placeholder: "Nuevo Presupuesto",
                    help_text: "Nombre descriptivo del presupuesto",
                    required: true,
                    data: {
                        "budgets--preview-target": "name",
                        action: "input->budgets--preview#updatePreview",
                        required_message: "Por favor, ingresa un nombre para el presupuesto",
                    }
                }
            ) %>
            <%= turbo_frame_tag "budget_type_frame" do  %>
                <% if budget.new_record? || budget.budget_type != nil %>
                    <%= render partial: "budgets/forms/#{budget.budget_type&.code || 'cash'}/form", locals: { budget: } %>
                <% end %>
            <% end %>
        </div>

        <!-- Right Column -->
        <div class="space-y-6">
            
            <!-- Budget Type -->
            <%= render Forms::SelectComponent.new(
                name: :budget_type_id,
                form:,
                options_collection: Catalog.get_by_group_pluck('budget_types'),
                options: { 
                    help_text: "Categoría principal del presupuesto",
                    required: true,
                    disabled: budget.persisted?,
                    data: {
                        controller: "select-to",
                        select_to_url_value: change_budget_type_budgets_path,
                        select_to_method_value: "POST",
                        select_to_field_value: "budget_type_id",
                        select_to_model_value: "budget",
                        select_to_target: "select",
                        "budgets--preview-target": "budgetType",
                        action: "change->budgets--preview#updatePreview"
                    }
                }
            ) %>

            <!-- Icon Selection -->
            <%= render Forms::SpecialRadioComponent.new(
                name: :icon_id,
                form:,
                collection: Catalog.by_group('budget_icons'),
                options: { 
                    default_object_label: 'value',
                    help_text: "Selecciona un icono para identificar tu presupuesto",
                    value: budget.icon&.id,
                    collection_options: {
                        data: {
                            "budgets--preview-target": "icons",
                            action: "click->budgets--preview#selectIcon"
                        }
                    }
                }
            ) %>

            <!-- Color Selection -->
            <%= render Forms::SpecialRadioComponent.new(
                name: :color_id,
                form:,
                collection: Catalog.by_group('colors'),
                options: { 
                    is_colors: true,
                    default_object_label: 'value',
                    help_text: "Elige un color para personalizar tu presupuesto",
                    value: budget.color&.id,
                    collection_options: {
                        data: {
                            "budgets--preview-target": "colors",
                            action: "click->budgets--preview#selectColor"
                        }
                    }
                }
            ) %>

            <%= turbo_frame_tag "preview_frame" do  %>
                <% if budget.new_record? || budget.budget_type != nil %>
                    <%= render "budgets/forms/#{budget.budget_type&.code || 'cash'}/preview", budget: %>
                <% end %>
            <% end %>
        </div>
    </div>


    <%= form.hidden_field :user_id, value: current_user.id %>
    <!-- Form Actions -->
    <div class="flex items-center justify-between pt-8 mt-8 border-t border-bunker-800/50">
        
        <% href_button = budget.persisted? ? budget : budgets_path %>
        <%= render Buttons::LinkComponent.new(content: '
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            Cancelar
            ', href: href_button, 
            options: { 
                class: "btn-cancel" 
            })
        %>
        <button type="submit" class="bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white px-8 py-3 rounded-xl font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-purple-500/30 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Guardar Presupuesto
        </button>
    </div>
<% end %>