<%
  p = @index_presenter
  zeros = accounts.select { |a| a[:zero] }
  zeros_total = p.format_currency(p.group_total(zeros))
%>
<section class="mb-6" data-budget-filters-target="group" data-controller="reveal">
  <div class="flex items-center gap-2.5 mb-3">
    <span class="text-bunker-300 text-[11.5px] uppercase tracking-[0.07em] font-semibold whitespace-nowrap"><%= title %></span>
    <span class="font-mono text-bunker-400 text-xs whitespace-nowrap">
      <%= t('budgets.index.groups.summary', count: accounts.size, total: p.format_currency(p.group_total(accounts)), share: p.group_share(accounts)) %>
    </span>
    <span class="flex-1 min-w-[20px] h-px bg-bunker-800"></span>
  </div>

  <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(280px,1fr))]">
    <% accounts.each do |account| %>
      <%
        status = p.status_for(account)
        tint = account_tint(status)
        move = status == :lower_yield ? p.move_suggestion(account) : nil
      %>
      <%= link_to budget_path(account[:budget]),
            class: "block rounded-2xl p-5 border transition-colors #{account[:zero] ? 'bg-bunker-900/30 border-bunker-800/50 hidden' : "bg-bunker-900/50 #{tint[:card]}"} hover:border-purple-500/40",
            data: { budget_filters_target: "account", name: account[:name].downcase,
                    zero: account[:zero].to_s, type: account[:code], balance: account[:balance],
                    reveal_target: account[:zero] ? "hidden" : "always" } do %>
        <div class="flex items-start justify-between gap-2.5 mb-4">
          <div class="flex items-center gap-[11px] min-w-0">
            <span class="w-[38px] h-[38px] shrink-0 rounded-[11px] border flex items-center justify-center text-[17px] <%= tint[:icon] %> <%= 'opacity-70' if account[:zero] %>">
              <%= account[:icon] %>
            </span>
            <span class="min-w-0">
              <span class="block text-[14px] font-semibold line-clamp-1 <%= account[:zero] ? 'text-bunker-200' : 'text-white' %>"><%= account[:name] %></span>
              <span class="block text-bunker-400 text-[11.5px]">
                <%= t("budgets.index.types.#{account[:code]}") %><%= " · #{account[:rate]}% anual" if account[:rate]&.positive? %>
              </span>
            </span>
          </div>
          <span class="shrink-0 whitespace-nowrap border text-[10.5px] font-semibold px-2.5 py-[3px] rounded-full <%= tint[:badge] %>">
            <%= t("budgets.index.status.#{status}") %>
          </span>
        </div>

        <div class="font-mono text-2xl font-bold mb-3.5 <%= account[:zero] ? 'text-bunker-500' : 'text-white' %>"><%= account[:balance_formatted] %></div>

        <% if account[:zero] %>
          <p class="text-bunker-400 text-xs"><%= t('budgets.index.groups.no_movements') %></p>
        <% else %>
          <dl class="flex flex-col gap-[9px] text-xs">
            <% if account[:month_in].positive? %>
              <div class="flex justify-between gap-2.5">
                <dt class="text-bunker-400"><%= t('budgets.index.groups.month_in') %></dt>
                <dd class="font-mono font-semibold text-emerald-400">+<%= p.format_currency(account[:month_in]) %></dd>
              </div>
            <% end %>
            <div class="flex justify-between gap-2.5">
              <dt class="text-bunker-400"><%= t('budgets.index.groups.share') %></dt>
              <dd class="font-mono font-semibold text-bunker-200"><%= account[:share] %>%</dd>
            </div>
          </dl>
          <div class="mt-3.5 h-[5px] rounded-full bg-bunker-950/70 overflow-hidden">
            <div class="h-full rounded-full <%= tint[:bar] %>" style="width: <%= account[:share] %>%"></div>
          </div>
          <% if move %>
            <p class="mt-3 text-amber-300 text-[11.5px]"><%= t('budgets.index.groups.move_suggestion', to: move[:to], amount: move[:gain_formatted]) %></p>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if zeros.any? %>
      <div data-budget-filters-target="zerosCard" class="bg-bunker-950/30 border border-dashed border-bunker-700/60 rounded-2xl p-5 flex flex-col">
        <div class="text-bunker-200 text-[13.5px] font-semibold mb-[3px]">
          <%= t('budgets.index.groups.others_title', count: zeros.size, noun: noun) %>
        </div>
        <div class="text-bunker-400 text-[11.5px] mb-3.5">
          <%= t('budgets.index.groups.others_note', total: zeros_total) %>
        </div>
        <div data-reveal-target="collapsed" class="flex-1 flex flex-col gap-[9px] text-[12.5px]">
          <% zeros.first(4).each do |zero| %>
            <div class="flex justify-between gap-2.5">
              <span class="text-bunker-500 line-clamp-1"><%= zero[:name] %></span>
              <span class="font-mono font-semibold text-bunker-500"><%= zero[:balance_formatted] %></span>
            </div>
          <% end %>
          <% if zeros.size > 4 %>
            <div class="flex justify-between gap-2.5">
              <span class="text-bunker-500"><%= t('budgets.index.groups.and_more', count: zeros.size - 4) %></span>
              <span class="font-mono font-semibold text-bunker-500"><%= p.format_currency(0) %></span>
            </div>
          <% end %>
        </div>
        <button type="button" data-action="reveal#toggle" data-reveal-target="button"
                data-show="<%= t('budgets.index.groups.show_zeros', count: zeros.size) %>"
                data-hide="<%= t('budgets.index.groups.hide_zeros') %>"
                class="mt-3.5 border border-bunker-700/60 text-purple-300 text-[12.5px] font-semibold text-center py-[9px] rounded-[10px] hover:bg-purple-500/10 hover:border-purple-500/40 transition-colors">
          <%= t('budgets.index.groups.show_zeros', count: zeros.size) %>
        </button>
      </div>
    <% end %>
  </div>
</section>
