<div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="bg-gradient-to-r from-bunker-900/80 to-purple-900/80 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-8 mb-8">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <%= render Buttons::LinkComponent.new(content: '
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                ', href: budgets_path, options: { class: "btn-icon" }) %>
                
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 bg-<%= @budget_presenter.color %> rounded-xl flex items-center justify-center">
                        <span class="text-3xl"><%= @budget_presenter.icon %></span>
                    </div>
                    <div>
                        <h1 class="text-4xl font-bold text-white"><%= @budget_presenter.name %></h1>
                        <p class="text-bunker-300"><%= @budget_presenter.budget_type %> • Creado hace 3 días</p>
                    </div>
                </div>
            </div>
            <div class="flex gap-3">
                <%= render Buttons::LinkComponent.new(content: '
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                    Editar
                    ', href: edit_budget_path(@budget), 
                    options: { 
                        class: "btn-cancel" 
                    })
                %>
                <%= link_to budget_path(@budget), 
                    class: "px-4 py-2 text-red-400 hover:text-red-300 border border-red-500/50 hover:border-red-400/50 rounded-xl font-medium transition-all duration-200 flex items-center gap-2",
                    data: { 
                        turbo_method: :delete,
                        turbo_confirm: "¿Estás seguro de que quieres eliminar este presupuesto?" 
                    } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                    Eliminar
                <% end %>
            </div>
        </div>
    </div>

    <!-- Stats Overview -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-orange-500/20 rounded-xl flex items-center justify-center">
                    <svg class="w-8 h-8 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                    </svg>
                </div>
                <span class="text-xs text-bunker-400 font-medium">GASTADO</span>
            </div>
            <div class="text-3xl font-bold text-orange-400 mb-1"><%= @budget_presenter.current_amount %></div>
            <div class="text-sm text-bunker-300">de <%= @budget_presenter.limit_amount %></div>
        </div>

        <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-emerald-500/20 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                    </svg>
                </div>
                <span class="text-xs text-bunker-400 font-medium">DISPONIBLE</span>
            </div>
            <div class="text-3xl font-bold text-emerald-400 mb-1"><%= @budget_presenter.available_amount %></div>
            <div class="text-sm text-bunker-300">restante</div>
        </div>

        <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-purple-500/20 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                    </svg>
                </div>
                <span class="text-xs text-bunker-400 font-medium">PROGRESO</span>
            </div>
            <div class="text-3xl font-bold text-purple-400 mb-1"><%= @budget_presenter.budget_percentage %></div>
            <div class="text-sm text-bunker-300">del límite</div>
        </div>

        <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <span class="text-xs text-bunker-400 font-medium">DÍAS RESTANTES</span>
            </div>
            <div class="text-3xl font-bold text-blue-400 mb-1"><%= (@budget.payday.to_date - Time.now.to_date).to_i %></div>
            <div class="text-sm text-bunker-300">este mes</div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="grid lg:grid-cols-3 gap-8">
        <!-- Progress and Details -->
        <div class="lg:col-span-2 space-y-8">
            <!-- Progress Chart -->
            <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-semibold text-white flex items-center gap-2">
                        <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                        Progreso del Presupuesto
                    </h2>
                    <!--
                    <div class="flex gap-2">
                        <button class="px-3 py-1 text-sm bg-purple-500 text-white rounded-lg">Este Mes</button>
                        <button class="px-3 py-1 text-sm text-bunker-400 hover:text-white border border-bunker-700 rounded-lg">3 Meses</button>
                        <button class="px-3 py-1 text-sm text-bunker-400 hover:text-white border border-bunker-700 rounded-lg">6 Meses</button>
                    </div>
                    -->
                </div>

                <!-- Progress Bar -->
                <div class="mb-6">
                    <div class="flex justify-between items-center mb-2">
                        <span class="text-sm text-bunker-300">Progreso actual</span>
                        <span class="text-lg font-semibold text-white"><%= @budget.budget_percentage %>%</span>
                    </div>
                    <div class="bg-bunker-800/60 rounded-full h-4 mb-4">
                        <div class="bg-gradient-to-r from-emerald-500 to-emerald-400 h-4 rounded-full transition-all duration-500" style="width: <%= @budget.budget_percentage %>%"></div>
                    </div>
                    <div class="flex justify-between text-sm text-bunker-400">
                        <span>$0</span>
                        <span><%= number_to_currency(@budget.limit_amount/2) %></span>
                        <span><%= @budget_presenter.limit_amount %></span>
                    </div>
                </div>

                <!-- Timeline -->
                <div class="bg-bunker-800/30 rounded-xl p-4">
                    <h3 class="text-lg font-medium text-white mb-4">Actividad Reciente</h3>
                    <div class="space-y-3">
                        <div class="flex items-center gap-3">
                            <div class="w-2 h-2 bg-emerald-400 rounded-full"></div>
                            <span class="text-sm text-bunker-300">Hace 2 horas</span>
                            <span class="text-sm text-white">Gasto de $250.00 - Supermercado</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="w-2 h-2 bg-orange-400 rounded-full"></div>
                            <span class="text-sm text-bunker-300">Ayer</span>
                            <span class="text-sm text-white">Gasto de $1,200.00 - Electricidad</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="w-2 h-2 bg-purple-400 rounded-full"></div>
                            <span class="text-sm text-bunker-300">Hace 3 días</span>
                            <span class="text-sm text-white">Presupuesto creado</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Transactions -->
            <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-semibold text-white flex items-center gap-2">
                        <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                        </svg>
                        Transacciones Recientes
                    </h2>
                    <a href="#" class="text-purple-400 hover:text-purple-300 text-sm font-medium">Ver todas</a>
                </div>

                <div class="space-y-4">
                    <div class="flex items-center justify-between p-4 bg-bunker-800/30 rounded-xl hover:bg-bunker-700/30 transition-colors duration-200">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-red-500/20 rounded-lg flex items-center justify-center">
                                <span class="text-lg">🛒</span>
                            </div>
                            <div>
                                <div class="text-white font-medium">Supermercado Walmart</div>
                                <div class="text-bunker-400 text-sm">Hace 2 horas</div>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-red-400 font-semibold">-$250.00</div>
                            <div class="text-bunker-400 text-sm">Comida</div>
                        </div>
                    </div>

                    <div class="flex items-center justify-between p-4 bg-bunker-800/30 rounded-xl hover:bg-bunker-700/30 transition-colors duration-200">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-yellow-500/20 rounded-lg flex items-center justify-center">
                                <span class="text-lg">⚡</span>
                            </div>
                            <div>
                                <div class="text-white font-medium">CFE Electricidad</div>
                                <div class="text-bunker-400 text-sm">Ayer</div>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-red-400 font-semibold">-$1,200.00</div>
                            <div class="text-bunker-400 text-sm">Servicios</div>
                        </div>
                    </div>

                    <div class="flex items-center justify-between p-4 bg-bunker-800/30 rounded-xl hover:bg-bunker-700/30 transition-colors duration-200">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-blue-500/20 rounded-lg flex items-center justify-center">
                                <span class="text-lg">💧</span>
                            </div>
                            <div>
                                <div class="text-white font-medium">SIAPA Agua</div>
                                <div class="text-bunker-400 text-sm">Hace 2 días</div>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-red-400 font-semibold">-$450.00</div>
                            <div class="text-bunker-400 text-sm">Servicios</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- Quick Actions -->
            <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
                <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                    Acciones Rápidas
                </h3>
                <div class="space-y-3">
                    <button class="w-full bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white px-4 py-3 rounded-xl font-medium transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Agregar Gasto
                    </button>
                    <button class="w-full bg-bunker-800/60 hover:bg-bunker-700/60 text-white px-4 py-3 rounded-xl font-medium transition-all duration-200 border border-bunker-700/50 hover:border-bunker-600/50 flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        Ver Calendario
                    </button>
                    <button class="w-full bg-bunker-800/60 hover:bg-bunker-700/60 text-white px-4 py-3 rounded-xl font-medium transition-all duration-200 border border-bunker-700/50 hover:border-bunker-600/50 flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                        Generar Reporte
                    </button>
                </div>
            </div>

            <!-- Budget Info -->
            <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
                <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Información del Presupuesto
                </h3>
                <div class="space-y-4">
                    <div class="flex justify-between items-center">
                        <span class="text-bunker-300">Tipo:</span>
                        <span class="text-white font-medium"><%= @budget_presenter.budget_type %></span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-bunker-300">Periodo:</span>
                        <span class="text-white font-medium">Mensual</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-bunker-300">Fecha de corte:</span>
                        <span class="text-white font-medium"><%= @budget_presenter.cutting_day %></span>
                    </div>
                    
                    <div class="flex justify-between items-center">
                        <span class="text-bunker-300">Fecha de pago:</span>
                        <span class="text-white font-medium"><%= @budget_presenter.payday %></span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-bunker-300">Estado:</span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= color_bg_class(@budget.budget_color, 40) %> <%= color_text_class(@budget.budget_color, 400) %>">
                            <%= @budget_presenter.status %>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Recommendations -->
            <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
                <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                    Recomendaciones
                </h3>
                <div class="space-y-3">
                    <div class="bg-amber-500/10 border border-amber-500/20 rounded-lg p-3">
                        <div class="flex items-start gap-2">
                            <svg class="w-4 h-4 text-amber-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                            </svg>
                            <div>
                                <div class="text-amber-300 text-sm font-medium">Atención</div>
                                <div class="text-amber-200 text-xs">Vas al 72% del presupuesto. Considera reducir gastos opcionales.</div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-blue-500/10 border border-blue-500/20 rounded-lg p-3">
                        <div class="flex items-start gap-2">
                            <svg class="w-4 h-4 text-blue-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <div>
                                <div class="text-blue-300 text-sm font-medium">Consejo</div>
                                <div class="text-blue-200 text-xs">Te quedan $3,250 para los próximos 18 días del mes.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
