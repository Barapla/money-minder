<%
    id = "budget-section-#{budget_type_code}"
    headers = headers_table_index + [{ name: t('budgets.index.table_actions'), size: 'min-w-[120px]' }]
    per_page = 10
    current_page = 1
    total_collections = budgets.size
    total_pages = total_pages(per_page, total_collections)
    pagination_pages = pagination_pages(current_page, total_pages)
    values = values_table_format(budgets.first(per_page))
%>
<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl overflow-hidden mb-6"
     data-controller="datatable-filters"
     data-datatable-filters-url-value="<%= budgets_table_budgets_path(type: budget_type_code) %>"
     data-datatable-filters-id-value="<%= id %>">
    <div class="px-6 py-4 border-b border-bunker-800/50 flex items-center justify-between">
        <h2 class="text-xl font-semibold text-white"><%= budget_section_title(budget_type_code, budgets) %></h2>
        <span class="text-sm text-bunker-400"><%= t('budgets.index.sections.count', count: total_collections) %></span>
    </div>
    <%= turbo_frame_tag "table-#{id}" do %>
        <%= render partial: 'components/table/main/table',
                   locals: { id:, headers:, values:, per_page:, current_page:, total_collections:, total_pages:, pagination_pages: } %>
    <% end %>
</div>
