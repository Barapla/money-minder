<div class="max-w-6xl mx-auto">
    <!-- Header (mantenemos el mismo) -->
    <%= render partial: "budgets/shows/shared/header" %>
    <!-- Main Content -->
    <div class="grid lg:grid-cols-3 gap-8">
        <!-- Progress and Details -->
        <div class="lg:col-span-2 space-y-8">
            <!-- Balance Chart -->
            <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-semibold text-white flex items-center gap-2">
                        <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                        Evolución del Saldo
                    </h2>
                    <div class="flex gap-2">
                        <button class="px-3 py-1 text-sm bg-purple-500 text-white rounded-lg">7 días</button>
                        <button class="px-3 py-1 text-sm text-bunker-400 hover:text-white border border-bunker-700 rounded-lg">30 días</button>
                        <button class="px-3 py-1 text-sm text-bunker-400 hover:text-white border border-bunker-700 rounded-lg">3 meses</button>
                    </div>
                </div>

                <!-- Resumen del período -->
                <div class="grid grid-cols-3 gap-4 mb-6">
                    <div class="bg-bunker-800/30 rounded-xl p-4 text-center">
                        <div class="text-emerald-400 text-lg font-semibold">+<%= @budget_presenter.earnings_last_days %></div>
                        <div class="text-bunker-300 text-sm">Ingresos</div>
                    </div>
                    <div class="bg-bunker-800/30 rounded-xl p-4 text-center">
                        <div class="text-red-400 text-lg font-semibold">-<%= @budget_presenter.spend_last_days %></div>
                        <div class="text-bunker-300 text-sm">Gastos</div>
                    </div>
                    <div class="bg-bunker-800/30 rounded-xl p-4 text-center">
                        <div class="text-orange-400 text-lg font-semibold"><%= @budget_presenter.difference_last_days %></div>
                        <div class="text-bunker-300 text-sm">Diferencia</div>
                    </div>
                </div>

                <!-- Actividad Reciente -->
                <div class="bg-bunker-800/30 rounded-xl p-4">
                    <h3 class="text-lg font-medium text-white mb-4">Actividad Reciente</h3>
                    <div class="space-y-3">
                        <% @budget.transactions_last_days.each do |transaction| %>
                            <% transaction_presenter = TransactionPresenter.new(transaction) %>
                            <div class="flex items-center gap-3">
                                <div class="w-2 h-2 rounded-full <%= transaction_color_class(transaction.transaction_type.code) %>"></div>
                                <span class="text-sm text-bunker-300"><%= time_ago_in_words(transaction_presenter.transaction_date) %></span>
                                <span class="text-sm text-white"><%= "#{transaction_presenter.description} - #{transaction_presenter .amount}" %></span>
                            </div>
                        <% end %>
                    </div>
                </div>
            </div>

            <!-- Recent Transactions -->
            <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-semibold text-white flex items-center gap-2">
                        <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                        </svg>
                        Transacciones Recientes
                    </h2>
                    <a href="#" class="text-purple-400 hover:text-purple-300 text-sm font-medium">Ver todas</a>
                </div>

                <div class="space-y-4">
                    <% @budget.transactions_last_days.each do |transaction| %>
                        <% transaction_presenter = TransactionPresenter.new(transaction) %>
                        <div class="flex items-center justify-between p-4 bg-bunker-800/30 rounded-xl hover:bg-bunker-700/30 transition-colors duration-200">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-<%= transaction_presenter.color %> rounded-lg flex items-center justify-center">
                                    <span class="text-lg"><%= transaction_presenter.icon %></span>
                                </div>
                                <div>
                                    <div class="text-white font-medium"><%= transaction_presenter.description %></div>
                                    <div class="text-bunker-400 text-sm"><%= time_ago_in_words(transaction_presenter.transaction_date) %></div>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="font-semibold <%= transaction_text_color_class(transaction.transaction_type.code) %>"><%= transaction_presenter.amount %></div>
                                <div class="text-bunker-400 text-sm"><%= transaction_presenter.transaction_type %></div>
                            </div>
                        </div>
                    <% end %>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- Quick Actions -->
            <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
                <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                    Acciones Rápidas
                </h3>
                <div class="space-y-3">
                    <button class="w-full bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white px-4 py-3 rounded-xl font-medium transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Agregar Transacción
                    </button>
                    <button class="w-full bg-bunker-800/60 hover:bg-bunker-700/60 text-white px-4 py-3 rounded-xl font-medium transition-all duration-200 border border-bunker-700/50 hover:border-bunker-600/50 flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                        </svg>
                        Transferir Dinero
                    </button>
                    <button class="w-full bg-bunker-800/60 hover:bg-bunker-700/60 text-white px-4 py-3 rounded-xl font-medium transition-all duration-200 border border-bunker-700/50 hover:border-bunker-600/50 flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                        Ver Estadísticas
                    </button>
                </div>
            </div>

            <!-- Card Info -->
            <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
                <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Información de la Tarjeta
                </h3>
                <div class="space-y-4">
                    <div class="flex justify-between items-center">
                        <span class="text-bunker-300">Banco:</span>
                        <span class="text-white font-medium">BBVA México</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-bunker-300">Tipo:</span>
                        <span class="text-white font-medium">Débito</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-bunker-300">Número:</span>
                        <span class="text-white font-medium">•••• 4329</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-bunker-300">Estado:</span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-400">
                            Activa
                        </span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-bunker-300">Última actualización:</span>
                        <span class="text-white font-medium">Hace 2 horas</span>
                    </div>
                </div>
            </div>

            <!-- Spending Analysis -->
            <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
                <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                </svg>
                Análisis de Gastos
            </h3>
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 bg-blue-400 rounded-full"></div>
                            <span class="text-bunker-300 text-sm">Compras</span>
                        </div>
                        <span class="text-white font-medium">$2,100</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 bg-orange-400 rounded-full"></div>
                            <span class="text-bunker-300 text-sm">Restaurantes</span>
                        </div>
                        <span class="text-white font-medium">$1,580</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 bg-red-400 rounded-full"></div>
                            <span class="text-bunker-300 text-sm">Retiros ATM</span>
                        </div>
                        <span class="text-white font-medium">$1,000</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 bg-purple-400 rounded-full"></div>
                            <span class="text-bunker-300 text-sm">Otros</span>
                        </div>
                        <span class="text-white font-medium">$0</span>
                    </div>
                </div>
            </div>

            <!-- Balance Recommendations -->
            <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
                <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 0v1m0 0v4.5M12 6V3m6 3L6 21"></path>
                    </svg>
                    Recomendaciones
                </h3>
                <div class="space-y-3">
                    <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-lg p-3">
                        <div class="flex items-start gap-2">
                            <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                            </svg>
                            <div>
                                <div class="text-emerald-300 text-sm font-medium">Saldo Saludable</div>
                                <div class="text-emerald-200 text-xs">Tu saldo actual de $15,250 es bueno para tus gastos mensuales promedio.</div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-blue-500/10 border border-blue-500/20 rounded-lg p-3">
                        <div class="flex items-start gap-2">
                            <svg class="w-4 h-4 text-blue-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <div>
                                <div class="text-blue-300 text-sm font-medium">Tip de Ahorro</div>
                                <div class="text-blue-200 text-xs">Considera transferir $5,000 a una cuenta de ahorros para generar intereses.</div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-yellow-500/10 border border-yellow-500/20 rounded-lg p-3">
                        <div class="flex items-start gap-2">
                            <svg class="w-4 h-4 text-yellow-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                            </svg>
                            <div>
                                <div class="text-yellow-300 text-sm font-medium">Gastos Elevados</div>
                                <div class="text-yellow-200 text-xs">Tus gastos en restaurantes han aumentado 20% este mes. Considera cocinar más en casa.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>