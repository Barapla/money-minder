<% p = @credit_card_presenter %>
<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
  <h3 class="text-[15px] font-semibold text-white mb-4"><%= t('.actions_title') %></h3>
  <div class="flex flex-col gap-2.5">
    <%= link_to t('.action_payment'), pay_card_path(p.budget),
          class: "bg-gradient-to-r from-purple-500 to-purple-600 text-white px-4 py-3 rounded-xl text-[13.5px] font-semibold hover:from-purple-400 hover:to-purple-500 transition-colors" %>
    <%= link_to t('.action_purchase'), new_transaction_path(budget_id: p.budget.id, transaction_type: 'expense'),
          class: "bg-bunker-800/60 border border-bunker-700/50 text-white px-4 py-3 rounded-xl text-[13.5px] font-medium hover:bg-bunker-700/60 transition-colors" %>
    <%= link_to t('.action_deposit'), new_transaction_path(budget_id: p.budget.id, transaction_type: 'income'),
          class: "bg-bunker-800/60 border border-bunker-700/50 text-white px-4 py-3 rounded-xl text-[13.5px] font-medium hover:bg-bunker-700/60 transition-colors" %>
    <%= link_to t('.action_reminder'), new_obligatory_payment_path,
          class: "bg-bunker-800/60 border border-bunker-700/50 text-white px-4 py-3 rounded-xl text-[13.5px] font-medium hover:bg-bunker-700/60 transition-colors" %>
  </div>
</div>

<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
  <h3 class="text-[15px] font-semibold text-white mb-4"><%= t('.limit_title') %></h3>
  <div class="flex justify-between items-baseline mb-2">
    <span class="text-bunker-300 text-[12.5px]"><%= t('.utilization') %></span>
    <span class="font-mono text-[13px] font-bold <%= p.utilization_status == :healthy ? 'text-emerald-400' : 'text-amber-400' %>"><%= p.utilization_percentage %>%</span>
  </div>
  <div class="relative h-2 bg-bunker-950/70 rounded-full mb-2"
       role="progressbar"
       aria-label="<%= t('.utilization') %>"
       aria-valuenow="<%= p.utilization_percentage %>" aria-valuemin="0" aria-valuemax="100">
    <div class="h-2 bg-gradient-to-r from-amber-500 to-amber-300 rounded-full" style="width: <%= [p.utilization_percentage, 100].min %>%"></div>
    <div class="absolute -top-1 w-0.5 h-4 bg-emerald-300" style="left: <%= CreditCardPresenter::HEALTHY_UTILIZATION %>%"></div>
  </div>
  <div class="flex justify-between text-[11.5px] text-bunker-400 mb-4 gap-2">
    <span class="font-mono"><%= p.current_balance_formatted %></span>
    <span class="text-emerald-300"><%= t('.ceiling', amount: p.healthy_ceiling_formatted) %></span>
    <span class="font-mono"><%= p.limit_amount_formatted %></span>
  </div>
  <% if (room = p.room_before_ceiling_formatted) %>
    <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-xl px-4 py-3">
      <div class="text-emerald-300 text-[12.5px] font-semibold"><%= t('.room_left', amount: room) %></div>
      <div class="text-emerald-200/70 text-[11.5px] mt-0.5"><%= t('.room_note') %></div>
    </div>
  <% else %>
    <div class="bg-amber-500/10 border border-amber-500/20 rounded-xl px-4 py-3">
      <div class="text-amber-300 text-[12.5px] font-semibold"><%= t('.over_ceiling') %></div>
      <div class="text-amber-200/70 text-[11.5px] mt-0.5"><%= t('.over_ceiling_note', amount: p.healthy_ceiling_formatted) %></div>
    </div>
  <% end %>
</div>

<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
  <h3 class="text-[15px] font-semibold text-white mb-4"><%= t('.info_title') %></h3>
  <dl class="flex flex-col gap-3 text-[12.5px]">
    <% if p.institution.present? %>
      <div class="flex justify-between gap-3 pb-2.5 border-b border-bunker-700">
        <dt class="text-bunker-300"><%= t('.issuer') %></dt>
        <dd class="text-white font-medium"><%= p.institution %></dd>
      </div>
    <% end %>
    <div class="flex justify-between gap-3 pb-2.5 border-b border-bunker-700">
      <dt class="text-bunker-300"><%= t('.limit') %></dt>
      <dd class="text-white font-medium font-mono"><%= p.limit_amount_formatted %></dd>
    </div>
    <div class="flex justify-between gap-3 pb-2.5 border-b border-bunker-700">
      <dt class="text-bunker-300"><%= t('.cutting_day') %></dt>
      <dd class="text-white font-medium"><%= t('.cutting_day_value', day: p.cutting_day) %></dd>
    </div>
    <div class="flex justify-between gap-3 pb-2.5 border-b border-bunker-700">
      <dt class="text-bunker-300"><%= t('.state') %></dt>
      <dd>
        <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full <%= p.active? ? 'bg-emerald-500/20 text-emerald-300' : 'bg-red-500/20 text-red-300' %>">
          <%= p.active? ? t('.active') : t('.inactive') %>
        </span>
      </dd>
    </div>
    <div class="flex justify-between gap-3">
      <dt class="text-bunker-300"><%= t('.last_update') %></dt>
      <dd class="text-white font-medium"><%= t('.time_ago', time: p.last_change) %></dd>
    </div>
  </dl>
  <div class="mt-3.5 pt-3.5 border-t border-bunker-700 flex gap-4 text-[12.5px] font-medium">
    <%= link_to t('.edit'), edit_budget_path(p.budget), class: "text-purple-300 hover:text-purple-200" %>
    <%= link_to t('.delete'), budget_path(p.budget), class: "text-red-400 hover:text-red-300",
          data: { turbo_method: :delete, turbo_confirm: t('.delete_confirm') } %>
  </div>
</div>
