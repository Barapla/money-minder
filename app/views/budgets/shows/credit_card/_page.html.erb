<div class="max-w-7xl mx-auto">
  <%= render 'budgets/shows/credit_card/hero' %>
  <%= render 'budgets/shows/credit_card/stats' %>

  <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] gap-5">
    <div class="flex flex-col gap-5">
      <%= render 'budgets/shows/credit_card/current_cycle' %>
      <%= render 'budgets/shows/credit_card/cycle_movements' %>
      <%= render 'budgets/shows/credit_card/cycle_history' %>
    </div>
    <div class="flex flex-col gap-5">
      <%= render 'budgets/shows/credit_card/sidebar' %>
    </div>
  </div>
</div>
