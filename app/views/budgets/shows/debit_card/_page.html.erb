  <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] gap-5">
    <div class="flex flex-col gap-5">
      <%= render 'budgets/shows/debit_card/daily_balance' %>
