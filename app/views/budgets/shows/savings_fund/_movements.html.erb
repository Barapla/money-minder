<% p = @savings_fund_presenter %>
<% movements = p.movements %>
<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
  <div class="flex justify-between items-center flex-wrap gap-2.5 mb-4">
    <h3 class="text-base font-semibold text-white"><%= t('.title') %></h3>
    <span class="text-bunker-400 text-xs"><%= t('.count', count: movements.size) %></span>
  </div>

  <% if movements.any? %>
    <div class="space-y-2.5">
      <% movements.first(10).each do |entry| %>
        <% transaction = entry[:transaction] %>
        <% presenter = TransactionPresenter.new(transaction) %>
        <div class="flex items-center gap-3.5 bg-bunker-950/40 border border-bunker-700/50 rounded-xl px-4 py-3.5">
          <div class="w-9 h-9 shrink-0 rounded-[10px] flex items-center justify-center text-base <%= entry[:incoming] ? 'bg-emerald-500/15' : 'bg-blue-500/15' %>">
            <%= presenter.icon %>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-white text-[13.5px] font-semibold line-clamp-1"><%= presenter.description.presence || presenter.category %></div>
            <div class="text-bunker-400 text-[11.5px]">
              <%= l(transaction.transaction_date.to_date, format: :short) %> · <%= presenter.transaction_type %>
            </div>
          </div>
          <div class="text-right shrink-0">
            <div class="font-mono text-[15px] font-bold <%= entry[:incoming] ? 'text-emerald-400' : 'text-blue-400' %>">
              <%= entry[:incoming] ? '+' : '−' %><%= entry[:amount_formatted] %>
            </div>
            <% if entry[:has_balance] %>
              <div class="text-bunker-400 text-[11px]"><%= t('.balance_after', amount: entry[:balance_formatted]) %></div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <% if movements.size > 10 %>
      <div class="mt-4 pt-4 border-t border-bunker-700/50">
        <%= link_to "#{t('.see_all')} →", transactions_path, class: "text-purple-300 text-[12.5px] font-medium hover:text-purple-200" %>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-6">
      <p class="text-bunker-400 text-sm mb-2"><%= t('.empty') %></p>
      <%= link_to t('.add_contribution'), fund_contribution_path(p.budget), class: "text-purple-300 text-xs hover:text-purple-200 underline" %>
    </div>
  <% end %>
</div>
