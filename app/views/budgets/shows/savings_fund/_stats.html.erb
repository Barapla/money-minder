<% p = @savings_fund_presenter %>
<% share = p.share_of_savings %>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-5">
  <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-5">
    <div class="text-bunker-400 text-[10.5px] uppercase tracking-widest mb-2.5"><%= t('.balance') %></div>
    <div class="font-mono text-2xl font-bold text-emerald-400 mb-1"><%= p.balance_formatted %></div>
    <div class="text-bunker-400 text-[11.5px]"><%= t('.share_note', percent: share[:percent]) %></div>
  </div>
  <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-5">
    <div class="text-bunker-400 text-[10.5px] uppercase tracking-widest mb-2.5"><%= t('.goal') %></div>
    <div class="font-mono text-2xl font-bold text-white mb-1"><%= p.goal? ? p.goal_formatted : '—' %></div>
    <div class="text-bunker-400 text-[11.5px]">
      <%= p.goal? ? t('.goal_note', percent: p.progress_percentage) : t('.goal_missing') %>
    </div>
  </div>
  <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-5">
    <div class="text-bunker-400 text-[10.5px] uppercase tracking-widest mb-2.5"><%= t('.rate') %></div>
    <div class="font-mono text-2xl font-bold text-purple-400 mb-1"><%= p.annual_rate_formatted %></div>
    <div class="text-bunker-400 text-[11.5px]">
      <% position = p.rate_position %>
      <%= position[:best] ? t('.rate_best', count: position[:count]) : t('.rate_note') %>
    </div>
  </div>
  <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-5">
    <div class="text-bunker-400 text-[10.5px] uppercase tracking-widest mb-2.5"><%= t('.projected_interest') %></div>
    <div class="font-mono text-2xl font-bold text-emerald-400 mb-1">≈<%= p.projected_interest_formatted %></div>
    <div class="text-bunker-400 text-[11.5px]"><%= t('.projected_note') %></div>
  </div>
</div>
