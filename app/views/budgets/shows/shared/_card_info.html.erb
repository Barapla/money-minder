<div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-6">
    <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Información de la Tarjeta
    </h3>
    <div class="space-y-4">
        <div class="flex justify-between items-center">
            <span class="text-bunker-300">Banco:</span>
            <span class="text-white font-medium">BBVA México</span>
        </div>
        <div class="flex justify-between items-center">
            <span class="text-bunker-300">Tipo:</span>
            <span class="text-white font-medium"><%= @budget_presenter.budget_type %></span>
        </div>
        <% if @budget.budget_type.code != "cash" %>
            <div class="flex justify-between items-center">
                <span class="text-bunker-300">Número:</span>
                <span class="text-white font-medium">•••• 4329</span>
            </div>
        <% end %>
        <div class="flex justify-between items-center">
            <span class="text-bunker-300">Estado:</span>
            <% if @budget.active %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-400">
                    Activa
                </span>
            <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-500/20 text-red-400">
                    Inactiva
                </span>
            <% end %>
        </div>
        <div class="flex justify-between items-center">
            <span class="text-bunker-300">Última actualización:</span>
            <span class="text-white font-medium"><%= @budget_presenter.last_change %></span>
        </div>
    </div>
</div>
