<div class="max-w-5xl mx-auto">
    <!-- Header -->
    <div class="bg-gradient-to-r from-bunker-900/80 to-purple-900/80 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-8 mb-8">
        <div class="flex items-center gap-4 mb-6">
            <%= render Buttons::LinkComponent.new(content: '
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            ', href: budgets_path, options: { class: "btn-icon" }) %>
            <div>
                <h1 class="text-4xl font-bold text-white">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-300">💰 <%= t('budgets.new.title') %></span>
                </h1>
                <p class="text-bunker-300"><%= t('budgets.new.subtitle') %></p>
            </div>
        </div>

        <%= render 'budgets/wizard/progress_indicator', current_step: current_step %>
    </div>

    <!-- Wizard Content -->
    <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl overflow-hidden">
        <%= turbo_frame_tag 'budget_wizard' do %>
            <%= yield %>
        <% end %>
    </div>
</div>
