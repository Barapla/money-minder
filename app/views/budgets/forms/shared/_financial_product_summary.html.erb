<% product = FinancialCatalogServices::Registry.find_by_id(financial_product_id) %>
<% if product %>
    <div class="flex justify-between text-xs mb-1">
        <span class="text-bunker-300">Institución</span>
        <span class="text-white"><%= product.institution %></span>
    </div>
    <div class="flex justify-between text-xs mb-3 pb-3 border-b border-bunker-700">
        <span class="text-bunker-300">Producto</span>
        <span class="text-white"><%= product.name %></span>
    </div>
<% end %>
