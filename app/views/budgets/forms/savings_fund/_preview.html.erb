<div class="form-group">
    <label class="block text-sm font-medium text-bunker-200 mb-2">
        Vista previa
    </label>
    <div class="bg-bunker-800/60 border border-bunker-700/50 rounded-xl p-4">
        <div class="flex items-center gap-3 mb-3">
            <div data-budgets--preview-target="preview" class="w-10 h-10 bg-<%= budget.color&.value || 'blue-500' %> rounded-lg flex items-center justify-center">
                <span class="text-lg"><%= budget.icon&.value || "💵" %></span>
            </div>
            <div>
                <div data-budgets--preview-target="previewBudgetType" class="text-sm font-medium text-white">
                    <%= budget.budget_type.value || "Fondo de Ahorro" %>
                </div>
                <div data-budgets--preview-target="previewName" class="text-xs text-bunker-400">
                    <%= budget.name || "Nuevo Fondo" %>
                </div>
            </div>
        </div>
        <%= render "budgets/forms/shared/financial_product_summary", financial_product_id: budget.savings_fund&.financial_product_id %>

        <div class="space-y-3 text-xs">
            <!-- Progreso hacia la meta -->
            <div class="flex justify-between items-center">
                <span class="text-bunker-300">Progreso</span>
                <span data-budgets--preview-target="previewProgress" class="text-white font-semibold"><%= budget.savings_fund&.progress_percentage&.round(1) || 0 %>%</span>
            </div>
            
            <!-- Barra de progreso -->
            <div class="bg-bunker-700 rounded-full h-2">
                <div class="bg-blue-400 h-2 rounded-full transition-all duration-300" 
                    data-budgets--preview-target="previewProgressBar" style="width: <%= budget.savings_fund&.progress_percentage || 0 %>%"></div>
            </div>
            
            <!-- Saldo actual vs Meta -->
            <div class="flex justify-between">
                <div>
                    <span class="text-bunker-300">Actual</span>
                    <div data-budgets--preview-target="previewCurrent" class="text-blue-400 font-semibold mt-1">$<%= budget.current_amount || "0.00" %></div>
                </div>
                <div class="text-right">
                    <span class="text-bunker-300">Meta</span>
                    <div data-budgets--preview-target="previewGoal" class="text-white font-semibold mt-1">$<%= budget.savings_fund&.goal_amount || "0.00" %></div>
                </div>
            </div>
            
            <!-- Información adicional -->
            <div class="flex justify-between items-center pt-2 border-t border-bunker-700">
                <span class="text-bunker-300">Interés anual</span>
                <span data-budgets--preview-target="previewInterestRate" class="text-emerald-400 font-semibold"><%= (budget.savings_fund&.interest_rate&.* 100)&.round(2) || 0 %>%</span>
            </div>
            
            <div class="flex justify-between items-center">
                <span class="text-bunker-300">Aporte mensual</span>
                <span data-budgets--preview-target="previewMonthlyContribution" class="text-purple-400 font-semibold">$<%= budget.savings_fund&.monthly_contribution || "0.00" %></span>
            </div>
        </div>
    </div>
</div>