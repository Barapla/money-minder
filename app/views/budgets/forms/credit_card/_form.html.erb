<% credit_card = budget.credit_card || budget.build_credit_card %>
<% selected_institution = selected_financial_institution(financial_product_id: credit_card.financial_product_id, persisted: credit_card.persisted?) %>
<%= fields_for "budget[credit_card_attributes]", credit_card do |cc_form| %>
    <div data-controller="product-selector"
        data-product-selector-product-type-value="<%= FinancialCatalogServices::Registry::CREDIT %>"
        data-product-selector-selected-product-value="<%= credit_card.financial_product_id %>">
        <%= render Forms::SelectComponent.new(
            name: :institution,
            form: cc_form,
            options_collection: financial_institutions_for_select(FinancialCatalogServices::Registry::CREDIT),
            options: {
                prompt: "Selecciona una institución",
                help_text: "Institución financiera del producto (opcional)",
                selected: selected_institution.to_s,
                data: {
                    product_selector_target: "institution",
                    action: "change->product-selector#updateProducts"
                }
            }
        ) %>

        <div data-product-selector-target="productContainer">
            <%= render Forms::SelectComponent.new(
                name: :financial_product_id,
                form: cc_form,
                options_collection: financial_products_for_select(FinancialCatalogServices::Registry::CREDIT, selected_institution),
                options: {
                    prompt: "Selecciona un producto",
                    help_text: "Producto del catálogo financiero (opcional)",
                    data: {
                        product_selector_target: "product"
                    }
                }
            ) %>
        </div>
    </div>

    <%= render Forms::InputComponent.new(
        name: :initial_debt,
        form: cc_form,
        type: :number,
        options: { 
            step: 0.01,
            placeholder: "0.00",
            prefix: "$",
            help_text: "Cantidad ya gastada en este período",
            required: true,
            data: {
                "budgets--preview-target": "debt",
                action: "input->budgets--preview#updateCreditPreview",
                required_message: "Por favor, ingresa la cantidad ya gastada"
            }
        }
    ) %>

    <%= render Forms::InputComponent.new(
        name: :limit_amount,
        form: cc_form,
        type: :number,
        options: { 
            step: 0.01,
            placeholder: "0.00",
            prefix: "$",
            help_text: "Cantidad máxima que planeas gastar",
            required: true,
            data: {
                "budgets--preview-target": "limit",
                action: "input->budgets--preview#updateCreditPreview",
                required_message: "Por favor, ingresa el límite del presupuesto"
            }
        }
    ) %>
    
    <%= render Forms::InputComponent.new(
        name: :cutting_day,
        form: cc_form,
        type: :number,
        options: { 
            placeholder: "15",
            min: 1,
            max: 31,
            help_text: "Día del mes de corte (1-31)",
            required: true,
            data: {
                required_message: "Por favor, ingresa el día de corte"
            }
        }
    ) %>

    <%= render Forms::InputComponent.new(
        name: :payment_due_days,
        form: cc_form,
        type: :number,
        options: { 
            placeholder: "5",
            help_text: "Días entre corte y vencimiento de pago",
            required: true,
            data: {
                required_message: "Por favor, ingresa los días para el pago",
            }
        }
    ) %>
<% end %>