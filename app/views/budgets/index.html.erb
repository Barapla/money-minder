<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="bg-gradient-to-r from-bunker-900/80 to-purple-900/80 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-8 mb-8">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-4xl font-bold text-white mb-2">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-300">💰 <%= t('.title') %></span>
                </h1>
                <p class="text-bunker-300"><%= t('.subtitle') %></p>
            </div>

            <%= render Buttons::LinkComponent.new(
                content: <<~HTML,
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    #{h t('.new_button')}
                HTML
                href: new_budget_path,
                options: {
                    class: "btn-new"
                })
            %>
        </div>
    </div>

    <% if @budgets_by_type.blank? %>
        <div class="bg-bunker-900/50 backdrop-blur-lg border border-bunker-800/50 rounded-2xl p-12 text-center">
            <svg class="mx-auto h-12 w-12 text-bunker-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            <h3 class="text-lg font-medium text-bunker-300 mb-2"><%= t('.empty.title') %></h3>
            <p class="text-bunker-400 mb-4"><%= t('.empty.subtitle') %></p>
            <%= link_to t('.empty.cta'), new_budget_path, class: 'inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-purple-500 hover:bg-purple-600' %>
        </div>
    <% else %>
        <div data-controller="budget-tabs">
            <div class="flex flex-wrap gap-2 mb-6" role="tablist">
                <% @budgets_by_type.each_with_index do |(budget_type_code, budgets), index| %>
                    <button type="button"
                            class="px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200 <%= index.zero? ? 'bg-purple-500 text-white' : 'bg-bunker-900/50 text-bunker-300 hover:bg-bunker-800/50' %>"
                            data-budget-tabs-target="tab"
                            data-type="<%= budget_type_code %>"
                            data-action="click->budget-tabs#select">
                        <%= budget_section_title(budget_type_code, budgets) %> (<%= budgets.size %>)
                    </button>
                <% end %>
            </div>

            <% @budgets_by_type.each_with_index do |(budget_type_code, budgets), index| %>
                <div data-budget-tabs-target="panel" data-type="<%= budget_type_code %>" class="<%= 'hidden' unless index.zero? %>">
                    <%= render 'budget_section', budget_type_code:, budgets: %>
                </div>
            <% end %>
        </div>
    <% end %>
</div>
