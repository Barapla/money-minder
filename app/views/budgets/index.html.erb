<% p = @index_presenter %>
<div class="max-w-7xl mx-auto">
  <div class="flex items-end justify-between flex-wrap gap-4 mb-5">
    <div>
      <h1 class="text-[26px] font-bold text-white leading-tight"><%= t('.title') %></h1>
      <p class="text-bunker-400 text-[13px] mt-1">
        <%= p.any? ? t('.headline', count: p.accounts_count, money: p.money_count, cards: p.cards_count) : t('.subtitle') %>
      </p>
    </div>
    <%= link_to t('.new_button'), new_budget_path,
          class: "bg-gradient-to-r from-purple-500 to-purple-600 text-white px-4 py-2.5 rounded-[10px] text-[13px] font-semibold hover:from-purple-400 hover:to-purple-500 transition-colors" %>
  </div>

  <% if p.any? %>
    <%= render 'index_kpis' %>

    <div data-controller="budget-filters">
      <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl px-[22px] py-4 mb-[22px]">
        <div class="flex flex-wrap items-center gap-3 mb-3">
          <div class="relative flex-1 min-w-[240px]">
            <div class="absolute left-3 top-1/2 -translate-y-1/2 text-bunker-400 pointer-events-none z-10">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"></path>
              </svg>
            </div>
            <input type="search"
                   data-budget-filters-target="search"
                   data-action="input->budget-filters#apply"
                   aria-label="<%= t('.search_placeholder') %>"
                   placeholder="<%= t('.search_placeholder') %>"
                   class="form-control form-control-sm has-icon-left">
          </div>

          <div class="flex items-center gap-2">
            <span class="text-sm text-bunker-300 whitespace-nowrap"><%= t('.sort_by') %></span>
            <div class="relative w-36">
              <select data-budget-filters-target="sort"
                      data-action="change->budget-filters#apply"
                      aria-label="<%= t('.sort_by') %>"
                      class="form-control form-control-sm">
                <option value="balance"><%= t('.sort_balance') %></option>
                <option value="name"><%= t('.sort_name') %></option>
              </select>
              <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none">
                <svg class="w-5 h-5 text-bunker-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>
          </div>

          <label class="cursor-pointer select-none">
            <input type="checkbox"
                   data-budget-filters-target="onlyFunded"
                   data-action="change->budget-filters#apply"
                   class="peer sr-only">
            <span class="flex items-center gap-2 bg-bunker-800/60 border border-bunker-700/50 rounded-xl px-3 py-2 text-sm text-bunker-200 whitespace-nowrap transition-all duration-200
                         peer-hover:border-purple-500 peer-focus-visible:ring-2 peer-focus-visible:ring-purple-500
                         peer-checked:bg-purple-500/20 peer-checked:border-purple-500 peer-checked:text-purple-200
                         peer-checked:[&_svg]:opacity-100">
              <svg class="w-4 h-4 opacity-30 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
              </svg>
              <%= t('.only_funded') %>
            </span>
          </label>
        </div>

        <div class="flex flex-wrap items-center gap-2" role="tablist">
          <button type="button" data-budget-filters-target="chip" data-type="all"
                  data-action="click->budget-filters#selectType"
                  class="px-3 py-1.5 rounded-full border text-xs font-semibold whitespace-nowrap transition-colors bg-purple-500/20 text-purple-300 border-purple-500/35">
            <%= t('.chip_all') %> · <%= p.accounts_count %>
          </button>
          <% p.type_counts.each do |code, count| %>
            <button type="button" data-budget-filters-target="chip" data-type="<%= code %>"
                    data-action="click->budget-filters#selectType"
                    class="px-3 py-1.5 rounded-full border text-xs font-medium whitespace-nowrap transition-colors bg-bunker-950/45 text-bunker-300 border-bunker-700/50">
              <%= t("budgets.index.types.#{code}") %> · <%= count %>
            </button>
          <% end %>
          <span class="text-bunker-400 text-xs ml-auto whitespace-nowrap"><%= t('.zeros_hint') %></span>
        </div>
      </div>

      <div class="flex items-baseline justify-between flex-wrap gap-3 mb-3.5">
        <div class="flex items-baseline gap-3">
          <h2 class="text-[17px] font-semibold text-white"><%= t('.money_title') %></h2>
          <span class="text-bunker-400 text-[12.5px]"><%= t('.money_summary', count: p.money_count, total: p.format_currency(p.money_total)) %></span>
        </div>
      </div>

      <% if p.daily_use_accounts.any? %>
        <%= render 'account_group', title: t('.daily_use'), accounts: p.daily_use_accounts, noun: t('.noun_debit') %>
      <% end %>
      <% if p.investment_accounts.any? %>
        <%= render 'account_group', title: t('.investment'), accounts: p.investment_accounts, noun: t('.noun_savings') %>
      <% end %>
      <% if p.term_accounts.any? %>
        <%= render 'account_group', title: t('.term'), accounts: p.term_accounts, noun: t('.noun_term') %>
      <% else %>
        <div class="flex items-center justify-between flex-wrap gap-3 bg-bunker-950/35 border border-dashed border-bunker-700/60 rounded-xl px-[18px] py-3.5 mb-7">
          <div>
            <div class="text-bunker-200 text-[13px] font-semibold"><%= t('.no_term_title') %></div>
            <div class="text-bunker-400 text-[11.5px]"><%= t('.no_term_note') %></div>
          </div>
          <%= link_to t('.add_term'), new_budget_path,
                class: "border border-bunker-700/60 text-bunker-200 text-[12.5px] font-medium px-3.5 py-[7px] rounded-[9px] whitespace-nowrap hover:border-purple-500/50 hover:text-purple-300 transition-colors" %>
        </div>
      <% end %>

      <% if p.cards.any? %>
        <%= render 'credit_cards_table' %>
      <% end %>

      <p data-budget-filters-target="empty" class="hidden text-bunker-400 text-sm text-center py-10">
        <%= t('.no_matches') %>
      </p>
    </div>
  <% else %>
    <div class="bg-bunker-900/50 border border-bunker-800/50 rounded-2xl p-12 text-center">
      <h3 class="text-lg font-medium text-bunker-300 mb-2"><%= t('.empty.title') %></h3>
      <p class="text-bunker-400 mb-4"><%= t('.empty.subtitle') %></p>
      <%= link_to t('.empty.cta'), new_budget_path, class: 'inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg text-white bg-purple-500 hover:bg-purple-600' %>
    </div>
  <% end %>
</div>
