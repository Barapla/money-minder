    <strong>User:</strong>
    <%= obligatory_payment.user_id %>
  </p>

  <p>
    <strong>Name:</strong>
    <%= obligatory_payment.name %>
  </p>

  <p>
    <strong>Amount:</strong>
    <%= obligatory_payment.amount %>
