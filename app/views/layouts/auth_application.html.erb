<!DOCTYPE html>
<html>
  <head>
    <title>MoneyMinder</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-gradient-to-br from-bunker-950 via-bunker-900 to-purple-900">
    <div class="min-h-screen grid lg:grid-cols-2 items-stretch">
      <%# El panel de marca se esconde en pantallas chicas: apilado empujaria el
          formulario debajo de un scroll de puro texto promocional. %>
      <div class="hidden lg:flex flex-col justify-between gap-12 px-12 py-14 border-r border-bunker-800/50 min-w-0">
        <div class="flex items-center gap-[11px]">
          <span class="w-[34px] h-[34px] rounded-[9px] bg-gradient-to-r from-purple-500 to-purple-400 flex items-center justify-center text-[17px]">💰</span>
          <span class="text-[19px] font-bold text-white"><%= t('app_name') %></span>
        </div>

        <div class="max-w-[440px]">
          <h2 class="text-[34px] leading-[1.2] font-bold text-white mb-4 text-pretty"><%= t('auth.pitch.headline') %></h2>
          <p class="text-bunker-300 text-[15px] leading-relaxed mb-8 text-pretty"><%= t('auth.pitch.subhead') %></p>

          <div class="flex flex-col gap-3.5">
            <%# Clases literales: Tailwind no genera lo que se arma con interpolacion. %>
            <% [['💵', 'bg-emerald-500/15', :free], ['💳', 'bg-amber-500/15', :cards], ['📈', 'bg-purple-500/15', :yields]].each do |emoji, tone, key| %>
              <div class="flex items-center gap-[13px] bg-bunker-900/45 border border-bunker-800/60 rounded-xl px-4 py-3.5">
                <span class="w-[34px] h-[34px] shrink-0 rounded-[9px] flex items-center justify-center text-[15px] <%= tone %>">
                  <%= emoji %>
                </span>
                <span class="min-w-0">
                  <span class="block text-white text-[13.5px] font-semibold"><%= t("auth.pitch.#{key}.title") %></span>
                  <span class="block text-bunker-400 text-[11.5px]"><%= t("auth.pitch.#{key}.note") %></span>
                </span>
              </div>
            <% end %>
          </div>
        </div>

        <p class="text-bunker-400 text-xs"><%= t('auth.pitch.privacy') %></p>
      </div>

      <div class="flex items-center justify-center px-6 py-14 sm:px-12 min-w-0">
        <div class="w-full max-w-[400px]">
          <div class="flex lg:hidden items-center gap-[11px] mb-8">
            <span class="w-[34px] h-[34px] rounded-[9px] bg-gradient-to-r from-purple-500 to-purple-400 flex items-center justify-center text-[17px]">💰</span>
            <span class="text-[19px] font-bold text-white"><%= t('app_name') %></span>
          </div>

          <%# Ningun layout renderizaba flash: un login fallido no decia nada. %>
          <% if flash[:alert].present? %>
            <div class="flex items-start gap-[11px] bg-red-500/10 border border-red-500/30 rounded-[11px] px-[15px] py-[13px] mb-[22px]" role="alert">
              <span class="text-sm leading-[1.3]">⚠️</span>
              <p class="min-w-0 text-red-300 text-[13px] font-semibold"><%= flash[:alert] %></p>
            </div>
          <% end %>

          <% if flash[:notice].present? %>
            <div class="flex items-start gap-[11px] bg-emerald-500/10 border border-emerald-500/30 rounded-[11px] px-[15px] py-[13px] mb-[22px]" role="status">
              <span class="text-sm leading-[1.3]">✓</span>
              <p class="min-w-0 text-emerald-300 text-[13px] font-semibold"><%= flash[:notice] %></p>
            </div>
          <% end %>

          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
